#!/bin/sh
# One program. The name selects the mode.
# channel prints help. channel-setup, channel-arm, and channel-send are links to this file.
# --setup, --arm, and --send select the mode when the name is channel.
set -eu
export LC_ALL=C
# GNU getopt keeps scanning after positionals only when this is unset.
unset POSIXLY_CORRECT || true

die() { printf '%s\n' "$1" >&2; exit 1; }
say() { printf '%s\n' "$1"; }
note() { printf '%s\n' "$1" >&2; }

help() {
  cat <<'EOF'
channel — one inbox directory per agent

With no mode, this prints help and exits.

  channel --setup FILE NODE [-n|--dry-run] [--whatineedtoknow]
  channel --arm   FILE NODE [--whatineedtoknow]
  channel --send  FILE NODE DEST VERB [BODYFILE|-|-m TEXT ...] [REF ...] [--whatineedtoknow]
  channel --ping  FILE NODE [--all [--every MIN]] [--timeout SEC]
  channel --status FILE

channel-setup, channel-arm, and channel-send are names for this same program.
The name selects the mode, so those forms do not need --setup, --arm, or --send.

-n, --dry-run       check the plan and create nothing (setup only)
--whatineedtoknow   print how to act (paths, watch/send commands, body rules), then
                    the nodes and messages this node uses, then exit
-h, --help          print this help

Options may sit before or after the file and the node. -- ends the options.

Webhooks (optional, per node, workflow-specific: they live only in that diag):
  node NAME /abs/inbox webhook=URL [webhook_key=TOKEN | webhook_key_file=PATH]
A relative webhook_key_file is resolved from the diag file's directory.
Give only the key: the tool sends Authorization: Bearer KEY. A leading
"Authorization: Bearer " or "Bearer " is stripped (key file: first line).
After channel-send queues a message to NAME, it POSTs JSON
  {"target","from","verb","inbox","file"}
to URL with Content-Type: application/json.
Optional webhook_retries=N (default 12) and webhook_backoff_max=T (default 30m;
T is N, Ns, Nm or Nh): every failure except 401, 403, 404, 405 and 410 (key or
URL wrong) is retried with exponential
backoff (1s, 2s, 4s, ... capped at T) in a detached background process, so the
send returns after the first try; the final outcome goes to syslog.
Success prints "WEBHOOK NAME CODE RESPONSE". Any failure prints a WARNING on
stderr; the message stays queued and the exit status is still 0.

PING and PONG (body NONCE: <value>) are built in on every arrow; channel-arm
answers PING itself. channel-ping always sends; with --all it starts a
check-all: every node reached also checks its own arrows (once per run id,
and at most once per --every minutes, default 30, env CHANNEL_CHECKALL_EVERY). Events go to syslog, tag agent-channel, as key=value
(CHANNEL_SYSLOG=0 disables; CHANNEL_LOG_FILE=PATH also appends to a file).
EOF
}

rc=0
getopt -T >/dev/null 2>&1 || rc=$?
[ "$rc" -eq 4 ] || die "need GNU getopt (util-linux)"
command -v awk >/dev/null 2>&1 || die "need awk"
command -v setsid >/dev/null 2>&1 || die "need setsid (util-linux)"

base=$(basename "$0")
case "$base" in
  channel-setup) name_mode=setup ;;
  channel-arm) name_mode=arm ;;
  channel-send) name_mode=send ;;
  channel-ping) name_mode=ping ;;
  channel-status) name_mode=status ;;
  *) name_mode= ;;
esac

parsed=$(getopt -n "$base" -o hnm: -l help,dry-run,whatineedtoknow,setup,arm,send,ping,status,all,run:,every:,timeout:,webhook-retry -- "$@") || exit 1
eval set -- "$parsed"

dry=0
what=0
wh_job=0
flag_mode=
MSGS=$(mktemp)
nmsg=0
ping_all=0
ping_run=
check_every=${CHANNEL_CHECKALL_EVERY:-30}
ping_timeout=${CHANNEL_PING_TIMEOUT:-300}
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) help; exit 0 ;;
    -n|--dry-run) dry=1; shift ;;
    --whatineedtoknow) what=1; shift ;;
    -m)
      [ "$nmsg" -eq 0 ] || printf '\n' >> "$MSGS"
      printf '%s\n' "$2" >> "$MSGS"
      nmsg=$((nmsg + 1))
      shift 2
      ;;
    --all) ping_all=1; shift ;;
    --run)
      case "$2" in ""|*[!A-Za-z0-9_.-]*) die "--run must be letters, digits, dot, underscore, or hyphen" ;; esac
      ping_run=$2; ping_all=1; shift 2 ;;
    --every) check_every=$2; shift 2 ;;
    --webhook-retry) wh_job=1; shift ;;
    --timeout) ping_timeout=$2; shift 2 ;;
    --setup|--arm|--send|--ping|--status)
      m=${1#--}
      if [ -n "$flag_mode" ] && [ "$flag_mode" != "$m" ]; then
        die "pick one of --setup, --arm, --send, --ping, or --status"
      fi
      flag_mode=$m
      shift
      ;;
    --) shift; break ;;
    *) die "option $1 not recognized" ;;
  esac
done

case "$check_every" in ""|*[!0-9]*) die "--every / CHANNEL_CHECKALL_EVERY must be a whole number >= 0, got \"$check_every\"" ;; esac
case "$ping_timeout" in ""|*[!0-9]*|0) die "--timeout / CHANNEL_PING_TIMEOUT must be a whole number > 0, got \"$ping_timeout\"" ;; esac

if [ -n "$name_mode" ] && [ -n "$flag_mode" ] && [ "$name_mode" != "$flag_mode" ]; then
  die "this command is $name_mode; $flag_mode is a different mode"
fi
mode=$name_mode
if [ -n "$flag_mode" ]; then
  mode=$flag_mode
fi
# Internal: the detached webhook retry job started by fire_webhook.
[ "$wh_job" -eq 0 ] || mode=webhook-retry
if [ -z "$mode" ]; then
  if [ "$dry" -eq 1 ] || [ "$what" -eq 1 ] || [ $# -gt 0 ]; then
    die "no mode; use --setup, --arm, --send, --ping, or --status"
  fi
  help
  exit 0
fi

if [ -n "$name_mode" ]; then
  invoked="channel-$mode"
else
  invoked="channel --$mode"
fi

PARSE=$(mktemp)
SHOWN=$(mktemp)
REPLYFAILED=$(mktemp)
BODYTMP=$(mktemp)
trap 'rm -f "$PARSE" "$SHOWN" "$REPLYFAILED" "$MSGS" "$BODYTMP"' EXIT INT TERM
[ "$nmsg" -eq 0 ] || [ "$mode" = send ] || die "-m is only for channel-send"
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# One key=value line to syslog (tag agent-channel) unless CHANNEL_SYSLOG=0,
# and to CHANNEL_LOG_FILE when set.
log_event() {
  line="event=$1"
  shift
  while [ $# -ge 2 ]; do
    v=$2
    case "$v" in
      ""|*[\ \"=]*|*"	"*) v=\"$(printf '%s' "$v" | sed 's/\\/\\\\/g; s/"/\\"/g')\" ;;
    esac
    line="$line $1=$v"
    shift 2
  done
  if [ "${CHANNEL_SYSLOG:-1}" != 0 ]; then
    case "$line" in
      *result=fail*|*result=timeout*) lprio=user.warning ;;
      *) lprio=user.info ;;
    esac
    logger -t agent-channel -p "$lprio" -- "$line" ||
      note "WARNING: syslog write failed (logger; CHANNEL_SYSLOG=0 turns syslog off): $line"
  fi
  if [ -n "${CHANNEL_LOG_FILE:-}" ]; then
    printf '%s agent-channel %s\n' "$(date +%Y-%m-%dT%H:%M:%S%:z)" "$line" >> "$CHANNEL_LOG_FILE" ||
      note "WARNING: CHANNEL_LOG_FILE write failed: $CHANNEL_LOG_FILE"
  fi
}

parse_plan() {
  awk -v plan="$1" '
function die(msg) { print msg > "/dev/stderr"; exit 1 }
function count_nl(s,    i, n) {
  n = 0
  for (i = 1; i <= length(s); i++) if (substr(s, i, 1) == "\n") n++
  return n
}
function matching_brace(text, open_at,    depth, i, c) {
  depth = 0
  for (i = open_at; i <= length(text); i++) {
    c = substr(text, i, 1)
    if (c == "{") depth++
    else if (c == "}") {
      depth--
      if (depth == 0) return i
    }
  }
  return 0
}
function strip_comments(text,    i, n, out, end) {
  n = length(text); i = 1; out = ""
  while (i <= n) {
    if (substr(text, i, 2) == "/*") {
      end = index(substr(text, i + 2), "*/")
      if (end == 0) break
      i += 2 + end + 1
      continue
    }
    if (substr(text, i, 2) == "//" || substr(text, i, 1) == "#") {
      end = index(substr(text, i), "\n")
      if (end == 0) break
      i += end
      out = out "\n"
      continue
    }
    out = out substr(text, i, 1)
    i++
  }
  return out
}
function trim_ws(s) {
  gsub(/^[ \t\n]+/, "", s)
  gsub(/[ \t\n]+$/, "", s)
  return s
}
function find_op(s, pos,    ops, k, op) {
  split("<-> >-< <- -> -- -< >-", ops, " ")
  for (k = 1; k <= 7; k++) {
    op = ops[k]
    if (substr(s, pos, length(op)) == op) return op
  }
  return ""
}
function label_from(attr,    p, rest, q, end, i, c, out) {
  p = index(attr, "label")
  if (p == 0) return ""
  rest = substr(attr, p + 5)
  sub(/^[ \t]*/, "", rest)
  if (substr(rest, 1, 1) != "=") return ""
  rest = substr(rest, 2)
  sub(/^[ \t]*/, "", rest)
  if (rest == "") return ""
  q = substr(rest, 1, 1)
  if (q == "\"" || q == "'\''") {
    end = index(substr(rest, 2), q)
    if (end == 0) return ""
    return substr(rest, 2, end - 1)
  }
  out = ""
  for (i = 1; i <= length(rest); i++) {
    c = substr(rest, i, 1)
    if (c ~ /[A-Za-z0-9_.-]/) out = out c
    else break
  }
  return out
}
function names_in(part, kept,    n, i, w) {
  for (i in kept) delete kept[i]
  n = 0
  while (match(part, /[A-Za-z_][A-Za-z0-9_.-]*/)) {
    w = substr(part, RSTART, RLENGTH)
    if (w != "blockdiag" && w != "group") { n++; kept[n] = w }
    part = substr(part, RSTART + RLENGTH)
  }
  return n
}
function parse_diag(text,    body, nstmt, i, stmt, label, open, rend, pos, op, opsn, ops, parts, pn, start, nn, kept, k, nodes, ni) {
  body = strip_comments(text)
  nstmt = split(body, stmts, ";")
  edge_n = 0
  for (i = 1; i <= nstmt; i++) {
    stmt = stmts[i]
    label = ""
    open = index(stmt, "[")
    if (open > 0) {
      rend = 0
      # last ]
      for (pos = length(stmt); pos > open; pos--) if (substr(stmt, pos, 1) == "]") { rend = pos; break }
      if (rend > open) {
        label = label_from(substr(stmt, open + 1, rend - open - 1))
        stmt = substr(stmt, 1, open - 1) substr(stmt, rend + 1)
      }
    }
    opsn = 0; pn = 0; start = 1; pos = 1
    while (pos <= length(stmt)) {
      op = find_op(stmt, pos)
      if (op == "") { pos++; continue }
      pn++; parts[pn] = substr(stmt, start, pos - start)
      opsn++; ops[opsn] = op
      pos += length(op)
      start = pos
    }
    pn++; parts[pn] = substr(stmt, start)
    if (opsn == 0) {
      if (stmt ~ /[<>]/) die("unrecognized arrow in: " trim_ws(stmt) ". Use ->, <->, or -<.")
      continue
    }
    rest = stmt
    for (k = 1; k <= opsn; k++) {
      op = ops[k]
      p = index(rest, op)
      if (p > 0) rest = substr(rest, 1, p - 1) " " substr(rest, p + length(op))
    }
    if (rest ~ /[<>]/) die("unrecognized arrow in: " trim_ws(stmt) ". Use ->, <->, or -<.")
    ni = 0
    for (k = 1; k <= pn; k++) {
      nn = names_in(parts[k], kept)
      if (nn == 0) continue
      ni++
      if (k == 1) nodes[ni] = kept[nn]
      else nodes[ni] = kept[1]
    }
    if (ni != opsn + 1) die("could not read an edge statement: " trim_ws(stmt))
    for (k = 1; k <= opsn; k++) {
      edge_n++
      e_src[edge_n] = nodes[k]
      e_op[edge_n] = ops[k]
      e_dst[edge_n] = nodes[k + 1]
      e_label[edge_n] = label
    }
  }
}
function expand() {
  out_n = 0
  for (i = 1; i <= edge_n; i++) {
    op = e_op[i]
    if (op == "<->") {
      out_n++; o_src[out_n] = e_src[i]; o_dst[out_n] = e_dst[i]; o_mode[out_n] = "wait"; o_label[out_n] = e_label[i]
      out_n++; o_src[out_n] = e_dst[i]; o_dst[out_n] = e_src[i]; o_mode[out_n] = "wait"; o_label[out_n] = e_label[i]
    } else if (op == "->") {
      out_n++; o_src[out_n] = e_src[i]; o_dst[out_n] = e_dst[i]; o_mode[out_n] = "wait"; o_label[out_n] = e_label[i]
    } else if (op == "-<") {
      out_n++; o_src[out_n] = e_src[i]; o_dst[out_n] = e_dst[i]; o_mode[out_n] = "queue"; o_label[out_n] = e_label[i]
    } else if (op == "<-" || op == "--" || op == ">-" || op == ">-<") {
      die(op " is drawn by blockdiag and is not a channel. Use ->, <->, or -<. See docs/diagram-marks.md.")
    } else die("unknown operator " op)
  }
}
function after_diagram(text,    i, n, depth, started, end, q) {
  i = 1; n = length(text); depth = 0; started = 0
  while (i <= n) {
    if (substr(text, i, 2) == "/*") {
      end = index(substr(text, i + 2), "*/")
      if (end == 0) die("unclosed block comment in plan file")
      i += 2 + end + 1
      continue
    }
    if (substr(text, i, 1) == "#" || substr(text, i, 2) == "//") {
      end = index(substr(text, i), "\n")
      if (end == 0) i = n + 1
      else i += end
      continue
    }
    q = substr(text, i, 1)
    if (q == "\"" || q == "'\''") {
      i++
      while (i <= n && substr(text, i, 1) != q) {
        if (substr(text, i, 1) == "\\") { i += 2; continue }
        i++
      }
      i++
      continue
    }
    if (q == "{") { depth++; started = 1 }
    else if (q == "}") {
      depth--
      if (started && depth == 0) return substr(text, i + 1)
    }
    i++
  }
  die("plan file has no closed blockdiag diagram")
}
function valid_node(name) {
  return name ~ /^[A-Za-z][A-Za-z0-9_.-]*$/ && index(name, "__") == 0 && name != "blockdiag" && name != "group"
}
function is_msg_at(text, p,    j, c) {
  j = p - 1
  while (j >= 1) {
    c = substr(text, j, 1)
    if (c == "\n") return 1
    if (c != " " && c != "\t") return 0
    j--
  }
  return 1
}
function read_name(text, p,    i, c, name) {
  i = p
  while (i <= length(text) && (substr(text, i, 1) == " " || substr(text, i, 1) == "\t")) i++
  name = ""
  while (i <= length(text)) {
    c = substr(text, i, 1)
    if (c ~ /[A-Za-z0-9_.-]/) { name = name c; i++ }
    else break
  }
  while (i <= length(text) && (substr(text, i, 1) == " " || substr(text, i, 1) == "\t")) i++
  if (substr(text, i, 1) != "{") return ""
  found_open = i
  return name
}
function blank_span(text, start, end,    i, c, out) {
  out = substr(text, 1, start - 1)
  for (i = start; i <= end; i++) {
    c = substr(text, i, 1)
    out = out (c == "\n" ? "\n" : " ")
  }
  return out substr(text, end + 1)
}
function split_message(name, interior,    p, open_at, close_at, body, desc, line, n, j) {
  if (!match(interior, /body[ \t]*:[ \t]*\{/)) die("message " name " has no body")
  open_at = RSTART + RLENGTH - 1
  close_at = matching_brace(interior, open_at)
  if (close_at == 0) die("message " name " body is missing its closing brace")
  body = substr(interior, open_at + 1, close_at - open_at - 1)
  desc = substr(interior, 1, RSTART - 1) substr(interior, close_at + 1)
  gsub(/^[ \t\n]+|[ \t\n]+$/, "", desc)
  msg_n++
  msg_name[msg_n] = name
  msg_desc[msg_n] = desc
  msg_body[msg_n] = ""
  n = split(body, lines, "\n")
  for (j = 1; j <= n; j++) {
    line = lines[j]
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line != "") msg_body[msg_n] = msg_body[msg_n] line "\n"
  }
  if (msg_body[msg_n] == "") die("message " name " has an empty body")
}
function extract_messages(text,    i, p, name, open_at, close_at) {
  msg_n = 0
  i = 1
  while (1) {
    p = index(substr(text, i), "message")
    if (p == 0) break
    p = i + p - 1
    if (is_msg_at(text, p)) {
      name = read_name(text, p + 7)
      if (name != "" && name ~ /^[A-Za-z]/) {
        open_at = found_open
        close_at = matching_brace(text, open_at)
        if (close_at == 0) die("message " name " is missing its closing brace")
        for (j = 1; j <= msg_n; j++) if (msg_name[j] == name) die("message " name " is defined twice")
        split_message(name, substr(text, open_at + 1, close_at - open_at - 1))
        text = blank_span(text, p, close_at)
        i = close_at + 1
        continue
      }
    }
    i = p + 7
  }
  return text
}
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function parse_key(text, base,    nlines, i, line, nf, f, name, inbox, src, dst, words, k, kv, eq, key, val, wurl, wfile, wkey) {
  text = extract_messages(text)
  nlines = split(text, rows, "\n")
  node_n = 0
  verb_n = 0
  for (i = 1; i <= nlines; i++) {
    line = trim(rows[i])
    if (line == "" || line == "/*" || line == "*/" || substr(line, 1, 1) == "#" || substr(line, 1, 2) == "//") continue
    nf = split(line, f, /[ \t]+/)
    if (f[1] == "node" && nf >= 3) {
      name = f[2]; inbox = f[3]
      wurl = ""; wfile = ""; wkey = ""; wret = 12; wmax = 1800
      for (k = 4; k <= nf; k++) {
        kv = f[k]; eq = index(kv, "=")
        if (eq < 2) die("line " base + i ": node option must be key=value (" kv ")")
        key = substr(kv, 1, eq - 1); val = substr(kv, eq + 1)
        if (val == "") die("line " base + i ": " key " is empty")
        if (key == "webhook") {
          if (val !~ /^https?:\/\//) die("line " base + i ": webhook must start with http:// or https://")
          wurl = val
        } else if (key == "webhook_key_file") {
          wfile = val
        } else if (key == "webhook_key") wkey = val
        else if (key == "webhook_retries" || key == "webhook_backoff_max") {
          if (key == "webhook_retries") {
            if (val !~ /^[0-9]+$/) die("line " base + i ": " key " must be a whole number >= 0")
            wret = val + 0
          } else {
            if (val !~ /^[0-9]+[smh]?$/) die("line " base + i ": webhook_backoff_max must be a number with an optional unit s, m, or h (e.g. 30m)")
            mult = 1
            if (val ~ /m$/) mult = 60
            if (val ~ /h$/) mult = 3600
            wmax = (val + 0) * mult
          }
        }
        else die("line " base + i ": unknown node option " key " (allowed: webhook, webhook_key_file, webhook_key, webhook_retries, webhook_backoff_max)")
      }
      if (wfile != "" && wkey != "") die("line " base + i ": use webhook_key_file or webhook_key, not both")
      if (wurl == "" && (wfile != "" || wkey != "")) die("line " base + i ": webhook key given without webhook=URL")
      if (!valid_node(name)) die("line " base + i ": node name must be letters, digits, dot, underscore, or hyphen, and not contain __")
      for (k = 1; k <= node_n; k++) if (n_name[k] == name) die("line " base + i ": node " name " is listed twice")
      if (substr(inbox, 1, 1) != "/") die("line " base + i ": inbox path must be absolute")
      node_n++; n_name[node_n] = name; n_path[node_n] = inbox
      n_wurl[node_n] = wurl; n_wfile[node_n] = wfile; n_wkey[node_n] = wkey; n_wret[node_n] = wret; n_wmax[node_n] = wmax
    } else if (f[1] == "verb" && nf >= 4) {
      src = f[2]; dst = f[3]; words = ""
      for (k = 4; k <= nf; k++) words = words (k == 4 ? "" : " ") f[k]
      for (k = 1; k <= verb_n; k++) if (v_src[k] == src && v_dst[k] == dst) die("line " base + i ": verb " src " " dst " is listed twice")
      verb_n++; v_src[verb_n] = src; v_dst[verb_n] = dst; v_words[verb_n] = words
    } else die("line " base + i ": expected '\''node NAME PATH [webhook=URL [webhook_key_file=PATH|webhook_key=TOKEN]]'\'', '\''verb SRC DST WORD...'\'', or '\''message NAME { ... }'\''")
  }
}
function has_node(name,    k) { for (k = 1; k <= node_n; k++) if (n_name[k] == name) return 1; return 0 }
function has_msg(name,    k) { for (k = 1; k <= msg_n; k++) if (msg_name[k] == name) return 1; return 0 }
function has_verb(src, dst,    k) { for (k = 1; k <= verb_n; k++) if (v_src[k] == src && v_dst[k] == dst) return 1; return 0 }
function seen_edge(src, dst,    k) { for (k = 1; k <= seen_n; k++) if (s_src[k] == src && s_dst[k] == dst) return 1; return 0 }
function in_edge(name,    k) {
  for (k = 1; k <= seen_n; k++) if (s_src[k] == name || s_dst[k] == name) return 1
  return 0
}
BEGIN {
  text = ""
  have = 0
  status = getline line < plan
  if (status < 0) die("no plan file " plan)
  while (status > 0) {
    if (have) text = text "\n"
    text = text line
    have = 1
    status = getline line < plan
  }
  close(plan)
  parse_diag(text)
  expand()
  tail = after_diagram(text)
  base = count_nl(substr(text, 1, length(text) - length(tail)))
  parse_key(tail, base)
  prob = ""
  seen_n = 0
  for (i = 1; i <= out_n; i++) {
    if (!has_node(o_src[i]) || !has_node(o_dst[i])) prob = prob o_src[i] " -> " o_dst[i] " uses a node the plan file does not define\n"
    if (!has_verb(o_src[i], o_dst[i])) prob = prob o_src[i] " -> " o_dst[i] " has no verb line\n"
    if (seen_edge(o_src[i], o_dst[i])) prob = prob "duplicate edge " o_src[i] " -> " o_dst[i] "\n"
    seen_n++; s_src[seen_n] = o_src[i]; s_dst[seen_n] = o_dst[i]
  }
  for (i = 1; i <= node_n; i++) if (!in_edge(n_name[i])) prob = prob "node " n_name[i] " is in the key and not in the diagram\n"
  for (i = 1; i <= verb_n; i++) {
    if (!seen_edge(v_src[i], v_dst[i])) prob = prob "verb " v_src[i] " " v_dst[i] " is not an arrow in the diagram\n"
    nw = split(v_words[i], ww, " ")
    for (k = 1; k <= nw; k++) if (!has_msg(ww[k])) prob = prob ww[k] " on " v_src[i] " -> " v_dst[i] " has no message definition\n"
  }
  if (prob != "") { printf "%s", prob > "/dev/stderr"; exit 1 }
  for (i = 1; i <= out_n; i++) print "E\t" o_src[i] "\t" o_dst[i] "\t" o_mode[i] "\t" o_label[i]
  for (i = 1; i <= node_n; i++) print "N\t" n_name[i] "\t" n_path[i]
  for (i = 1; i <= node_n; i++) if (n_wurl[i] != "") print "W\t" n_name[i] "\t" n_wurl[i] "\t" n_wfile[i] "\t" n_wkey[i] "\t" n_wret[i] "\t" n_wmax[i]
  for (i = 1; i <= verb_n; i++) print "V\t" v_src[i] "\t" v_dst[i] "\t" v_words[i]
  for (i = 1; i <= msg_n; i++) {
    print "M\t" msg_name[i]
    if (msg_desc[i] != "") {
      nd = split(msg_desc[i], dl, "\n")
      for (k = 1; k <= nd; k++) print "D\t" dl[k]
    }
    nb = split(msg_body[i], bl, "\n")
    for (k = 1; k <= nb; k++) if (bl[k] != "") print "B\t" bl[k]
  }
}
' "$1" > "$PARSE"
}

require_me() {
  me=$1
  case "$me" in
    */*|*__*|"") die "node must be a bare name, not a path ($me)" ;;
  esac
  case "$me" in
    [A-Za-z]*) ;;
    *) die "node must be a bare name, not a path ($me)" ;;
  esac
  awk -F '\t' -v m="$me" '$1=="N" && $2==m { found=1 } END { exit !found }' "$PARSE" \
    || die "$me is not a node in $PLAN"
}

abs_path() {
  dir=$(dirname "$1")
  file=$(basename "$1")
  printf '%s/%s\n' "$(cd "$dir" && pwd)" "$file"
}

report_edges() {
  say "OK $(abs_path "$PLAN")"
  awk -F '\t' '$1=="E" { extra = ($5 != "" ? " " $5 : ""); print $2 " -> " $3 " " $4 extra }' "$PARSE"
  say "dry-run"
}

emit_act() {
  me=$1
  plan=$(abs_path "$PLAN")
  inbox=$(abs_path "$(node_path "$me")")
  bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  cat <<ACTEOF
how to act:
you are node $me
plan: $plan
inbox: $inbox
watch: $bindir/channel-arm $plan $me
  If your agent's /channel skill names a wrapper for the watch (cursor: .cursor/lib/cursor-channel-watch $plan $me), run that wrapper instead and never start channel-arm yourself.
  Leave the watch running as a persistent monitor. It prints READY, then FILE <path> for the oldest message in your inbox, and the next oldest only after that file is removed.
  If it prints ALREADY-WATCHING and exits, a watch for this node is already running: do not start another. If it exits with any other message, report that message and stop; do not work around it.
  The watch answers PING for you (it sends PONG and removes the PING) and never shows it; for a check-all PING (body has SCOPE: all) it also starts the check on your own arrows.
  If it cannot answer a PING, it prints CHANNEL-AUTO-REPLY-FAILED on stderr (also in syslog), keeps running, and shows that PING as FILE: answer it by hand as below.
  With no watch running, or for a PING shown as FILE, answer it yourself: send PONG to its sender with the PING's NONCE line (plus the lines of the plan's PONG message block, if it has one), then rm the PING. If the PING also has SCOPE: all and RUN: <id>, then run $bindir/channel-ping --run <id> $plan $me (it does nothing if this node already handled that run or ran a check-all in the last 30 minutes).
start: before new messages, look in $inbox/claimed/. Those are messages you already started and may have partly done. Check whether your reply was already sent before redoing anything. Nothing reclaims a claim by age; report claims you cannot finish.
read: a message file has FROM, TO, SEQ, VERB and REFS (zero or more files, paths relative to the plan directory, or - none), then a --- line, then the body.
  Handle the oldest FILE first, one file at a time. You may move it into $inbox/claimed/ while you work (the watch ignores subfolders and shows the next file); optionally write claimed/<file>.owner saying who has it.
send: $bindir/channel-send $plan $me DEST VERB BODYFILE [REF ...]
  or:  $bindir/channel-send $plan $me DEST VERB -m 'TEXT' [-m 'TEXT' ...] [REF ...]   (each -m is one block of lines; blocks are joined by a blank line)
  or:  $bindir/channel-send $plan $me DEST VERB - [REF ...]   (- or no BODYFILE reads the body from stdin)
  DEST must be a node you have an arrow to and VERB must be listed on that arrow (see the verb lines below). PING and PONG are built in on every arrow; their body is NONCE: <value>, or what the plan's PING/PONG message block asks for (the tools fill only NONCE, SCOPE and RUN there; any other <...> line makes them fail with CHANNEL-CONTROL-BODY).
  Body: copy every line without <...> exactly. For a line with <...>, keep the text before < and replace <...> with a real value.
  Lines are compared after trimming spaces; blank lines are ignored and extra lines are allowed.
  REF files are optional and a message may carry several; each is copied into refs/ and listed under REFS.
  On a -> arrow the send waits until DEST removes your previous message; on -< it queues. PING and PONG never wait.
done: rm the FILE when you have finished it (from claimed/ only after your reply is sent). Removing it is the acknowledgement.
tools: $bindir/channel-ping $plan $me tests each of your arrows now; with --all every node it reaches passes the check on, so all links get tested.
  $bindir/channel-status $plan shows each inbox's message count, oldest age, and claimed files.
after a start or a compact, run $bindir/channel-arm $plan $me --whatineedtoknow again, then check claimed/ (see start).

ACTEOF
}

abs_path() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$(pwd)" "${1#./}" ;;
  esac
}

emit_what() {
  emit_act "$1"
  awk -F '\t' -v me="$1" '
function sort_into(src, dst,    n, i, j, tmp, k) {
  n = 0
  for (k in src) { n++; dst[n] = k }
  for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (dst[j] < dst[i]) { tmp = dst[i]; dst[i] = dst[j]; dst[j] = tmp }
  return n
}
$1=="N" { path[$2] = $3; next }
$1=="E" { ec++; es[ec] = $2; ed[ec] = $3; emode[ec] = $4; next }
$1=="V" { verb[$2 " " $3] = $4; next }
$1=="M" { cur = $2; next }
$1=="D" { desc[cur] = (cur in desc && desc[cur] != "" ? desc[cur] "\n" : "") substr($0, 3); next }
$1=="B" { body[cur] = body[cur] substr($0, 3) "\n"; next }
END {
  print "node " me " " path[me]
  for (i = 1; i <= ec; i++) if (es[i] == me || ed[i] == me) {
    if (es[i] != me) other[es[i]] = 1
    if (ed[i] != me) other[ed[i]] = 1
  }
  n = sort_into(other, names)
  for (i = 1; i <= n; i++) print "node " names[i] " " path[names[i]]
  used_n = 0
  for (i = 1; i <= ec; i++) if (es[i] == me || ed[i] == me) {
    print es[i] " -> " ed[i] " " emode[i]
    print "verb " es[i] " " ed[i] " " verb[es[i] " " ed[i]]
    nw = split(verb[es[i] " " ed[i]], w, " ")
    for (j = 1; j <= nw; j++) { used_n++; used[used_n] = w[j] }
  }
  for (j = 1; j <= used_n; j++) if (!(used[j] in seen)) {
    seen[used[j]] = 1
    word = used[j]
    print "message " word " {"
    if (desc[word] != "") print desc[word]
    print "body: {"
    nb = split(body[word], bl, "\n")
    for (k = 1; k <= nb; k++) if (bl[k] != "") print bl[k]
    print "}"
    print "}"
  }
}
' "$PARSE"
}

node_path() {
  awk -F '\t' -v m="$1" '$1=="N" && $2==m { print $3 }' "$PARSE"
}

json_str() {
  printf '%s' "$1" | awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); print }'
}

# One POST. Sets code, resp, and retry (0 only for 401, 403, 404, 405, 410: a wrong key or
# URL, which no retry fixes; 400 is retried, since a webhook host can report its rate limit as 400).
post_once() {
  wout=$(mktemp) || { code="mktemp failed"; resp=; retry=0; return 0; }
  if [ -n "$2" ]; then
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$2" | curl -sS -o "$wout" -w '%{http_code}' \
      --connect-timeout 5 --max-time 15 -X POST -K - -H 'Content-Type: application/json' \
      --data-binary "$3" -- "$1" 2>&1) || code="curl error: $code"
  else
    code=$(curl -sS -o "$wout" -w '%{http_code}' --connect-timeout 5 --max-time 15 -X POST \
      -H 'Content-Type: application/json' --data-binary "$3" -- "$1" 2>&1) || code="curl error: $code"
  fi
  code=$(printf '%s' "$code" | tr '\n' ' ')
  resp=$(head -c 300 "$wout" 2>/dev/null | tr '\n' ' '); rm -f "$wout"
  case "$code" in
    401|403|404|405|410) retry=0 ;;
    *) retry=1 ;;
  esac
}

# After a successful send: POST to the recipient's webhook if its node line has one.
# Failures warn on stderr and never change the exit status; the message stays queued.
fire_webhook() {
  wline=$(awk -F '\t' -v m="$1" '$1=="W" && $2==m { print; exit }' "$PARSE")
  [ -n "$wline" ] || return 0
  wurl=$(printf '%s\n' "$wline" | cut -f3)
  wfile=$(printf '%s\n' "$wline" | cut -f4)
  wkey=$(printf '%s\n' "$wline" | cut -f5)
  wret=$(printf '%s\n' "$wline" | cut -f6)
  wmax=$(printf '%s\n' "$wline" | cut -f7)
  if [ -n "$wfile" ]; then
    case "$wfile" in /*) ;; *) wfile=$(cd "$(dirname "$PLAN")" && pwd)/$wfile ;; esac
    if [ ! -r "$wfile" ]; then
      note "WARNING: webhook for $1 not fired: cannot read webhook_key_file $wfile (message is queued)"
      return 0
    fi
    wkey=$(head -n 1 -- "$wfile" | tr -d '\r\n')
  fi
  case "$wkey" in "Authorization: Bearer "*) wkey=${wkey#Authorization: Bearer } ;; "Bearer "*) wkey=${wkey#Bearer } ;; esac
  if ! command -v curl >/dev/null 2>&1; then
    note "WARNING: webhook for $1 not fired: curl not found (message is queued)"
    return 0
  fi
  payload=$(printf '{"target":"%s","from":"%s","verb":"%s","inbox":"%s","file":"%s"}' \
    "$(json_str "$1")" "$(json_str "$2")" "$(json_str "$3")" "$(json_str "$4")" "$(json_str "$5")")
  post_once "$wurl" "$wkey" "$payload"
  case "$code" in
    2[0-9][0-9])
      say "WEBHOOK $1 $code $resp"
      log_event webhook result ok to "$1" from "$2" verb "$3" attempts 1 file "$5"
      return 0
      ;;
  esac
  if [ "$retry" -eq 0 ] || [ "${wret:-12}" -eq 0 ]; then
    log_event webhook result fail to "$1" from "$2" verb "$3" attempts 1 error "$code $resp" file "$5"
    note "WARNING: webhook for $1 failed ($code) ${resp} (message is queued)"
    return 0
  fi
  log_event webhook result retrying to "$1" from "$2" verb "$3" attempts 1 error "$code $resp" file "$5"
  note "WARNING: webhook for $1 failed ($code) ${resp}; retrying in the background (up to $wret more tries, backoff up to ${wmax}s; outcome in syslog) (message is queued)"
  # Detached retry job: this program again, in its own session (setsid), no stdio, so the
  # sender returns now and the job outlives it. The job, including the key, travels in the
  # environment, never on a command line.
  CHANNEL_WH_URL=$wurl CHANNEL_WH_KEY=$wkey CHANNEL_WH_BODY=$payload CHANNEL_WH_TARGET=$1 \
    CHANNEL_WH_FROM=$2 CHANNEL_WH_VERB=$3 CHANNEL_WH_FILE=$5 CHANNEL_WH_RETRIES=$wret CHANNEL_WH_MAX=$wmax \
    setsid "$bindir/channel" --webhook-retry </dev/null >/dev/null 2>&1 &
  return 0
}

# --webhook-retry: the background retries for one webhook (job in CHANNEL_WH_* env).
run_webhook_job() {
  attempt=1
  delay=1
  while [ "$attempt" -le "$CHANNEL_WH_RETRIES" ]; do
    attempt=$((attempt + 1))
    wait=$delay
    [ "$wait" -le "$CHANNEL_WH_MAX" ] || wait=$CHANNEL_WH_MAX
    sleep "$wait"
    delay=$((delay * 2))
    post_once "$CHANNEL_WH_URL" "$CHANNEL_WH_KEY" "$CHANNEL_WH_BODY"
    case "$code" in
      2[0-9][0-9])
        log_event webhook result ok to "$CHANNEL_WH_TARGET" from "$CHANNEL_WH_FROM" verb "$CHANNEL_WH_VERB" attempts "$attempt" file "$CHANNEL_WH_FILE"
        return 0
        ;;
    esac
    if [ "$retry" -eq 0 ] || [ "$attempt" -gt "$CHANNEL_WH_RETRIES" ]; then
      log_event webhook result fail to "$CHANNEL_WH_TARGET" from "$CHANNEL_WH_FROM" verb "$CHANNEL_WH_VERB" attempts "$attempt" error "$code $resp" file "$CHANNEL_WH_FILE"
      return 0
    fi
  done
}

# VERB, FROM and NONCE of a message file, tab-separated.
read_head() {
  awk 'BEGIN { body = 0 }
    !body && $0 == "---" { body = 1; next }
    !body && /^VERB: / { v = substr($0, 7) }
    !body && /^FROM: / { f = substr($0, 7) }
    body && /^[ \t]*NONCE:/ && n == "" { n = $0; sub(/^[ \t]*NONCE:[ \t]*/, "", n); sub(/[ \t]+$/, "", n) }
    END { printf "%s\t%s\t%s\n", v, f, n }' "$1" 2>/dev/null
}

has_edge() {
  awk -F '\t' -v s="$1" -v d="$2" '$1=="E" && $2==s && $3==d { found=1 } END { exit !found }' "$PARSE"
}

pong_path() {
  printf '%s/pong-%s\n' "$(dirname "$(node_path "$1")")" "$(printf '%s' "$2" | tr -c 'A-Za-z0-9_.-' '_')"
}

# control_body VERB KEY=VALUE... prints the body of a built-in PING or PONG. With a
# message block for VERB, literal lines are copied and each "KEY: <...>" line is filled
# by KEY (no value: CHANNEL-CONTROL-BODY error); keys the block does not mention are
# appended. Without a block the body is the KEY: VALUE lines alone.
control_body() {
  cverb_=$1
  shift
  awk -F '\t' -v verb="$cverb_" -v kv="$(printf '%s\n' "$@")" -v plan="$PLAN" '
BEGIN {
  n = split(kv, a, "\n")
  for (i = 1; i <= n; i++) {
    if (a[i] == "") continue
    eq = index(a[i], "=")
    k = substr(a[i], 1, eq - 1)
    val[k] = substr(a[i], eq + 1)
    order[++no] = k
    names = names (names == "" ? "" : ", ") k
  }
}
$1 == "M" { on = ($2 == verb); next }
$1 == "B" && on { t[++nt] = substr($0, 3); next }
END {
  for (i = 1; i <= nt; i++) {
    raw = t[i]
    open = index(raw, "<")
    endat = 0
    for (j = length(raw); j > 0; j--) if (substr(raw, j, 1) == ">") { endat = j; break }
    if (open > 0 && open < endat) {
      prefix = substr(raw, 1, open - 1)
      key = prefix
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      sub(/[ \t]*:$/, "", key)
      if (!(key in val)) {
        printf "CHANNEL-CONTROL-BODY: the %s message block in %s has the line \"%s\", which the tool cannot fill (it fills %s). Change that line to one of those, or make it literal.\n", verb, plan, raw, names > "/dev/stderr"
        exit 1
      }
      out[++m] = prefix val[key]
      used[key] = 1
    } else {
      out[++m] = raw
    }
  }
  for (i = 1; i <= m; i++) print out[i]
  for (i = 1; i <= no; i++) if (!(order[i] in used)) print order[i] ": " val[order[i]]
}' "$PARSE"
}

# channel-arm answers PING and files PONG for channel-ping; the agent never sees either.
handle_control() {
  [ -n "${ARM_ME:-}" ] || return 0
  for cpath in "$1"/*; do
    [ -f "$cpath" ] || continue
    cbase=$(basename "$cpath")
    printf '%s\n' "$cbase" | grep -Eq '^[0-9]{8}-[0-9]{6}\.[0-9]{3}__.+__[0-9]+\.md$' || continue
    head=$(read_head "$cpath")
    cverb=$(printf '%s' "$head" | cut -f1)
    cfrom=$(printf '%s' "$head" | cut -f2)
    cnonce=$(printf '%s' "$head" | cut -f3)
    [ -n "$cnonce" ] || continue
    grep -Fxq -- "$cpath" "$REPLYFAILED" && continue
    case "$cverb" in
      PING)
        if [ -n "$cnonce" ] && has_edge "$ARM_ME" "$cfrom"; then
          cfail=
          if cbody=$(control_body PONG "NONCE=$cnonce" 2>&1); then
            cfail=$("$bindir/channel-send" "$PLAN" "$ARM_ME" "$cfrom" PONG -m "$cbody" 2>&1 >/dev/null) && cfail= || cfail=${cfail:-channel-send failed}
          else
            cfail=$cbody
          fi
          if [ -n "$cfail" ]; then
            # Not silent and not fatal: warn, log, and show the PING as an ordinary FILE.
            cfail=$(printf '%s' "$cfail" | tr '\n' ' ')
            printf '%s\n' "$cpath" >> "$REPLYFAILED"
            note "CHANNEL-AUTO-REPLY-FAILED: channel-arm could not answer the PING from $cfrom ($cfail). The watch keeps running and shows that PING as FILE: answer it by hand (see the header), then rm it."
            log_event auto-reply result fail node "$ARM_ME" from "$cfrom" nonce "$cnonce" why "$cfail" file "$cpath"
            continue
          fi
        fi
        cscope=$(body_field "$cpath" SCOPE)
        crun=$(body_field "$cpath" RUN)
        rm -f -- "$cpath"
        log_event ping-answered node "$ARM_ME" from "$cfrom" nonce "$cnonce" scope "$cscope" run "$crun"
        if [ "$cscope" = all ] && [ -n "$crun" ]; then
          case "$crun" in
            *[!A-Za-z0-9_.-]*)
              note "check-all PING from $cfrom has a bad RUN \"$crun\"; not passed on"
              log_event checkall result fail node "$ARM_ME" run "$crun" why "bad run id"
              ;;
            *)
              setsid "$bindir/channel-ping" --run "$crun" "$PLAN" "$ARM_ME" </dev/null >/dev/null 2>&1 &
              ;;
          esac
        fi
        ;;
      PONG)
        mv -f -- "$cpath" "$(pong_path "$ARM_ME" "$cnonce")" || note "cannot file PONG for channel-ping"
        log_event pong-received node "$ARM_ME" from "$cfrom" nonce "$cnonce"
        ;;
    esac
  done
}

oldest_name() {
  found=
  for path in "$1"/*; do
    [ -f "$path" ] || continue
    base=$(basename "$path")
    printf '%s\n' "$base" | grep -Eq '^[0-9]{8}-[0-9]{6}\.[0-9]{3}__.+__[0-9]+\.md$' || continue
    if [ -z "$found" ]; then
      found=$base
    else
      small=$(printf '%s\n%s\n' "$base" "$found" | sort | head -n 1)
      [ "$small" = "$base" ] && found=$base
    fi
  done
  printf '%s\n' "$found"
}

announce() {
  inbox=$1
  [ -d "$inbox" ] || die "inbox disappeared: $inbox"
  shown=$(cat "$SHOWN" 2>/dev/null || true)
  handle_control "$inbox"
  oldest=$(oldest_name "$inbox")
  if [ "$oldest" = "$shown" ]; then
    return 0
  fi
  if [ -n "$shown" ] && [ -f "$inbox/$shown" ]; then
    return 0
  fi
  [ -z "$shown" ] || log_event consumed node "$ARM_ME" file "$inbox/$shown"
  if [ -z "$oldest" ]; then
    : > "$SHOWN"
    return 0
  fi
  say "FILE $inbox/$oldest"
  log_event deliver node "$ARM_ME" file "$inbox/$oldest"
  printf '%s\n' "$oldest" > "$SHOWN"
}

watch_oldest() {
  while true; do
    announce "$1"
    sleep 0.2
  done
}

# CHANNEL_POLL=1 is the only way to list the inbox instead of using inotifywait;
# if inotifywait cannot run, the command fails rather than switching.
INOTIFY_FIX="(install inotify-tools, or set CHANNEL_POLL=1 to list the inbox every 0.2s)"
try_inotify() {
  [ "${CHANNEL_POLL:-}" = 1 ] && return 1
  command -v inotifywait >/dev/null 2>&1 || die "inotifywait not found $INOTIFY_FIX"
  return 0
}

# One inotifywait event, or a one-second timeout, then return to this shell.
# announce stays here so a failure exits the program rather than a pipeline child.
inotify_loop() {
  inbox=$1
  fails=0
  while [ -d "$inbox" ]; do
    rc=0
    inotifywait -q -t 1 -e moved_to -e moved_from -e delete --format '%f' "$inbox" >/dev/null 2>&1 || rc=$?
    announce "$inbox"
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
      fails=0
      continue
    fi
    fails=$((fails + 1))
    if [ "$fails" -ge 3 ]; then
      die "inotifywait failed 3 times in a row (exit $rc); the watch stops. Start channel-arm again. $INOTIFY_FIX"
    fi
  done
  announce "$inbox"
  die "inbox disappeared: $inbox"
}

cmd_setup() {
  [ $# -eq 2 ] || die "usage: $invoked FILE NODE [-n|--dry-run] [--whatineedtoknow]"
  PLAN=$1
  [ -f "$PLAN" ] || die "no plan file $PLAN"
  parse_plan "$PLAN"
  require_me "$2"
  if [ "$dry" -eq 1 ]; then
    report_edges
  fi
  if [ "$what" -eq 1 ]; then
    emit_what "$2"
  fi
  if [ "$dry" -eq 1 ] || [ "$what" -eq 1 ]; then
    return 0
  fi
  umask 002
  refs=$(dirname "$PLAN")/refs
  inbox=$(node_path "$2")
  # Rerunning on an existing node is safe: create whatever is missing, change nothing that exists.
  if [ ! -d "$refs" ]; then
    mkdir -p "$refs"
    chmod 2775 "$refs" 2>/dev/null || note "chmod 2775 $refs failed"
  fi
  if [ -d "$inbox" ]; then
    say "node $2 inbox $inbox existing"
    return 0
  fi
  mkdir -p "$inbox"
  node=$(dirname "$inbox")
  chmod 2775 "$node" 2>/dev/null || note "chmod 2775 $node failed"
  chmod 2775 "$inbox" 2>/dev/null || note "chmod 2775 $inbox failed"
  say "node $2 inbox $inbox"
}

# Only one channel-arm watches a node. A live watch recorded in nodes/NODE/arm.pid
# is reported (ALREADY-WATCHING, exit 3) and this one does not start.
arm_alive() {
  [ -r "/proc/$1/cmdline" ] || return 1
  tr '\000' '\n' < "/proc/$1/cmdline" | awk '
    { a[NR] = $0; n = split($0, parts, "/"); b[NR] = parts[n] }
    END {
      for (i = 1; i <= NR; i++) {
        if (b[i] == "channel-arm") exit 0
        if (b[i] == "channel.py" && a[i + 1] == "arm") exit 0
        if (b[i] == "channel") for (j = i + 1; j <= NR; j++) if (a[j] == "--arm") exit 0
      }
      exit 1
    }'
}

claim_watch() {
  host=$(hostname) || die "cannot read hostname"
  if [ -f "$1" ]; then
    read -r opid ohost < "$1" || die "cannot read $1"
    if [ -n "${ohost:-}" ] && [ "$ohost" != "$host" ]; then
      say "ALREADY-WATCHING $2 pid $opid on host $ohost (cannot check it from here; remove $1 if that watch is gone)"
      exit 3
    fi
    if [ -n "${opid:-}" ] && [ "$opid" != "$$" ] && arm_alive "$opid"; then
      say "ALREADY-WATCHING $2 pid $opid (a watch for this node is running; do not start another)"
      exit 3
    fi
  fi
  { printf '%s %s\n' "$$" "$host" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1"; } || die "cannot write $1"
}

cmd_arm() {
  if [ "$dry" -eq 1 ]; then
    die "--dry-run is only for channel-setup"
  fi
  if [ "$what" -eq 1 ]; then
    [ $# -eq 2 ] || die "usage: $invoked FILE NODE --whatineedtoknow"
  else
    [ $# -eq 2 ] || die "usage: $invoked FILE NODE"
  fi
  PLAN=$1
  [ -f "$PLAN" ] || die "no plan file $PLAN"
  parse_plan "$PLAN"
  require_me "$2"
  if [ "$what" -eq 1 ]; then
    emit_what "$2"
    return 0
  fi
  inbox=$(node_path "$2")
  [ -d "$inbox" ] || die "no directory $inbox; run channel-setup $PLAN $2"
  ARM_ME=$2
  claim_watch "$(dirname "$inbox")/arm.pid" "$2"
  if try_inotify; then
    say "READY"
    announce "$inbox"
    inotify_loop "$inbox"
  else
    note "channel-arm is listing the inbox every 0.2s. inotifywait is not in use."
    say "READY"
    watch_oldest "$inbox"
  fi
}

sender_of() {
  rest=${1#*__}
  printf '%s\n' "${rest%__*}"
}

wait_until_removed() {
  inbox=$1
  base=$2
  target=$inbox/$base
  say "PENDING $target"
  if ! try_inotify; then
    note "channel-send is listing the inbox every 0.2s until the pending file is removed. inotifywait is not in use."
    while [ -f "$target" ]; do
      sleep 0.2
    done
    return 0
  fi
  while [ -f "$target" ]; do
    rc=0
    inotifywait -q -t 1 -e moved_from -e delete --format '%f' "$inbox" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || [ ! -f "$target" ] ||
      die "inotifywait failed (exit $rc) while waiting for $target to be removed; nothing was sent. $INOTIFY_FIX"
  done
}

check_body() {
  verb=$1
  body=$2
  awk -F '\t' -v verb="$verb" -v body="$body" '
function die(msg) { print msg > "/dev/stderr"; exit 1 }
$1=="M" { cur=$2; on=(cur==verb); next }
$1=="B" && on { tmpl[++n] = substr($0, 3); next }
END {
  while ((getline line < body) > 0) {
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line != "") sent[++sn] = line
  }
  close(body)
  for (i = 1; i <= n; i++) {
    raw = tmpl[i]
    open = index(raw, "<")
    endat = 0
    for (j = length(raw); j > 0; j--) if (substr(raw, j, 1) == ">") { endat = j; break }
    if (open > 0 && open < endat) {
      prefix = substr(raw, 1, open - 1)
      filled = 0
      for (j = 1; j <= sn; j++) {
        line = sent[j]
        if (prefix != "" && index(line, prefix) != 1) continue
        value = line
        if (prefix != "") {
          value = substr(line, length(prefix) + 1)
          gsub(/^[ \t]+|[ \t]+$/, "", value)
        }
        if (value != "" && !(substr(value, 1, 1) == "<" && substr(value, length(value), 1) == ">")) filled = 1
      }
      if (!filled) die(verb " body is missing a value for: " raw)
    } else {
      ok = 0
      for (j = 1; j <= sn; j++) if (sent[j] == raw) ok = 1
      if (!ok) die(verb " body is missing the line: " raw)
    }
  }
}
' "$PARSE"
}

cmd_send() {
  if [ "$dry" -eq 1 ]; then
    die "--dry-run is only for channel-setup"
  fi
  if [ "$what" -eq 1 ]; then
    [ $# -eq 2 ] || die "usage: $invoked FILE NODE --whatineedtoknow"
    PLAN=$1
    [ -f "$PLAN" ] || die "no plan file $PLAN"
    parse_plan "$PLAN"
    require_me "$2"
    emit_what "$2"
    return 0
  fi
  [ $# -ge 4 ] || die "usage: $invoked FILE NODE RECIPIENT VERB [BODYFILE|-|-m TEXT...] [REF ...]"
  PLAN=$1
  me=$2
  recipient=$3
  verb=$4
  shift 4
  if [ "$nmsg" -gt 0 ]; then
    body=$MSGS
  elif [ $# -eq 0 ] || [ "$1" = - ]; then
    cat > "$BODYTMP" || die "cannot read the body from stdin"
    body=$BODYTMP
    [ $# -eq 0 ] || shift
  else
    body=$1
    shift
  fi
  [ -f "$PLAN" ] || die "no plan file $PLAN"
  parse_plan "$PLAN"
  require_me "$me"
  node_path "$recipient" | grep -q . || die "unknown node (recipient=$recipient)"
  mode_edge=$(awk -F '\t' -v s="$me" -v d="$recipient" '$1=="E" && $2==s && $3==d { print $4; found=1 } END { exit !found }' "$PARSE") \
    || die "$me is not allowed to send to $recipient"
  words=$(awk -F '\t' -v s="$me" -v d="$recipient" '$1=="V" && $2==s && $3==d { print $4 }' "$PARSE")
  ok=0
  control=0
  case "$verb" in PING|PONG) control=1; ok=1 ;; esac
  for w in $words; do
    [ "$w" = "$verb" ] && ok=1
  done
  [ "$ok" -eq 1 ] || die "verb $verb is not allowed on $me -> $recipient"
  [ -f "$body" ] || die "no body file $body"
  if [ "$control" -eq 1 ] && ! awk '{ sub(/^[ \t]+/, "") } /^NONCE:[ \t]*[^ \t]/ { f=1 } END { exit !f }' "$body"; then
    control_wait=1
  else
    control_wait=0
  fi
  if [ "$control" -eq 1 ] && ! awk -F '\t' -v v="$verb" '$1=="M" && $2==v { f=1 } END { exit !f }' "$PARSE"; then
    awk '{ sub(/^[ \t]+/, "") } /^NONCE:[ \t]*[^ \t<]/ { f=1 } END { exit !f }' "$body" || die "$verb body is missing a value for: NONCE: <nonce>"
  else
    check_body "$verb" "$body"
  fi
  for ref in "$@"; do
    [ -f "$ref" ] || die "no referenced file $ref"
  done
  mine=$(node_path "$me")
  inbox=$(node_path "$recipient")
  [ -d "$mine" ] || die "no directory $mine; run channel-setup $PLAN $me"
  [ -d "$inbox" ] || die "no directory $inbox; run channel-setup $PLAN $recipient"
  if [ "$mode_edge" = wait ] && { [ "$control" -eq 0 ] || [ "$control_wait" -eq 1 ]; }; then
    for path in "$inbox"/*; do
      [ -f "$path" ] || continue
      base=$(basename "$path")
      printf '%s\n' "$base" | grep -Eq '^[0-9]{8}-[0-9]{6}\.[0-9]{3}__.+__[0-9]+\.md$' || continue
      [ "$(sender_of "$base")" = "$me" ] || continue
      wait_until_removed "$inbox" "$base"
    done
  fi
  for ref in "$@"; do
    [ -f "$ref" ] || die "no referenced file $ref"
  done
  node=$(dirname "$mine")
  refs=$(dirname "$PLAN")/refs
  [ -d "$refs" ] || die "no directory $refs; run channel-setup $PLAN $me"
  # Lock-free sequence: create out-seq.d/N with noclobber; on collision try N+1.
  # A crash at worst skips a number. out-seq.txt is only a hint (last number used).
  seqd=$node/out-seq.d
  seqf=$node/out-seq.txt
  mkdir -p "$seqd"
  current=1
  if [ -f "$seqf" ]; then
    while read -r k v _; do
      if [ "$k" = next ]; then current=$((v + 1)); fi
    done < "$seqf"
  fi
  while ! (set -C; : > "$seqd/$current") 2>/dev/null; do
    [ -d "$seqd" ] || die "cannot create $seqd/$current"
    [ -e "$seqd/$current" ] || die "cannot create $seqd/$current"
    current=$((current + 1))
  done
  printf 'next %s\n' "$current" > "$seqf.tmp.$$" && mv -f "$seqf.tmp.$$" "$seqf" || true
  stamp=$(date +%Y%m%d-%H%M%S.%3N)
  seq4=$(printf '%04d' "$current")
  copied=
  for ref in "$@"; do
    dest=$refs/${stamp}__${me}__${seq4}__$(basename "$ref")
    cp -- "$ref" "$dest"
    chmod 0660 "$dest" || note "chmod 0660 $dest failed"
    rel=refs/$(basename "$dest")
    copied=${copied}${copied:+
}${rel}
  done
  filename=${stamp}__${me}__${seq4}.md
  tmp=$node/.tmp-$filename
  {
    printf 'FROM: %s\nTO: %s\nSEQ: %s\nVERB: %s\nREFS:\n' "$me" "$recipient" "$current" "$verb"
    if [ -z "$copied" ]; then
      printf '%s\n' "- none"
    else
      oldifs=$IFS
      IFS='
'
      for item in $copied; do
        printf -- '- %s\n' "$item"
      done
      IFS=$oldifs
    fi
    printf '%s\n' "---"
    cat "$body"
    last=$(tail -c 1 "$body" 2>/dev/null || true)
    [ "$last" = "" ] || [ "$last" = "$(printf '\n')" ] || printf '\n'
  } > "$tmp"
  chmod 0660 "$tmp" || note "chmod 0660 $tmp failed"
  dev1=$(stat -c %d -- "$tmp")
  dev2=$(stat -c %d -- "$inbox")
  if [ "$dev1" != "$dev2" ]; then
    die "$tmp and $inbox are on different filesystems, so the rename would not be atomic"
  fi
  mv -f -- "$tmp" "$inbox/$filename"
  say "SENT $inbox/$filename"
  nrefs=0
  for _r in "$@"; do nrefs=$((nrefs + 1)); done
  log_event send plan "$PLAN" from "$me" to "$recipient" verb "$verb" seq "$current" refs "$nrefs" file "$inbox/$filename"
  LAST_SENT=$inbox/$filename
  fire_webhook "$recipient" "$me" "$verb" "$inbox" "$inbox/$filename" || true
}

# Records RUN for this node; fails (prints SKIP) if RUN was already handled here, or,
# for a propagated run, if this node ran a check-all within check_every minutes.
check_all_allowed() {
  seen=$1/checkall-runs
  if [ -f "$seen" ] && awk -v r="$3" '$1 == r { f=1 } END { exit !f }' "$seen"; then
    say "SKIP $2 already handled check-all run $3"
    log_event checkall result skip node "$2" run "$3" why "run already handled"
    return 1
  fi
  cstamp=$1/checkall.stamp
  if [ -f "$cstamp" ] && [ "$4" -eq 0 ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$cstamp") ))
    if [ "$age" -lt $((check_every * 60)) ]; then
      say "SKIP $2 ran a check-all ${age}s ago (limit every $check_every min)"
      log_event checkall result skip node "$2" run "$3" why "rate limit"
      return 1
    fi
  fi
  # Without the record the run and rate checks cannot stop a loop, so do not pass it on.
  if ! { printf '%s %s\n' "$3" "$(date +%s)" >> "$seen" && date +%Y-%m-%dT%H:%M:%S%:z > "$cstamp"; }; then
    note "check-all run $3 not started: cannot record it in $1"
    log_event checkall result fail node "$2" run "$3" why "cannot record run"
    return 1
  fi
  return 0
}

body_field() {
  awk -v k="$2:" 'b && index($0, k) == 1 { v = substr($0, length(k) + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit } $0 == "---" { b = 1 }' "$1" 2>/dev/null
}

cmd_ping() {
  [ "$dry" -eq 0 ] && [ "$what" -eq 0 ] && [ $# -eq 2 ] || die "usage: $invoked FILE NODE [--all [--every MIN]] [--timeout SEC]"
  PLAN=$1
  me=$2
  [ -f "$PLAN" ] || die "no plan file $PLAN"
  parse_plan "$PLAN"
  require_me "$me"
  myinbox=$(node_path "$me")
  [ -d "$myinbox" ] || die "no directory $myinbox; run channel-setup $PLAN $me"
  run=$ping_run
  if [ "$ping_all" -eq 1 ]; then
    origin=0
    if [ -z "$run" ]; then
      origin=1
      run=$me-$(date +%Y%m%d-%H%M%S)-$$
    fi
    check_all_allowed "$(dirname "$myinbox")" "$me" "$run" "$origin" || return 0
    say "CHECKALL $me run $run"
    log_event checkall result start node "$me" run "$run"
  fi
  probes=$(mktemp)
  for dest in $(awk -F '\t' -v s="$me" '$1=="E" && $2==s { print $3 }' "$PARSE"); do
    nonce=$me-$dest-$(date +%Y%m%d-%H%M%S)-$$
    if [ "$ping_all" -eq 1 ]; then
      pbody=$(control_body PING "NONCE=$nonce" "SCOPE=all" "RUN=$run" 2>&1) || { log_event ping result fail from "$me" to "$dest" run "$run" why "$pbody"; die "$pbody"; }
    else
      pbody=$(control_body PING "NONCE=$nonce" 2>&1) || { log_event ping result fail from "$me" to "$dest" why "$pbody"; die "$pbody"; }
    fi
    sent=$("$bindir/channel-send" "$PLAN" "$me" "$dest" PING -m "$pbody" | awk '/^SENT / { print substr($0, 6) }')
    two=0
    has_edge "$dest" "$me" && two=1
    printf '%s\t%s\t%s\t%s\n' "$dest" "$nonce" "$sent" "$two" >> "$probes"
  done
  start=$(date +%s.%N)
  deadline=$(( $(date +%s) + ping_timeout ))
  done_list=
  failed=0
  while :; do
    left=0
    while IFS='	' read -r dest nonce sent two; do
      case " $done_list " in *" $dest "*) continue ;; esac
      ok=0
      if [ "$two" = 1 ]; then
        pp=$(pong_path "$me" "$nonce")
        if [ -f "$pp" ]; then
          rm -f -- "$pp"; ok=1
        else
          for mp in "$myinbox"/*.md; do
            [ -f "$mp" ] || continue
            h=$(read_head "$mp")
            if [ "$(printf '%s' "$h" | cut -f1)" = PONG ] && [ "$(printf '%s' "$h" | cut -f3)" = "$nonce" ]; then
              rm -f -- "$mp"; ok=1; break
            fi
          done
        fi
        kind=PONG
      else
        [ -f "$sent" ] || ok=1
        kind=CONSUMED
      fi
      if [ "$ok" -eq 1 ]; then
        secs=$(awk -v a="$start" -v b="$(date +%s.%N)" 'BEGIN { printf "%.1fs", b - a }')
        say "$kind $dest $secs"
        log_event ping result ok from "$me" to "$dest" kind "$(printf '%s' "$kind" | tr A-Z a-z)" seconds "$secs" run "$run"
        done_list="$done_list $dest"
      else
        left=$((left + 1))
      fi
    done < "$probes"
    [ "$left" -gt 0 ] || break
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep 0.2
  done
  while IFS='	' read -r dest nonce sent two; do
    case " $done_list " in *" $dest "*) continue ;; esac
    failed=1
    if [ "$two" = 1 ]; then want="no PONG"; else want="PING not consumed"; fi
    say "TIMEOUT $dest ($want after ${ping_timeout}s)"
    log_event ping result timeout from "$me" to "$dest" nonce "$nonce" run "$run"
  done < "$probes"
  rm -f "$probes"
  [ "$failed" -eq 0 ] || exit 1
}

cmd_status() {
  [ "$dry" -eq 0 ] && [ "$what" -eq 0 ] && [ $# -eq 1 ] || die "usage: $invoked FILE"
  PLAN=$1
  [ -f "$PLAN" ] || die "no plan file $PLAN"
  parse_plan "$PLAN"
  now=$(date +%s)
  awk -F '\t' '$1=="N" { print $2 "\t" $3 }' "$PARSE" | while IFS='	' read -r name inbox; do
    if [ ! -e "$inbox" ]; then say "node $name $inbox missing"; continue; fi
    if ! ls -- "$inbox" >/dev/null 2>&1; then say "node $name $inbox no permission"; continue; fi
    count=0
    oldest=
    for mp in "$inbox"/*; do
      [ -f "$mp" ] || continue
      printf '%s\n' "$(basename "$mp")" | grep -Eq '^[0-9]{8}-[0-9]{6}\.[0-9]{3}__.+__[0-9]+\.md$' || continue
      count=$((count + 1))
      [ -n "$oldest" ] || oldest=$mp
    done
    line="node $name $inbox messages $count"
    [ -z "$oldest" ] || line="$line oldest $((now - $(stat -c %Y "$oldest")))s"
    cl=$inbox/claimed
    ccount=0
    clist=
    if [ -d "$cl" ] && ! ls -- "$cl" >/dev/null 2>&1; then
      line="$line claimed no-permission"
    elif [ -d "$cl" ]; then
      for cp in "$cl"/*; do
        [ -f "$cp" ] || continue
        case "$cp" in *.owner) continue ;; esac
        ccount=$((ccount + 1))
        item="$(basename "$cp") $((now - $(stat -c %Y "$cp")))s"
        [ ! -f "$cp.owner" ] || item="$item owner=$(head -n 1 "$cp.owner")"
        clist="$clist
  claimed $item"
      done
    fi
    say "$line claimed $ccount"
    [ -z "$clist" ] || printf '%s\n' "${clist#?}"
  done
}

case "$mode" in
  ping) cmd_ping "$@" ;;
  status) cmd_status "$@" ;;
  setup) cmd_setup "$@" ;;
  arm) cmd_arm "$@" ;;
  send) cmd_send "$@" ;;
  webhook-retry) run_webhook_job ;;
  *) die "unknown mode $mode" ;;
esac
