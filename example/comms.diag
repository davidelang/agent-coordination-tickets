# -> one message in flight: the next send waits until DEST removes the last one.
# -< many queue: each send goes at once and files pile up at the crow's foot.
# The mark is at the receiving end: an arrowhead (> on the right, < on the left) is ->,
# a crow's foot (< on the right, > on the left) is -<.
# One line can carry both directions: <->, >-<, >->.
# blockdiag 3.0 draws all of these except >-> and <-< (see docs/diagram-marks.md).

blockdiag {
  # planner to coder: one task in flight (planner waits for coder to finish it).
  # coder to planner: reports queue (coder never waits on planner).
  planner >-> coder;
}

/*
# node NAME /absolute/inbox
#   Messages to NAME are placed in that directory by an atomic rename.
#   When NAME finishes a message, it removes the file.
#   If NAME is restarted, it handles the oldest file still in the inbox.
#   Running that work again has to be safe. A half-finished plan is not detected.
#
# node NAME /absolute/inbox webhook=URL [webhook_key=TOKEN | webhook_key_file=PATH]
#   Optional. After channel-send queues a message to NAME, it POSTs to URL.
#   Give only the key. The tool sends "Authorization: Bearer <key>".
#   A leading "Bearer " or "Authorization: Bearer " is stripped.
#   webhook_key=TOKEN puts the key inline. webhook_key_file=PATH reads its first line.
#   Both are fully supported. A relative PATH is resolved from this file's directory.
#   Body (Content-Type: application/json):
#     {"target":NAME,"from":SENDER,"verb":VERB,"inbox":INBOX,"file":PATH}
#   Success prints "WEBHOOK NAME CODE RESPONSE". A failure prints a WARNING;
#   the message stays queued and the send still succeeds.
#   Values may not contain spaces. The webhook belongs to this workflow only.
#
# verb SOURCE DEST WORD...
#   SOURCE may send those words to DEST. A word needs a message block.
#   The blocks can sit before or after the verb lines.
#
# message NAME { ... body: { ... } }
#   The text inside the braces is what an agent reads.
#   A line with <...> has one filled-in value. Every other line is sent verbatim.
#   A line that starts with # or // is a note. The script skips it.
#   Put # or // at the start of a node, verb, or message line to leave it out.

# Dummy prefix /channel stands in for the sandbox absolute path. In a
# consuming repo the plan is sandbox/connect/<workspace>/config.diag and the
# inboxes sit next to it. <workspace> is the descriptive name (the branch
# given to setup_agent.sh, e.g. feature-x, or master); agent-N is only the
# checkout slot.
node planner /channel/connect/feature-x/nodes/planner/inbox
node coder /channel/connect/feature-x/nodes/coder/inbox

verb planner coder IMPLEMENT RESUME PROVIDE-EVIDENCE STOP
verb coder planner COMPLETE FAILURE BLOCKED STOPPED DAVID-DIRECT
# A reviewer node the coder's dispatcher talks to directly (the REVIEW verb line makes it so),
# so reviews do not wake the planner. Add the arrow `coder >-> reviewer;`, these lines,
# and REVIEW / REVIEW-PASS / REVIEW-FAIL / REVIEW-ERROR blocks with PLAN, RANGE, ROUND
# and REF lines (the replies also STATUS, PROBLEMS, REASON, VERDICT-FILE); see tests/dispatch.
# node reviewer /channel/connect/feature-x/nodes/reviewer/inbox
# verb coder reviewer REVIEW
# verb reviewer coder REVIEW-PASS REVIEW-FAIL REVIEW-ERROR

message IMPLEMENT {
This message is one approved plan to be implemented. It is sent after the user has approved a specific plan, or a project that this plan is part of.
body: {
ACTION: IMPLEMENT
PLAN: <path/to/plan>
FROM-STEP: <step, or the beginning>
}
}

message RESUME {
This message continues a plan that was already approved, from the named step.
body: {
ACTION: RESUME
PLAN: <path/to/plan>
FROM-STEP: <step>
}
}

message PROVIDE-EVIDENCE {
This message asks for the named check to be run again. The tree stays as it is.
body: {
ACTION: PROVIDE-EVIDENCE
PLAN: <path/to/plan>
CHECK: <what to run>
}
}

message STOP {
This message says to stop. The tree stays as it is.
body: {
ACTION: STOP
PLAN: <path/to/plan>
}
}

message COMPLETE {
This message says the plan is done and the checks passed.
body: {
STATUS: COMPLETE
PLAN: <path/to/plan>
RESPONDING-TO: <path/to/message>
}
}

message FAILURE {
This message says a step failed.
body: {
STATUS: FAILURE
PLAN: <path/to/plan>
RESPONDING-TO: <path/to/message>
REASON: <what failed>
}
}

message BLOCKED {
This message says that the coder's sanity checks prevent it from starting the plan. A re-plan or other fix is needed.
body: {
STATUS: BLOCKED
PLAN: <path/to/plan>
RESPONDING-TO: <path/to/message>
REASON: <text reason for the block>
}
}

message STOPPED {
This message says the work stopped before the plan was finished.
body: {
STATUS: STOPPED
PLAN: <path/to/plan>
RESPONDING-TO: <path/to/message>
REASON: <where things stand>
}
}

message DAVID-DIRECT {
This message says the human gave the coder the work in that window, rather than the planner sending it.
body: {
STATUS: <COMPLETE, FAILURE, BLOCKED, or STOPPED>
PLAN: <path/to/plan, or none>
REASON: <what the human asked, and how it ended>
}
}
# PING and PONG are built in on every arrow; channel-ping sends them and channel-arm
# answers them, so no verb line or message block is needed. Shape, for reference:
# message PING {
# Connectivity test. Reply PONG with the same NONCE, remove this file, do nothing else.
# body: {
# NONCE: <unique id>
# }
# }
# message PONG {
# Reply to PING.
# body: {
# NONCE: <the PING's NONCE>
# }
# }

*/
