#!/usr/bin/env bash
# End-to-end test of dispatch/dispatch with a scripted fake agent and two real dispatcher
# processes on a scratch diag: a coder (executor, watch mode) and a reviewer (watch mode)
# talking over the channel (bin/channel). The test plays the planner. No real agent runs.
# Cases: review FAIL -> fix -> PASS over the channel; an unrelated message queued during the
# wait; review timeout; STOP during the wait; a session that ends not done (one retry, then
# FAILURE); review cycles: fewer problems pass later, same/more problems or 3 FAILs go back to the
# planner with the full review history; the tree is never reset (the builds tag only moves on).
# Run from anywhere: tests/dispatch   (tests/run calls it)
set -euo pipefail
export LC_ALL=C CHANNEL_AGENT=grok DISPATCH_POLL_SEC=0.2
ROOT=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
CH=$ROOT/bin/channel
D=$ROOT/dispatch/dispatch
T=$(mktemp -d "$ROOT/.test-run.XXXXXX")
chgrp "$(id -g)" "$T" && chmod g-s "$T"
pass=0; fail=0
PIDS=()
cleanup() {
  local p
  for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null || :; done
  pkill -f "$T/" 2>/dev/null || :
  [[ -n "${KEEP:-}" ]] && echo "kept $T" >&2 || rm -rf "$T"
}
trap cleanup EXIT INT TERM
ok()  { pass=$((pass + 1)); printf 'ok  %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$1" >&2; }
check() { if eval "$2"; then ok "$1"; else bad "$1"; fi; }

# ---- fake agent: executor commits; reviewer takes one line per review from $T/reviews
cat >"$T/fake" <<'EOF'
#!/usr/bin/env bash
rules=""; pf=""; eff=""
while [[ $# -gt 0 ]]; do case "$1" in --rules) rules="$2"; shift 2;; --prompt-file) pf="$2"; shift 2;; --reasoning-effort) eff="$2"; shift 2;; *) shift;; esac; done
S=$FAKE_DIR
if [[ "$rules" == *"Role: reviewer"* ]]; then
  line=$(head -1 "$S/reviews" 2>/dev/null || echo PASS); sed -i '1d' "$S/reviews" 2>/dev/null || :
  echo "review $line" >>"$S/agent.log"
  case "$line" in
    SLEEP*) sleep "${line#SLEEP }"; t="slow ok\nPROBLEMS: 0\nSTATUS: PASS" ;;
    FAILNOCOUNT) t="a.txt: finding\nSTATUS: FAIL" ;;
    FAIL*) n=${line#FAIL }; t=""; for ((i = 1; i <= n; i++)); do t+="$i. a.txt: finding $i of $n\n"; done; t+="PROBLEMS: $n\nSTATUS: FAIL" ;;
    *) t="ok\nPROBLEMS: 0\nSTATUS: PASS" ;;
  esac
else
  line=$(head -1 "$S/execs" 2>/dev/null || echo SUCCESS); sed -i '1d' "$S/execs" 2>/dev/null || :
  kind=original; grep -q 'Fix the issues in' "$pf" && kind=fix; grep -q 'Finish ' "$pf" && kind=retry
  echo "exec $kind effort=${eff:-none} $line" >>"$S/agent.log"
  if [[ "$line" == FAILURE ]]; then t="could not\nSTATUS: FAILURE build red"
  else date +%s%N >>a.txt; git add a.txt; git commit -qm "fake $kind"; git tag -f builds >/dev/null; t="done\nSTATUS: SUCCESS"; fi
fi
printf '{"text":"%s","total_cost_usd":0}\n' "$t"
EOF
chmod +x "$T/fake"

# ---- scratch repo and diag (verbs, nodes and the coder -> reviewer REVIEW arrow; no settings file)
W=$T/work; C=$T/connect
git init -q "$W"; git -C "$W" config user.email t@t; git -C "$W" config user.name t
echo base >"$W/a.txt"; echo keep >"$W/ENGINEERING_LOG.md"; git -C "$W" add -A; git -C "$W" commit -qm base; git -C "$W" tag builds
mkdir -p "$C"; echo "# plan" >"$T/plan.md"
cat >"$C/config.diag" <<EOF
blockdiag {
  planner >-> coder;
  coder >-> reviewer;
}
/*
node planner $C/nodes/planner/inbox
node coder $C/nodes/coder/inbox
node reviewer $C/nodes/reviewer/inbox
verb planner coder IMPLEMENT STOP
verb coder planner COMPLETE FAILURE BLOCKED STOPPED
verb coder reviewer REVIEW
verb reviewer coder REVIEW-PASS REVIEW-FAIL REVIEW-ERROR
message IMPLEMENT {
body: {
ACTION: IMPLEMENT
PLAN: <plan>
FROM-STEP: <step>
}
}
message STOP {
body: {
ACTION: STOP
PLAN: <plan>
}
}
message COMPLETE {
body: {
STATUS: COMPLETE
PLAN: <plan>
RESPONDING-TO: <msg>
}
}
message FAILURE {
body: {
STATUS: FAILURE
PLAN: <plan>
RESPONDING-TO: <msg>
REASON: <reason>
}
}
message BLOCKED {
body: {
STATUS: BLOCKED
PLAN: <plan>
RESPONDING-TO: <msg>
REASON: <reason>
}
}
message STOPPED {
body: {
STATUS: STOPPED
PLAN: <plan>
RESPONDING-TO: <msg>
REASON: <reason>
}
}
message REVIEW {
body: {
ACTION: REVIEW
PLAN: <plan>
RANGE: <range>
ROUND: <round>
REF: <ref>
}
}
message REVIEW-PASS {
body: {
STATUS: <PASS>
REF: <ref>
ROUND: <round>
RANGE: <range>
PROBLEMS: <n>
REASON: <reason>
VERDICT-FILE: <file>
}
}
message REVIEW-FAIL {
body: {
STATUS: <FAIL>
REF: <ref>
ROUND: <round>
RANGE: <range>
PROBLEMS: <n>
REASON: <reason>
VERDICT-FILE: <file>
}
}
message REVIEW-ERROR {
body: {
STATUS: <ERROR>
REF: <ref>
ROUND: <round>
RANGE: <range>
PROBLEMS: <n>
REASON: <reason>
VERDICT-FILE: <file>
}
}
*/
EOF
for n in planner coder reviewer; do "$CH" --setup "$C/config.diag" "$n" >/dev/null; done
export FAKE_DIR=$T

# What a run-* wrapper passes: the node, the hook, the channel, the agent program and, for
# the coder, the project's done tag, retry effort, failure log dir and review wait.
COMMON=(-l "$ROOT/dispatch/hooks/direct" -c "$CH" --agent-bin "$T/fake")
CODER=(-N coder --done-tag builds --retry-effort xhigh --failure-log-dir "$T/failure-logs" --review-timeout 4)
start() {  # start NAME ROLE: one dispatcher in watch mode, log in $T/NAME.log
  local -a extra=(-N "$1"); [[ "$2" == executor ]] && extra=("${CODER[@]}")
  ( cd "$W" && exec "$D" -d "$C/config.diag" -r "$2" "${COMMON[@]}" "${extra[@]}" ) >>"$T/$1.log" 2>&1 &
  PIDS+=("$!"); eval "PID_$1=$!"
}
stop_role() { local v="PID_$1"; kill "${!v}" 2>/dev/null || :; wait "${!v}" 2>/dev/null || :; }
implement() { "$CH" --send "$C/config.diag" planner coder IMPLEMENT -m "ACTION: IMPLEMENT" -m "PLAN: $T/plan.md" -m "FROM-STEP: the beginning" >/dev/null; }
# wait_reply VERB SECS: wait for a VERB message in the planner inbox, print its path
wait_reply() {
  local i f
  for ((i = 0; i < $2 * 5; i++)); do
    f=$(grep -ls "^VERB: $1\$" "$C/nodes/planner/inbox"/*.md | head -1 || :)
    [[ -n "$f" ]] && { printf '%s\n' "$f"; return 0; }
    sleep 0.2
  done
  return 1
}
reset_case() { rm -f "$C/nodes/planner/inbox/"*.md "$T/agent.log" "$T/reviews" "$T/execs"; : >"$T/coder.log"; : >"$T/reviewer.log"; }
count() { local n; n=$(grep -c "$1" "$2" 2>/dev/null) || :; echo "${n:-0}"; }

# 0. -p (no message) dry run with a channel review: settings and the REVIEW it would send
out=$(cd "$W" && "$D" -n -d "$C/config.diag" -r executor -p "$T/plan.md" "${COMMON[@]}" "${CODER[@]}" 2>&1) && rc=0 || rc=$?
check "-p dry run: review node and verbs from the diag" '[[ $rc == 0 ]] && grep -q "mode=channel node=reviewer" <<<"$out" && grep -q "would wait for the reply with REF" <<<"$out"'

start reviewer reviewer; start coder executor; sleep 1

check "no project card: the dispatcher's generic card" 'grep -q "rules=$ROOT/dispatch/roles/executor.md" <<<"$out"'
mkdir -p "$W/roles"; printf '# Role: executor (project)\n' >"$W/roles/executor.md"
out=$(cd "$W" && "$D" -n -d "$C/config.diag" -r executor -p "$T/plan.md" "${COMMON[@]}" "${CODER[@]}" 2>&1) || :
rm -rf "$W/roles"
check "roles/executor.md at the worktree root is the card (as run-grok-* use roles/<role>.md)" 'grep -q "rules=$W/roles/executor.md" <<<"$out"'
echo "x=1" >"$C/config.diag.dispatch"
out=$(cd "$W" && "$D" -n -d "$C/config.diag" -r executor -p "$T/plan.md" "${COMMON[@]}" "${CODER[@]}" 2>&1) || :; rm -f "$C/config.diag.dispatch"
check "an old DIAG.dispatch file is ignored with a warning" 'grep -q "config.diag.dispatch is ignored" <<<"$out"'
out=$(cd "$W" && "$D" -n -d "$C/config.diag" -r executor -p "$T/plan.md" -s x 2>&1) && rc=0 || rc=$?
check "-s/--sidecar is gone" '[[ $rc == 2 ]]'

# 1. FAIL -> fix -> PASS over the channel, PING queued during the wait
reset_case; printf 'FAIL 3\nSLEEP 2\n' >"$T/reviews"
implement
sleep 1.2
( "$CH" --send "$C/config.diag" planner coder PING --timeout 30 >"$T/ping.out" 2>&1; echo $? >"$T/ping.rc" ) &
sleep 0.6
check "PING sent during the review wait stays queued in the coder inbox" 'grep -lqs "^VERB: PING" "$C/nodes/coder/inbox"/*.md && ! grep -q "MESSAGE .*verb=PING" "$T/coder.log"'
f=$(wait_reply COMPLETE 30 || :)
check "fail-fix-pass: planner gets COMPLETE" '[[ -n "$f" ]]'
J=$(ls -td "$C"/dispatch/coder/*-IMPLEMENT* | head -1)
check "fail-fix-pass: passes on review cycle 2 after one fix session" 'grep -q "REVIEW CYCLE 1 of 3: FAIL, 3 problems" "$T/coder.log" && grep -q "exec fix" "$T/agent.log" && grep -q "RESULT complete .*passed review cycle 2" "$T/coder.log"'
check "fail-fix-pass: full review saved and given to the fix session" 'grep -q "^3. a.txt: finding 3 of 3" "$J/review-1.md" && grep -qx "Read the rules. Fix the issues in $J/review-1.md (review 1 of 3 of .* against $T/plan.md)." "$J/r2-executor/prompt.txt"'
check "reviewer reply carries PROBLEMS" 'grep -qs "^PROBLEMS: 3" "$C"/dispatch/reviewer/*/reply.txt'
check "fail-fix-pass: two reviews ran in the reviewer process" '[[ $(count "^review" "$T/agent.log") == 2 ]] && [[ $(count "MESSAGE .* action=REVIEW" "$T/reviewer.log") == 2 ]]'
check "fail-fix-pass: verdicts went to the coder, not the planner" '! grep -qs "^VERB: REVIEW-" "$C/nodes/planner/inbox"/*.md && [[ $(count "REPLY REVIEW-" "$T/coder.log") == 2 ]]'
for i in $(seq 50); do [[ -s "$T/ping.rc" ]] && break; sleep 0.2; done
check "queued PING handled after the job and answered" '[[ "$(cat "$T/ping.rc" 2>/dev/null)" == 0 ]] && [[ $(grep -n "MESSAGE .*verb=PING" "$T/coder.log" | cut -d: -f1) -gt $(grep -n "SEND COMPLETE" "$T/coder.log" | cut -d: -f1) ]]'

# 2. session not done -> one retry prompt with retry effort
reset_case; printf 'FAILURE\nSUCCESS\n' >"$T/execs"; printf 'PASS\n' >"$T/reviews"
implement; f=$(wait_reply COMPLETE 30 || :)
check "not-done session: COMPLETE after a retry" '[[ -n "$f" ]]'
check "not-done session: retry prompt at retry_effort" 'grep -q "exec retry effort=xhigh SUCCESS" "$T/agent.log" && grep -q "NOT DONE round 1" "$T/coder.log"'
reset_case; printf 'FAILURE\nFAILURE\n' >"$T/execs"
implement; f=$(wait_reply FAILURE 30 || :)
check "not-done twice: FAILURE after the one retry, no review" '[[ -n "$f" ]] && grep -q "ended not done twice" "$f" && [[ $(count "^exec" "$T/agent.log") == 2 ]] && [[ $(count "^review" "$T/agent.log") == 0 ]]'

# 3. STOP during the wait
reset_case; printf 'SLEEP 3\n' >"$T/reviews"
implement; sleep 1.5
"$CH" --send "$C/config.diag" planner coder STOP -m "ACTION: STOP" -m "PLAN: $T/plan.md" >/dev/null
f=$(wait_reply STOPPED 20 || :)
check "STOP during the review wait: STOPPED to the planner" '[[ -n "$f" ]] && grep -q "STOP from planner while waiting" "$f"'
check "STOP during the review wait: the STOP is consumed" '! grep -lq "^VERB: STOP" "$C/nodes/coder/inbox"/* 2>/dev/null'
sleep 3; check "late reply after STOP is dropped as stale" 'grep -q "stale review reply" "$T/coder.log"'

# 4. timeout: no reviewer process; one fresh retry, then FAILURE
stop_role reviewer
reset_case
implement; f=$(wait_reply FAILURE 30 || :)
check "review timeout: FAILURE after one retry" '[[ -n "$f" ]] && grep -q "gave no verdict twice" "$f" && [[ $(count "no reply from reviewer within 4s" "$T/coder.log") -ge 2 ]]'
check "review timeout: no cycle counted, requests retracted" '! grep -q "REVIEW CYCLE" "$T/coder.log" && [[ -z "$(ls -A "$C/nodes/reviewer/inbox" | grep -v claimed)" ]]'
start reviewer reviewer; sleep 1

# 5. a FAIL without a PROBLEMS line is no verdict: one fresh review
reset_case; printf 'FAILNOCOUNT\nPASS\n' >"$T/reviews"
implement; f=$(wait_reply COMPLETE 30 || :)
check "FAIL without PROBLEMS: retried as no verdict, then PASS" '[[ -n "$f" ]] && grep -q "without a .PROBLEMS: N. line" "$T/coder.log" && [[ $(count "^exec" "$T/agent.log") == 1 ]]'

# 6. decreasing problems: 3 -> 2 -> PASS on cycle 3
reset_case; printf 'FAIL 3\nFAIL 2\nPASS\n' >"$T/reviews"
implement; f=$(wait_reply COMPLETE 40 || :)
check "decreasing problems: COMPLETE on review cycle 3" '[[ -n "$f" ]] && grep -q "RESULT complete .*passed review cycle 3" "$T/coder.log" && [[ $(count "^exec fix" "$T/agent.log") == 2 ]]'

# 7. increasing problems on cycle 2 go back to the planner with the history
reset_case; printf 'FAIL 2\nFAIL 4\n' >"$T/reviews"
h0=$(git -C "$W" rev-parse HEAD)
implement; f=$(wait_reply FAILURE 40 || :)
J=$(ls -td "$C"/dispatch/coder/*-IMPLEMENT* | head -1)
check "more problems on cycle 2: FAILURE, re-plan needed" '[[ -n "$f" ]] && grep -q "^STATUS: FAILURE" "$f" && grep -q "review cycle 2 found 4 problems, not fewer than the 2 before; re-plan needed" "$f" && [[ $(count "^exec" "$T/agent.log") == 2 ]]'
check "more problems: reply points at the history with both full reviews" 'grep -q "review history $J/review-history.md" "$f" && grep -q "^2. a.txt: finding 2 of 2" "$J/review-history.md" && grep -q "^4. a.txt: finding 4 of 4" "$J/review-history.md" && ls "$T/failure-logs"/*-reviews.md >/dev/null'
check "more problems: commits kept, no reset" '[[ $(git -C "$W" rev-list --count "$h0..HEAD") == 2 ]] && [[ "$(git -C "$W" rev-parse builds)" == "$(git -C "$W" rev-parse HEAD)" ]]'

# 7b. the same count on cycle 2 also goes back to the planner
reset_case; printf 'FAIL 2\nFAIL 2\n' >"$T/reviews"
implement; f=$(wait_reply FAILURE 40 || :)
check "same problems on cycle 2: FAILURE, re-plan needed" '[[ -n "$f" ]] && grep -q "review cycle 2 found 2 problems, not fewer than the 2 before; re-plan needed" "$f" && [[ $(count "^exec" "$T/agent.log") == 2 ]]'

# 8. three FAILs with falling counts: back to the planner after cycle 3; nothing reset
reset_case; printf 'FAIL 3\nFAIL 2\nFAIL 1\n' >"$T/reviews"
h0=$(git -C "$W" rev-parse HEAD)
implement; f=$(wait_reply FAILURE 40 || :)
J=$(ls -td "$C"/dispatch/coder/*-IMPLEMENT* | head -1)
check "3 cycles exhausted: FAILURE after cycle 3" '[[ -n "$f" ]] && grep -q "review cycle 3 of 3 still fails with 1 problems; re-plan needed" "$f" && [[ $(count "^exec" "$T/agent.log") == 3 ]] && [[ $(count "^review" "$T/agent.log") == 3 ]]'
check "3 cycles exhausted: three reviews saved" '[[ -f "$J/review-1.md" && -f "$J/review-2.md" && -f "$J/review-3.md" ]]'
check "no reset past builds: all commits kept, builds still on HEAD, no saved refs" '[[ $(git -C "$W" rev-list --count "$h0..HEAD") == 3 ]] && git -C "$W" merge-base --is-ancestor "$h0" builds && [[ "$(git -C "$W" rev-parse builds)" == "$(git -C "$W" rev-parse HEAD)" ]] && [[ -z "$(git -C "$W" for-each-ref refs/dispatch)" ]]'
check "prompts are one line; the role card forbids resets past builds" '[[ $(wc -l <"$J/r1-executor/prompt.txt") == 1 ]] && grep -qx "Read the rules. Implement $T/plan.md." "$J/r1-executor/prompt.txt" && grep -q "never reset or check out past the .builds. tag" "$ROOT/dispatch/roles/executor.md"'

printf '%s\n' "dispatch: $pass passed, $fail failed"
[[ $fail -eq 0 ]]
