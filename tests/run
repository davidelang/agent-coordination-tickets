# --- arm oldest-only, each program reading the other's files ---

arm_oldest() {
  label=$1
  armbin=$2
  out=$TMP/arm-$label.out
  err=$TMP/arm-$label.err
  : > "$out"
  : > "$err"
  pid=$(spawn "$out" "$err" env CHANNEL_POLL=1 "$armbin" "$PLAN" planner)
  if wait_for "$out" "READY"; then ok "$label arm ready"; else bad "$label arm ready"; return; fi
  if grep -F -q 'channel-arm is listing the inbox every 0.2s. inotifywait is not in use.' "$err"; then
    ok "$label poll note"
  else
    bad "$label poll note"
  fi
  if wait_for "$out" "FILE "; then ok "$label saw oldest"; else bad "$label saw oldest"; return; fi
  first=$(sed -n 's/^FILE //p' "$out" | head -n 1)
  older=$(printf '%s\n%s\n' "$(basename "$q1")" "$(basename "$q2")" | sort | head -n 1)
  if [ "$(basename "$first")" = "$older" ]; then ok "$label oldest name"; else bad "$label oldest name"; fi
  sleep 0.6
  nfiles=$(grep -c '^FILE ' "$out" || true)
  if [ "$nfiles" = 1 ]; then ok "$label holds oldest"; else bad "$label holds oldest ($nfiles)"; fi
  rm -- "$first"
  n=0
  nfiles=1
  while [ "$n" -lt 80 ]; do
    nfiles=$(grep -c '^FILE ' "$out" || true)
    if [ "$nfiles" = 2 ]; then
      break
    fi
    n=$((n + 1))
    sleep 0.1
  done
  if [ "$nfiles" = 2 ]; then ok "$label advances after rm"; else bad "$label advances after rm ($nfiles)"; fi
  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

# files q1 and q2 are still in the planner inbox
arm_oldest shell "$ROOT/bin/channel-arm"
# restart reprints the file that remains
left=$(find "$PIN" -name '*.md' | head -n 1)
pid=$(spawn "$TMP/arm-re.out" "$TMP/arm-re.err" env CHANNEL_POLL=1 "$ROOT/go/channel-arm" "$PLAN" planner)
if wait_for "$TMP/arm-re.out" "FILE $left"; then ok "restart reprints remaining file"; else bad "restart reprints remaining file"; fi
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
rm -f -- "$PIN"/*.md

# shell arm, go send, then the reverse direction's wait is already covered.
# inotify path: READY plus a FILE, without requiring the poll note.
pid=$(spawn "$TMP/arm-in.out" "$TMP/arm-in.err" "$ROOT/go/channel-arm" "$PLAN" coder)
if wait_for "$TMP/arm-in.out" "READY"; then ok "inotify arm ready"; else bad "inotify arm ready"; fi
"$ROOT/bin/channel-send" "$PLAN" planner coder PING "$TMP/bodies/ping.md" > "$TMP/in-send.out"
sent=$(sed -n 's/^SENT //p' "$TMP/in-send.out")
if wait_for "$TMP/arm-in.out" "FILE $sent"; then ok "go arm sees shell send"; else bad "go arm sees shell send"; fi
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true

pid=$(spawn "$TMP/arm-in2.out" "$TMP/arm-in2.err" env CHANNEL_POLL=1 "$ROOT/bin/channel-arm" "$PLAN" planner)
if wait_for "$TMP/arm-in2.out" "READY"; then ok "shell arm ready for go note"; else bad "shell arm ready for go note"; fi
"$ROOT/go/channel-send" "$PLAN" coder planner NOTE "$TMP/bodies/note.md" > "$TMP/in-send2.out"
sent2=$(sed -n 's/^SENT //p' "$TMP/in-send2.out")
if wait_for "$TMP/arm-in2.out" "FILE $sent2"; then ok "shell arm sees go send"; else bad "shell arm sees go send"; fi
kill -9 "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true

# shell waits on a file go already published (the PING still in the coder inbox)
pid=$(spawn "$TMP/pend.out" "$TMP/pend.err" env CHANNEL_POLL=1 "$ROOT/bin/channel-send" "$PLAN" planner coder PING "$TMP/bodies/ping.md")
if wait_for "$TMP/pend.out" "PENDING $sent"; then ok "shell waits on go-visible file"; else bad "shell waits on go-visible file"; fi
rm -- "$sent"
if wait_for "$TMP/pend.out" "SENT "; then ok "shell sends after the go file is removed"; else bad "shell sends after the go file is removed"; kill "$pid" 2>/dev/null || true; fi
wait "$pid" 2>/dev/null || true

# --- cross-device rename ---

EP=$TMP/exdev.diag
ep_in=$TMP/exdev-nodes/planner/inbox
ec_in=$SHM/coder/inbox
cat > "$EP" <<EOF
blockdiag {
  planner -> coder;
}
/*
node planner $ep_in
node coder $ec_in
verb planner coder PING
message PING { body: { ACTION: PING } }
*/
EOF
"$ROOT/bin/channel-setup" "$EP" planner >/dev/null
"$ROOT/go/channel-setup" "$EP" coder >/dev/null
capture "$TMP/sh-ex" "$TMP/sh-ex.err" "$TMP/sh-ex.rc" "$ROOT/bin/channel-send" "$EP" planner coder PING "$TMP/bodies/ping-bad.md"
# ping-bad is the wrong shape (missing PLAN). Use a legal one-line body for this message.
printf '%s\n' 'ACTION: PING' > "$TMP/bodies/ping-one.md"
capture "$TMP/sh-ex" "$TMP/sh-ex.err" "$TMP/sh-ex.rc" "$ROOT/bin/channel-send" "$EP" planner coder PING "$TMP/bodies/ping-one.md"
capture "$TMP/go-ex" "$TMP/go-ex.err" "$TMP/go-ex.rc" "$ROOT/go/channel-send" "$EP" planner coder PING "$TMP/bodies/ping-one.md"
if grep -F -q 'would not be atomic' "$TMP/sh-ex.err" && grep -F -q 'would not be atomic' "$TMP/go-ex.err"; then
  ok "cross-device rename is refused"
else
  bad "cross-device rename is refused"
  cat "$TMP/sh-ex.err" "$TMP/go-ex.err" >&2
fi
expect_rc "shell exdev exit" 1 "$TMP/sh-ex.rc"
expect_rc "go exdev exit" 1 "$TMP/go-ex.rc"
if [ "$(file_count '*.md' "$ec_in")" = 0 ]; then ok "exdev published nothing"; else bad "exdev published nothing"; fi

# --- webhooks (shell, go and python must match) ---
WH=$TMP/wh
mkdir -p "$WH/plan"
python3 -c '
import http.server,sys
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(s):
        b=s.rfile.read(int(s.headers["Content-Length"]))
        open(sys.argv[1],"a").write(s.path+" "+str(s.headers.get("Authorization"))+" "+str(s.headers.get("Content-Type"))+" "+b.decode()+"\n")
        n=sum(1 for l in open(sys.argv[1]) if l.split(" ",1)[0]==s.path)
        code=500 if "fail" in s.path else (503 if "flaky" in s.path and n<2 else (400 if "limit" in s.path and n<2 else (401 if "auth" in s.path else 200)))
        s.send_response(code); s.end_headers()
        s.wfile.write(b"{\"success\":false,\"error\":\"Automation run rate limit exceeded\"}" if code==400 else b"{\"success\":true}")
    def log_message(s,*a): pass
h=http.server.HTTPServer(("127.0.0.1",0),H); open(sys.argv[2],"w").write(str(h.server_port)); h.serve_forever()' "$WH/got" "$WH/port" &
echo $! >> "$PIDS"
i=0; while [ ! -s "$WH/port" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
WP=$(cat "$WH/port")
printf 'Authorization: Bearer relkey\n' > "$WH/plan/rel.key"
printf 'abskey\n' > "$WH/abs.key"
printf 'ACTION: GO\n' > "$WH/body"
for impl in sh go py; do
  case $impl in
    sh) run() { "$SH" "$@"; } ;;
    go) run() { "$GO" "$@"; } ;;
    py) run() { m=${1#--}; shift; python3 "$PY" "$m" "$@"; } ;;
  esac
  D=$WH/plan/$impl.diag
  N=$WH/n-$impl
  cat > "$D" <<DIAG
blockdiag {
  a -< b;
  a -< r;
  a -< s;
  a -< i;
  a -< f;
  a -< x;
  a -< g;
  a -< l;
  a -< u;
  a -< k;
}
/*
node a $N/a/inbox
node b $N/b/inbox
node r $N/r/inbox webhook=http://127.0.0.1:$WP/$impl-r webhook_key_file=rel.key
node s $N/s/inbox webhook=http://127.0.0.1:$WP/$impl-s webhook_key_file=$WH/abs.key
node i $N/i/inbox webhook=http://127.0.0.1:$WP/$impl-i webhook_key=Bearer\ inl
node f $N/f/inbox webhook=http://127.0.0.1:$WP/$impl-fail webhook_key=k webhook_retries=0
node g $N/g/inbox webhook=http://127.0.0.1:$WP/$impl-flaky webhook_retries=2 webhook_backoff_max=1s
node x $N/x/inbox webhook=http://127.0.0.1:$WP/$impl-x webhook_key_file=missing.key
node l $N/l/inbox webhook=http://127.0.0.1:$WP/$impl-limit webhook_retries=2 webhook_backoff_max=1s
node u $N/u/inbox webhook=http://127.0.0.1:$WP/$impl-auth webhook_retries=2 webhook_backoff_max=1s
node k $N/k/inbox webhook=http://127.0.0.1:$WP/$impl-killlimit webhook_retries=2 webhook_backoff_max=2s
verb a b GO
verb a r GO
verb a s GO
verb a i GO
verb a f GO
verb a x GO
verb a g GO
verb a l GO
verb a u GO
verb a k GO
message GO {
Go.
body: {
ACTION: GO
}
}
*/
DIAG
  sed -i 's/webhook_key=Bearer\\ inl/webhook_key=Bearer+inl/' "$D"
  for n in a b r s i f x g l u k; do (cd "$WH" && run --setup "plan/$impl.diag" $n >/dev/null 2>&1); done
  for n in b r s i f x g l u; do
    (cd "$WH" && run --send "plan/$impl.diag" a $n GO body >"$WH/$impl-$n.out" 2>"$WH/$impl-$n.err"); echo $? > "$WH/$impl-$n.rc"
  done
  for n in b r s i f x; do
    if [ "$(cat "$WH/$impl-$n.rc")" = 0 ] && [ "$(file_count '*.md' "$N/$n/inbox")" = 1 ]; then ok "$impl webhook $n send queued"; else bad "$impl webhook $n send queued"; fi
  done
  if ! grep -q WEBHOOK "$WH/$impl-b.out" && [ ! -s "$WH/$impl-b.err" ]; then ok "$impl no-webhook node silent"; else bad "$impl no-webhook node silent"; fi
  if grep -q '^WARNING: webhook for g failed (503).*retrying in the background' "$WH/$impl-g.err"; then ok "$impl webhook retry goes to the background"; else bad "$impl webhook retry background: $(cat "$WH/$impl-g.err")"; fi
  i=0; while [ "$(grep -c "^/$impl-flaky " "$WH/got")" -lt 2 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-flaky " "$WH/got")" = 2 ]; then ok "$impl background retry delivered"; else bad "$impl background retry delivered"; fi
  if grep -q '^WARNING: webhook for l failed (400).*rate limit exceeded.*retrying in the background' "$WH/$impl-l.err"; then ok "$impl rate-limit 400 goes to the background"; else bad "$impl rate-limit 400 background: $(cat "$WH/$impl-l.err")"; fi
  i=0; while [ "$(grep -c "^/$impl-limit " "$WH/got")" -lt 2 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-limit " "$WH/got")" = 2 ]; then ok "$impl rate-limit 400 retried and delivered"; else bad "$impl rate-limit 400 retried"; fi
  if grep -q '^WARNING: webhook for u failed (401)' "$WH/$impl-u.err" && ! grep -q retrying "$WH/$impl-u.err"; then ok "$impl 401 not retried"; else bad "$impl 401 not retried: $(cat "$WH/$impl-u.err")"; fi
  # The retry job must outlive the sender's process group (an agent tool killing its command).
  case $impl in sh) kc="$SH --send" ;; go) kc="$GO --send" ;; py) kc="python3 $PY send" ;; esac
  (cd "$WH" && setsid sh -c 'echo $$ > "$2"; $1 plan/'$impl'.diag a k GO body 2>"$3"; sleep 30' sh "$kc" "$WH/$impl-k.pg" "$WH/$impl-k.err" >/dev/null) &
  i=0; while ! grep -q 'retrying in the background' "$WH/$impl-k.err" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  kill -9 "-$(cat "$WH/$impl-k.pg")"
  i=0; while [ "$(grep -c "^/$impl-killlimit " "$WH/got")" -lt 2 ] && [ $i -lt 60 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-killlimit " "$WH/got")" = 2 ]; then ok "$impl retry job outlives the sender's process group"; else bad "$impl retry job killed with the sender: $(cat "$WH/$impl-k.err")"; fi
  if grep -q "^/$impl-r Bearer relkey application/json {\"target\":\"r\",\"from\":\"a\",\"verb\":\"GO\",\"inbox\":\"$N/r/inbox\",\"file\":\"$N/r/inbox/" "$WH/got"; then ok "$impl relative key file from diag dir, header stripped"; else bad "$impl relative key file"; fi
  if grep -q "^/$impl-s Bearer abskey " "$WH/got"; then ok "$impl absolute key file"; else bad "$impl absolute key file"; fi
  if grep -q "^/$impl-i Bearer Bearer+inl " "$WH/got"; then ok "$impl inline key"; else bad "$impl inline key"; fi
  if grep -q '^WEBHOOK r 200' "$WH/$impl-r.out"; then ok "$impl WEBHOOK line"; else bad "$impl WEBHOOK line"; fi
  if grep -q '^WARNING: webhook for f failed (500)' "$WH/$impl-f.err"; then ok "$impl 500 warns"; else bad "$impl 500 warns"; fi
  if grep -q "^WARNING: webhook for x not fired: cannot read webhook_key_file $WH/plan/missing.key" "$WH/$impl-x.err"; then ok "$impl missing relative key file warns with resolved path"; else bad "$impl missing key warn: $(cat "$WH/$impl-x.err")"; fi
  if ! grep -q "^/$impl-x " "$WH/got"; then ok "$impl missing key not posted"; else bad "$impl missing key not posted"; fi
  sed 's/webhook_key=k/webhook_key=k webhook_key_file=z/' "$D" > "$WH/bad.diag"
  if run --send "$WH/bad.diag" a b GO "$WH/body" 2>&1 | grep -q 'use webhook_key_file or webhook_key, not both'; then ok "$impl both keys rejected"; else bad "$impl both keys rejected"; fi
  sed 's|webhook=http://127.0.0.1:[0-9]*/'$impl'-x |bogus=1 |' "$D" > "$WH/bad.diag"
  if run --send "$WH/bad.diag" a b GO "$WH/body" 2>&1 | grep -q 'unknown node option bogus'; then ok "$impl unknown option rejected"; else bad "$impl unknown option rejected"; fi
done

# --- body sources, built-in PING/PONG, channel-ping, channel-status, lock-free seq, logging ---
X=$TMP/x
mkdir -p "$X"
cat > "$X/x.diag" <<EOF
blockdiag {
  a <-> b;
  a -< c;
}
/*
node a $X/nodes/a/inbox
node b $X/nodes/b/inbox
node c $X/nodes/c/inbox
verb a b NOTE
verb b a NOTE
verb a c NOTE
message NOTE {
A note.
body: {
NOTE: <text>
}
}
*/
EOF
for n in a b c; do "$ROOT/go/channel-setup" "$X/x.diag" $n >/dev/null; done
export CHANNEL_SYSLOG=0 CHANNEL_LOG_FILE="$X/log.txt"
for impl in go sh py; do
  case $impl in
    go) S() { "$ROOT/go/channel-send" "$@"; }; PG() { "$ROOT/go/channel-ping" "$@"; }; ST() { "$ROOT/go/channel-status" "$@"; }; ARM="$ROOT/go/channel-arm" ;;
    sh) S() { "$ROOT/bin/channel-send" "$@"; }; PG() { "$ROOT/bin/channel-ping" "$@"; }; ST() { "$ROOT/bin/channel-status" "$@"; }; ARM="$ROOT/bin/channel-arm" ;;
    py) S() { python3 "$PY" send "$@"; }; PG() { python3 "$PY" ping "$@"; }; ST() { python3 "$PY" status "$@"; }; ARM="python3 $PY arm" ;;
  esac
  rm -f "$X"/nodes/*/inbox/*.md
  S "$X/x.diag" a c NOTE -m 'NOTE: one' -m 'second block' /etc/hostname /etc/hostname > "$X/$impl-m.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-m.out")
  if [ -n "$f" ] && grep -q '^second block$' "$f" && [ "$(grep -c '^- refs/' "$f")" = 2 ]; then ok "$impl -m blocks and two refs"; else bad "$impl -m blocks and two refs"; fi
  printf 'NOTE: from stdin\n' | S "$X/x.diag" a c NOTE > "$X/$impl-in.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-in.out")
  if [ -n "$f" ] && grep -q '^NOTE: from stdin$' "$f"; then ok "$impl body from stdin"; else bad "$impl body from stdin"; fi
  printf 'NOTE: dash\n' | S "$X/x.diag" a c NOTE - /etc/hostname > "$X/$impl-d.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-d.out")
  if [ -n "$f" ] && grep -q '^NOTE: dash$' "$f" && grep -q '^- refs/' "$f"; then ok "$impl body from - with ref"; else bad "$impl body from - with ref"; fi
  if S "$X/x.diag" a c PING -m 'NONCE: n1' >/dev/null 2>&1; then ok "$impl built-in PING on any arrow"; else bad "$impl built-in PING on any arrow"; fi
  if ! S "$X/x.diag" a c PING -m 'hello' >/dev/null 2>&1; then ok "$impl PING needs NONCE"; else bad "$impl PING needs NONCE"; fi
  rm -f "$X"/nodes/*/inbox/*.md
  S "$X/x.diag" a b PING -m 'NONCE: w1' >/dev/null 2>&1
  S "$X/x.diag" a b PING -m 'NONCE: w2' > "$X/$impl-nw" 2>&1 &
  pw=$!
  sleep 3
  if kill -0 "$pw" 2>/dev/null; then kill "$pw" 2>/dev/null || true; bad "$impl PING never waits"; else ok "$impl PING never waits"; fi
  wait "$pw" 2>/dev/null || true
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/*/checkall.stamp
  timeout 15 $ARM "$X/x.diag" b > "$X/$impl-armb" 2>&1 &
  pb=$!
  timeout 15 $ARM "$X/x.diag" c > "$X/$impl-armc" 2>&1 &
  pc=$!
  timeout 15 $ARM "$X/x.diag" a > "$X/$impl-arma" 2>&1 &
  pa=$!
  sleep 1
  rc=0; PG "$X/x.diag" a --timeout 10 > "$X/$impl-ping" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG b ' "$X/$impl-ping" && grep -q '^CONSUMED c ' "$X/$impl-ping"; then ok "$impl channel-ping two-way and one-way"; else bad "$impl channel-ping: $(cat "$X/$impl-ping")"; fi
  if [ "$(cat "$X/$impl-armb")" = READY ] && [ "$(cat "$X/$impl-armc")" = READY ]; then ok "$impl arm hides PING/PONG"; else bad "$impl arm hides PING/PONG: $(cat "$X/$impl-armb" "$X/$impl-armc")"; fi
  rc=0; PG "$X/x.diag" a --timeout 10 > "$X/$impl-again" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG b ' "$X/$impl-again"; then ok "$impl explicit ping is never rate-limited"; else bad "$impl explicit ping again: $(cat "$X/$impl-again")"; fi
  rm -f "$X"/nodes/*/checkall-runs "$X"/nodes/*/checkall.stamp
  : > "$X/log.txt"
  rc=0; PG "$X/x.diag" a --all --timeout 10 > "$X/$impl-all" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^CHECKALL a run ' "$X/$impl-all" && grep -q '^PONG b ' "$X/$impl-all"; then ok "$impl check-all from origin"; else bad "$impl check-all: $(cat "$X/$impl-all")"; fi
  i=0; while ! grep -q "event=checkall result=start node=b " "$X/log.txt" && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=checkall result=start node=b " "$X/log.txt"; then ok "$impl check-all propagates to b"; else bad "$impl check-all propagates to b"; fi
  i=0; while ! grep -q "event=checkall result=skip node=a run=a-.* why=\"run already handled\"" "$X/log.txt" && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=checkall result=skip node=a run=a-.* why=\"run already handled\"" "$X/log.txt"; then ok "$impl check-all wave back to origin stops"; else bad "$impl check-all wave back to origin stops"; fi
  i=0; while ! grep -q "event=ping result=ok from=b to=a kind=pong .*run=a-" "$X/log.txt" && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=ping result=ok from=b to=a kind=pong .*run=a-" "$X/log.txt"; then ok "$impl propagated node logs its own results"; else bad "$impl propagated node logs its own results"; fi
  run2=$impl-second-run
  rc=0; PG "$X/x.diag" b --run "$run2" > "$X/$impl-rl" 2>&1 || rc=$?
  if grep -q '^SKIP b ran a check-all' "$X/$impl-rl"; then ok "$impl check-all rate limit stops re-propagation"; else bad "$impl check-all rate limit: $(cat "$X/$impl-rl")"; fi
  for pp in $pb $pc $pa; do pkill -9 -P "$pp" 2>/dev/null || true; kill -9 "$pp" 2>/dev/null || true; done
  pkill -9 -f "arm $X/x.diag" 2>/dev/null || true
  wait "$pb" "$pc" "$pa" 2>/dev/null || true
  pkill -9 -f "ping.*$X/x.diag" 2>/dev/null || true
  sleep 0.5
  rm -f "$X"/nodes/*/inbox/*.md
  rc=0; PG "$X/x.diag" a --timeout 1 > "$X/$impl-to" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q '^TIMEOUT b (no PONG' "$X/$impl-to" && grep -q '^TIMEOUT c (PING not consumed' "$X/$impl-to"; then ok "$impl ping timeout"; else bad "$impl ping timeout"; fi
  rm -f "$X"/nodes/*/inbox/*.md
  mkdir -p "$X/nodes/b/inbox/claimed"
  : > "$X/nodes/b/inbox/claimed/m.md"
  echo bot > "$X/nodes/b/inbox/claimed/m.md.owner"
  chmod 000 "$X/nodes/c/inbox"
  ST "$X/x.diag" > "$X/$impl-st" 2>&1
  chmod 2775 "$X/nodes/c/inbox"
  if grep -q "^node b .* messages 0 claimed 1$" "$X/$impl-st" && grep -q '^  claimed m.md [0-9]*s owner=bot$' "$X/$impl-st" && grep -q "^node c .* no permission$" "$X/$impl-st"; then ok "$impl channel-status"; else bad "$impl channel-status: $(cat "$X/$impl-st")"; fi
  rm -rf "$X/nodes/b/inbox/claimed"
done
if [ ! -e "$X/nodes/a/out-seq.lock" ] && [ -d "$X/nodes/a/out-seq.d" ]; then ok "seq uses out-seq.d, no lock file"; else bad "seq uses out-seq.d, no lock file"; fi
rm -f "$X"/nodes/*/inbox/*.md
timeout 5 "$ROOT/go/channel-arm" "$X/x.diag" b > "$X/arm-deliver" 2>&1 &
pd=$!
sleep 0.5
"$ROOT/go/channel-send" "$X/x.diag" a b NOTE -m 'NOTE: d' >/dev/null 2>&1
sleep 0.5
rm -f "$X"/nodes/b/inbox/*.md
sleep 0.5
kill "$pd" 2>/dev/null || true
wait "$pd" 2>/dev/null || true
if grep -q '^FILE ' "$X/arm-deliver"; then ok "arm shows a real message"; else bad "arm shows a real message"; fi
for e in send ping ping-answered deliver consumed; do
  if grep -q " agent-channel event=$e " "$X/log.txt"; then ok "log has event=$e"; else bad "log has event=$e"; fi
done
unset CHANNEL_LOG_FILE

# No fallbacks: one watch per node, inotifywait required unless CHANNEL_POLL=1, bad env values fail.
NOINO=$TMP/noino-bin
mkdir -p "$NOINO"
for f in /usr/bin/* /bin/*; do
  b=$(basename "$f")
  [ "$b" = inotifywait ] || [ -e "$NOINO/$b" ] || [ -L "$NOINO/$b" ] || ln -s "$f" "$NOINO/$b"
done
for impl in go sh py; do
  case $impl in
    go) A="$ROOT/go/channel-arm"; P="$ROOT/go/channel-ping" ;;
    sh) A="$ROOT/bin/channel-arm"; P="$ROOT/bin/channel-ping" ;;
    py) A="python3 $PY arm"; P="python3 $PY ping" ;;
  esac
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/c/arm.pid
  $A "$X/x.diag" c > "$X/$impl-dup1" 2>&1 &
  p1=$!
  wait_for "$X/$impl-dup1" READY || true
  rc=0; timeout 5 $A "$X/x.diag" c > "$X/$impl-dup2" 2>&1 || rc=$?
  if [ "$rc" = 3 ] && grep -q "^ALREADY-WATCHING c pid $p1 " "$X/$impl-dup2"; then ok "$impl second watch on a node is refused"; else bad "$impl second watch on a node is refused (rc=$rc)"; fi
  kill -9 "$p1" 2>/dev/null || true
  wait "$p1" 2>/dev/null || true
  printf '%s %s\n' "$$" "$(hostname)" > "$X/nodes/c/arm.pid"
  $A "$X/x.diag" c > "$X/$impl-dup3" 2>&1 &
  p1=$!
  if wait_for "$X/$impl-dup3" READY; then ok "$impl stale arm.pid (pid not an arm) does not block"; else bad "$impl stale arm.pid (pid not an arm) does not block"; fi
  kill -9 "$p1" 2>/dev/null || true
  wait "$p1" 2>/dev/null || true
  rm -f "$X/nodes/c/arm.pid"
  rc=0; PATH=$NOINO timeout 5 $A "$X/x.diag" c > "$X/$impl-noino" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'inotifywait not found' "$X/$impl-noino" && ! grep -q '^READY' "$X/$impl-noino"; then ok "$impl arm without inotifywait fails loudly"; else bad "$impl arm without inotifywait fails loudly (rc=$rc)"; fi
  rm -f "$X/nodes/c/arm.pid"
  rc=0; CHANNEL_PING_TIMEOUT=abc $P "$X/x.diag" c > "$X/$impl-badenv" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'must be a whole number' "$X/$impl-badenv"; then ok "$impl bad env number fails"; else bad "$impl bad env number fails (rc=$rc)"; fi
done

# Plans that define PING/PONG message blocks (ACTION lines): built-in replies follow the
# block; a reply the tool cannot build is reported, shown as FILE, and the watch keeps going.
Y=$TMP/y
mkdir -p "$Y"
cat > "$Y/y.diag" <<EOF
blockdiag {
  p <-> q;
  p -< r;
  q <-> r;
  s <-> t;
}
/*
node p $Y/nodes/p/inbox
node q $Y/nodes/q/inbox
node r $Y/nodes/r/inbox
node s $Y/nodes/s/inbox
node t $Y/nodes/t/inbox
verb p q NOTE
verb q p NOTE
verb p r NOTE
verb q r NOTE
verb r q NOTE
verb s t NOTE
verb t s NOTE
message NOTE {
A note.
body: {
NOTE: <text>
}
}
message PING {
Connectivity test. Reply PONG with the same NONCE.
body: {
ACTION: PING
NONCE: <unique id>
}
}
message PONG {
Answer to PING.
body: {
ACTION: PONG
NONCE: <same nonce as the PING>
}
}
*/
EOF
# z: same nodes, but its PONG block asks for a value the tool cannot fill.
sed -e 's/^NONCE: <same nonce as the PING>$/NONCE: <same nonce as the PING>\nWHEN: <time of reply>/' "$Y/y.diag" > "$Y/z.diag"
for n in p q r s t; do "$ROOT/go/channel-setup" "$Y/y.diag" $n >/dev/null; done
export CHANNEL_LOG_FILE="$Y/log.txt"
for impl in go sh py; do
  case $impl in
    go) A="$ROOT/go/channel-arm"; P="$ROOT/go/channel-ping"; SN="$ROOT/go/channel-send" ;;
    sh) A="$ROOT/bin/channel-arm"; P="$ROOT/bin/channel-ping"; SN="$ROOT/bin/channel-send" ;;
    py) A="python3 $PY arm"; P="python3 $PY ping"; SN="python3 $PY send" ;;
  esac
  rm -f "$Y"/nodes/*/inbox/*.md "$Y"/nodes/*/arm.pid "$Y"/nodes/*/checkall-runs "$Y"/nodes/*/checkall.stamp
  : > "$Y/log.txt"
  $A "$Y/y.diag" q > "$Y/$impl-aq" 2> "$Y/$impl-aq.err" &
  pq=$!
  $A "$Y/y.diag" r > "$Y/$impl-ar" 2> "$Y/$impl-ar.err" &
  pr=$!
  $A "$Y/y.diag" p > "$Y/$impl-ap" 2> "$Y/$impl-ap.err" &
  pp=$!
  wait_for "$Y/$impl-aq" READY || true; wait_for "$Y/$impl-ar" READY || true; wait_for "$Y/$impl-ap" READY || true
  rc=0; $P --timeout 10 "$Y/y.diag" p > "$Y/$impl-pg" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG q ' "$Y/$impl-pg" && grep -q '^CONSUMED r ' "$Y/$impl-pg"; then ok "$impl ping with ACTION blocks: auto-PONG validates"; else bad "$impl ping with ACTION blocks: auto-PONG validates (rc=$rc)"; fi
  if ! grep -q 'event=auto-reply' "$Y/log.txt" && kill -0 "$pq" 2>/dev/null; then ok "$impl ACTION-block watch keeps running, no reply failure"; else bad "$impl ACTION-block watch keeps running, no reply failure"; fi
  rc=0; $P --all --timeout 10 "$Y/y.diag" p > "$Y/$impl-pga" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^CHECKALL p run ' "$Y/$impl-pga" && grep -q '^PONG q ' "$Y/$impl-pga"; then ok "$impl check-all with ACTION blocks"; else bad "$impl check-all with ACTION blocks (rc=$rc)"; fi
  n=0; while [ "$n" -lt 50 ] && ! grep -q 'event=ping result=ok from=q to=r kind=pong' "$Y/log.txt"; do sleep 0.2; n=$((n + 1)); done
  if grep -q 'event=checkall result=start node=q' "$Y/log.txt" && grep -q 'event=ping result=ok from=q to=r kind=pong' "$Y/log.txt"; then ok "$impl check-all propagates with ACTION blocks"; else bad "$impl check-all propagates with ACTION blocks"; fi
  if grep -q 'CHANNEL-' "$Y/$impl-aq.err" "$Y/$impl-ar.err" "$Y/$impl-ap.err"; then bad "$impl no control errors with ACTION blocks"; else ok "$impl no control errors with ACTION blocks"; fi
  for x in $pq $pr $pp; do kill -9 "$x" 2>/dev/null || true; done
  wait "$pq" "$pr" "$pp" 2>/dev/null || true
  pkill -9 -f "$Y/y.diag" 2>/dev/null || true
  sleep 0.3
  # forced reply failure (z.diag): warning, PING shown as FILE, watch keeps running
  $A "$Y/z.diag" t > "$Y/$impl-at" 2> "$Y/$impl-at.err" &
  pt=$!
  wait_for "$Y/$impl-at" READY || true
  $SN "$Y/z.diag" s t PING -m 'ACTION: PING' -m "NONCE: $impl-forced" > "$Y/$impl-zs" 2>&1
  zf=$(sed -n 's/^SENT //p' "$Y/$impl-zs")
  if [ -n "$zf" ] && wait_for "$Y/$impl-at" "FILE $zf"; then ok "$impl failed auto-reply shows the PING as FILE"; else bad "$impl failed auto-reply shows the PING as FILE"; fi
  if grep -q 'CHANNEL-AUTO-REPLY-FAILED' "$Y/$impl-at.err" && grep -q 'CHANNEL-CONTROL-BODY' "$Y/$impl-at.err" && grep -q 'event=auto-reply result=fail node=t from=s' "$Y/log.txt"; then ok "$impl failed auto-reply warns on stderr and in the log"; else bad "$impl failed auto-reply warns on stderr and in the log"; fi
  sleep 0.6
  if [ -f "$zf" ] && kill -0 "$pt" 2>/dev/null; then ok "$impl watch survives a failed auto-reply"; else bad "$impl watch survives a failed auto-reply"; fi
  if [ "$(grep -c "^FILE $zf" "$Y/$impl-at")" = 1 ] && [ "$(grep -c CHANNEL-AUTO-REPLY-FAILED "$Y/$impl-at.err")" = 1 ]; then ok "$impl failed PING reported and announced once"; else bad "$impl failed PING reported and announced once"; fi
  rm -f "$zf"
  $SN "$Y/z.diag" s t NOTE -m 'NOTE: after' > "$Y/$impl-zn" 2>&1
  zn=$(sed -n 's/^SENT //p' "$Y/$impl-zn")
  if [ -n "$zn" ] && wait_for "$Y/$impl-at" "FILE $zn"; then ok "$impl watch goes on after the hand-handled PING"; else bad "$impl watch goes on after the hand-handled PING"; fi
  apid=; read -r apid _ < "$Y/nodes/t/arm.pid" || true
  if [ "$apid" = "$pt" ]; then ok "$impl arm.pid still names the running watch"; else bad "$impl arm.pid still names the running watch ($apid vs $pt)"; fi
  kill -9 "$pt" 2>/dev/null || true
  wait "$pt" 2>/dev/null || true
  pkill -9 -f "$Y/z.diag" 2>/dev/null || true
  rm -f "$Y"/nodes/*/inbox/*.md
  sed -e 's/^ACTION: PING$/ACTION: PING\nWHO: <sender name>/' "$Y/y.diag" > "$Y/w.diag"
  rc=0; $P --timeout 2 "$Y/w.diag" p > "$Y/$impl-wpg" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'CHANNEL-CONTROL-BODY: the PING message block' "$Y/$impl-wpg" && ! ls "$Y"/nodes/q/inbox/*.md >/dev/null 2>&1; then ok "$impl unfillable PING block fails loudly, nothing sent"; else bad "$impl unfillable PING block fails loudly, nothing sent (rc=$rc)"; fi
  rm -f "$Y"/nodes/*/inbox/*.md
done
unset CHANNEL_LOG_FILE

printf '%s\n' "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
