# --- arm oldest-only, each program reading the other's files ---

arm_oldest() {
  label=$1
  armbin=$2
  out=$TMP/arm-$label.out
  err=$TMP/arm-$label.err
  : > "$out"
  : > "$err"
  pid=$(spawn "$out" "$err" env CHANNEL_POLL=1 "$armbin" "$PLAN" planner)
  if wait_for "$out" "READY"; then ok "$label arm ready"; else bad "$label arm ready"; return; fi
  if grep -F -q 'channel-arm is listing the inbox every 0.2s. inotifywait is not in use.' "$err"; then
    ok "$label poll note"
  else
    bad "$label poll note"
  fi
  if wait_for "$out" "FILE "; then ok "$label saw oldest"; else bad "$label saw oldest"; return; fi
  first=$(sed -n 's/^FILE //p' "$out" | head -n 1)
  older=$(printf '%s\n%s\n' "$(basename "$q1")" "$(basename "$q2")" | sort | head -n 1)
  if [ "$(basename "$first")" = "$older" ]; then ok "$label oldest name"; else bad "$label oldest name"; fi
  sleep 0.6
  nfiles=$(grep -c '^FILE ' "$out" || true)
  if [ "$nfiles" = 1 ]; then ok "$label holds oldest"; else bad "$label holds oldest ($nfiles)"; fi
  rm -- "$first"
  n=0
  nfiles=1
  while [ "$n" -lt 80 ]; do
    nfiles=$(grep -c '^FILE ' "$out" || true)
    if [ "$nfiles" = 2 ]; then
      break
    fi
    n=$((n + 1))
    sleep 0.1
  done
  if [ "$nfiles" = 2 ]; then ok "$label advances after rm"; else bad "$label advances after rm ($nfiles)"; fi
  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

# files q1 and q2 are still in the planner inbox
arm_oldest shell "$ROOT/bin/channel-arm"
# restart reprints the file that remains
left=$(find "$PIN" -name '*.md' | head -n 1)
pid=$(spawn "$TMP/arm-re.out" "$TMP/arm-re.err" env CHANNEL_POLL=1 "$ROOT/go/channel-arm" "$PLAN" planner)
if wait_for "$TMP/arm-re.out" "FILE $left"; then ok "restart reprints remaining file"; else bad "restart reprints remaining file"; fi
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
rm -f -- "$PIN"/*.md

# shell arm, go send, then the reverse direction's wait is already covered.
# inotify path: READY plus a FILE, without requiring the poll note.
pid=$(spawn "$TMP/arm-in.out" "$TMP/arm-in.err" "$ROOT/go/channel-arm" "$PLAN" coder)
if wait_for "$TMP/arm-in.out" "READY"; then ok "inotify arm ready"; else bad "inotify arm ready"; fi
"$ROOT/bin/channel-send" "$PLAN" planner coder TASK "$TMP/bodies/ping.md" > "$TMP/in-send.out"
sent=$(sed -n 's/^SENT //p' "$TMP/in-send.out")
if wait_for "$TMP/arm-in.out" "FILE $sent"; then ok "go arm sees shell send"; else bad "go arm sees shell send"; fi
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true

pid=$(spawn "$TMP/arm-in2.out" "$TMP/arm-in2.err" env CHANNEL_POLL=1 "$ROOT/bin/channel-arm" "$PLAN" planner)
if wait_for "$TMP/arm-in2.out" "READY"; then ok "shell arm ready for go note"; else bad "shell arm ready for go note"; fi
"$ROOT/go/channel-send" "$PLAN" coder planner NOTE "$TMP/bodies/note.md" > "$TMP/in-send2.out"
sent2=$(sed -n 's/^SENT //p' "$TMP/in-send2.out")
if wait_for "$TMP/arm-in2.out" "FILE $sent2"; then ok "shell arm sees go send"; else bad "shell arm sees go send"; fi
kill -9 "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true

# shell waits on a file go already published (the TASK still in the coder inbox)
pid=$(spawn "$TMP/pend.out" "$TMP/pend.err" env CHANNEL_POLL=1 "$ROOT/bin/channel-send" "$PLAN" planner coder TASK "$TMP/bodies/ping.md")
if wait_for "$TMP/pend.out" "PENDING $sent"; then ok "shell waits on go-visible file"; else bad "shell waits on go-visible file"; fi
rm -- "$sent"
if wait_for "$TMP/pend.out" "SENT "; then ok "shell sends after the go file is removed"; else bad "shell sends after the go file is removed"; kill "$pid" 2>/dev/null || true; fi
wait "$pid" 2>/dev/null || true

# --- webhooks (shell, go and python must match) ---
WH=$TMP/wh
mkdir -p "$WH/plan"
python3 -c '
import http.server,sys
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(s):
        b=s.rfile.read(int(s.headers["Content-Length"]))
        open(sys.argv[1],"a").write(s.path+" "+str(s.headers.get("Authorization"))+" "+str(s.headers.get("Content-Type"))+" "+b.decode()+"\n")
        n=sum(1 for l in open(sys.argv[1]) if l.split(" ",1)[0]==s.path)
        code=500 if "fail" in s.path else (503 if "flaky" in s.path and n<2 else (400 if "limit" in s.path and n<2 else (401 if "auth" in s.path else 200)))
        s.send_response(code); s.end_headers()
        s.wfile.write(b"{\"success\":false,\"error\":\"Automation run rate limit exceeded\"}" if code==400 else b"{\"success\":true}")
    def log_message(s,*a): pass
h=http.server.HTTPServer(("127.0.0.1",0),H); open(sys.argv[2],"w").write(str(h.server_port)); h.serve_forever()' "$WH/got" "$WH/port" &
echo $! >> "$PIDS"
i=0; while [ ! -s "$WH/port" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
WP=$(cat "$WH/port")
printf 'Authorization: Bearer relkey\n' > "$WH/plan/rel.key"
printf 'abskey\n' > "$WH/abs.key"
printf 'ACTION: GO\n' > "$WH/body"
for impl in sh go py; do
  case $impl in
    sh) run() { "$SH" "$@"; } ;;
    go) run() { "$GO" "$@"; } ;;
    py) run() { m=${1#--}; shift; python3 "$PY" "$m" "$@"; } ;;
  esac
  D=$WH/plan/$impl.diag
  N=$WH/n-$impl
  cat > "$D" <<DIAG
blockdiag {
  a -< b;
  a -< r;
  a -< s;
  a -< i;
  a -< f;
  a -< x;
  a -< g;
  a -< l;
  a -< u;
  a -< k;
}
/*
node a $N/a/inbox
node b $N/b/inbox
node r $N/r/inbox webhook=http://127.0.0.1:$WP/$impl-r webhook_key_file=rel.key
node s $N/s/inbox webhook=http://127.0.0.1:$WP/$impl-s webhook_key_file=$WH/abs.key
node i $N/i/inbox webhook=http://127.0.0.1:$WP/$impl-i webhook_key=Bearer\ inl
node f $N/f/inbox webhook=http://127.0.0.1:$WP/$impl-fail webhook_key=k webhook_retries=0
node g $N/g/inbox webhook=http://127.0.0.1:$WP/$impl-flaky webhook_retries=2 webhook_backoff_max=1s
node x $N/x/inbox webhook=http://127.0.0.1:$WP/$impl-x webhook_key_file=missing.key
node l $N/l/inbox webhook=http://127.0.0.1:$WP/$impl-limit webhook_retries=2 webhook_backoff_max=1s
node u $N/u/inbox webhook=http://127.0.0.1:$WP/$impl-auth webhook_retries=2 webhook_backoff_max=1s
node k $N/k/inbox webhook=http://127.0.0.1:$WP/$impl-killlimit webhook_retries=2 webhook_backoff_max=2s
verb a b GO
verb a r GO
verb a s GO
verb a i GO
verb a f GO
verb a x GO
verb a g GO
verb a l GO
verb a u GO
verb a k GO
message GO {
Go.
body: {
ACTION: GO
}
}
*/
DIAG
  sed -i 's/webhook_key=Bearer\\ inl/webhook_key=Bearer+inl/' "$D"
  for n in a b r s i f x g l u k; do (cd "$WH" && run --setup "plan/$impl.diag" $n >/dev/null 2>&1); done
  for n in b r s i f x g l u; do
    (cd "$WH" && run --send "plan/$impl.diag" a $n GO body >"$WH/$impl-$n.out" 2>"$WH/$impl-$n.err"); echo $? > "$WH/$impl-$n.rc"
  done
  for n in b r s i f x; do
    if [ "$(cat "$WH/$impl-$n.rc")" = 0 ] && [ "$(file_count '*.md' "$N/$n/inbox")" = 1 ]; then ok "$impl webhook $n send queued"; else bad "$impl webhook $n send queued"; fi
  done
  if ! grep -q WEBHOOK "$WH/$impl-b.out" && [ ! -s "$WH/$impl-b.err" ]; then ok "$impl no-webhook node silent"; else bad "$impl no-webhook node silent"; fi
  if grep -q '^WARNING: webhook for g failed (503).*retrying in the background' "$WH/$impl-g.err"; then ok "$impl webhook retry goes to the background"; else bad "$impl webhook retry background: $(cat "$WH/$impl-g.err")"; fi
  i=0; while [ "$(grep -c "^/$impl-flaky " "$WH/got")" -lt 2 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-flaky " "$WH/got")" = 2 ]; then ok "$impl background retry delivered"; else bad "$impl background retry delivered"; fi
  if grep -q '^WARNING: webhook for l failed (400).*rate limit exceeded.*retrying in the background' "$WH/$impl-l.err"; then ok "$impl rate-limit 400 goes to the background"; else bad "$impl rate-limit 400 background: $(cat "$WH/$impl-l.err")"; fi
  i=0; while [ "$(grep -c "^/$impl-limit " "$WH/got")" -lt 2 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-limit " "$WH/got")" = 2 ]; then ok "$impl rate-limit 400 retried and delivered"; else bad "$impl rate-limit 400 retried"; fi
  if grep -q '^WARNING: webhook for u failed (401)' "$WH/$impl-u.err" && ! grep -q retrying "$WH/$impl-u.err"; then ok "$impl 401 not retried"; else bad "$impl 401 not retried: $(cat "$WH/$impl-u.err")"; fi
  # The retry job must outlive the sender's process group (an agent tool killing its command).
  case $impl in sh) kc="$SH --send" ;; go) kc="$GO --send" ;; py) kc="python3 $PY send" ;; esac
  (cd "$WH" && setsid sh -c 'echo $$ > "$2"; $1 plan/'$impl'.diag a k GO body 2>"$3"; sleep 30' sh "$kc" "$WH/$impl-k.pg" "$WH/$impl-k.err" >/dev/null) &
  i=0; while ! grep -q 'retrying in the background' "$WH/$impl-k.err" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  kill -9 "-$(cat "$WH/$impl-k.pg")"
  i=0; while [ "$(grep -c "^/$impl-killlimit " "$WH/got")" -lt 2 ] && [ $i -lt 60 ]; do sleep 0.1; i=$((i + 1)); done
  if [ "$(grep -c "^/$impl-killlimit " "$WH/got")" = 2 ]; then ok "$impl retry job outlives the sender's process group"; else bad "$impl retry job killed with the sender: $(cat "$WH/$impl-k.err")"; fi
  if grep -q "^/$impl-r Bearer relkey application/json {\"target\":\"r\",\"from\":\"a\",\"verb\":\"GO\",\"inbox\":\"$N/r/inbox\",\"file\":\"$N/r/inbox/" "$WH/got"; then ok "$impl relative key file from diag dir, header stripped"; else bad "$impl relative key file"; fi
  if grep -q "^/$impl-s Bearer abskey " "$WH/got"; then ok "$impl absolute key file"; else bad "$impl absolute key file"; fi
  if grep -q "^/$impl-i Bearer Bearer+inl " "$WH/got"; then ok "$impl inline key"; else bad "$impl inline key"; fi
  if grep -q '^WEBHOOK r 200' "$WH/$impl-r.out"; then ok "$impl WEBHOOK line"; else bad "$impl WEBHOOK line"; fi
  if grep -q '^WARNING: webhook for f failed (500)' "$WH/$impl-f.err"; then ok "$impl 500 warns"; else bad "$impl 500 warns"; fi
  if grep -q "^WARNING: webhook for x not fired: cannot read webhook_key_file $WH/plan/missing.key" "$WH/$impl-x.err"; then ok "$impl missing relative key file warns with resolved path"; else bad "$impl missing key warn: $(cat "$WH/$impl-x.err")"; fi
  if ! grep -q "^/$impl-x " "$WH/got"; then ok "$impl missing key not posted"; else bad "$impl missing key not posted"; fi
  sed 's/webhook_key=k/webhook_key=k webhook_key_file=z/' "$D" > "$WH/bad.diag"
  if run --send "$WH/bad.diag" a b GO "$WH/body" 2>&1 | grep -q 'use webhook_key_file or webhook_key, not both'; then ok "$impl both keys rejected"; else bad "$impl both keys rejected"; fi
  sed 's|webhook=http://127.0.0.1:[0-9]*/'$impl'-x |bogus=1 |' "$D" > "$WH/bad.diag"
  if run --send "$WH/bad.diag" a b GO "$WH/body" 2>&1 | grep -q 'unknown node option bogus'; then ok "$impl unknown option rejected"; else bad "$impl unknown option rejected"; fi
done

# fake_agent LOG PLAN NODE: what an agent does with its watch. Each FILE wakes it; a PING is
# answered with PONG through channel-send (nothing answers for it), a check-all PING also
# starts channel-ping --run in the background, and every file is removed when handled.
# Uses $ARM, $SEND and $PINGC (command strings of one implementation).
# sets rc to the exit code of background job $1 (killed after 10 s)
wait_exit() { n=0; while kill -0 "$1" 2>/dev/null && [ "$n" -lt 100 ]; do sleep 0.1; n=$((n + 1)); done; kill -9 "$1" 2>/dev/null || true; rc=0; wait "$1" 2>/dev/null || rc=$?; }
# put_ping INBOX FROM TO NONCE: place a PING file by hand (as the sending tool would), print its path
PUTSEQ=9000
put_ping() {
  PUTSEQ=$((PUTSEQ + 1))
  pf="$1/$(date +%Y%m%d-%H%M%S).000__$2__$PUTSEQ.md"
  printf '%s\n' "FROM: $2" "TO: $3" "SEQ: $PUTSEQ" 'VERB: PING' 'REFS:' '- none' '---' 'ACTION: PING' "NONCE: $4" > "$1/.put.tmp" && mv "$1/.put.tmp" "$pf"
  printf '%s\n' "$pf"
}

fake_agent() {
  $ARM "$2" "$3" 2>"$1.err" | while read -r tag fpath; do
    [ "$tag" = FILE ] || continue
    fv=$(sed -n 's/^VERB: //p' "$fpath" | head -1)
    ff=$(sed -n 's/^FROM: //p' "$fpath" | head -1)
    fn=$(sed -n '/^---$/,$ s/^NONCE: //p' "$fpath" | head -1)
    if [ "$fv" = PING ]; then
      $SEND "$2" "$3" "$ff" PONG -m 'ACTION: PONG' -m "NONCE: $fn" >/dev/null 2>>"$1.err" || true
      fs=$(sed -n '/^---$/,$ s/^SCOPE: //p' "$fpath" | head -1)
      fr=$(sed -n '/^---$/,$ s/^RUN: //p' "$fpath" | head -1)
      if [ "$fs" = all ]; then $PINGC --run "$fr" "$2" "$3" >/dev/null 2>&1 & fi
    fi
    echo "HANDLED $fv $ff" >> "$1"
    rm -f -- "$fpath"
  done
}

# --- body sources, built-in PING/PONG, channel-ping, channel-status, lock-free seq, logging ---
X=$TMP/x
mkdir -p "$X"
cat > "$X/x.diag" <<EOF
blockdiag {
  a <-> b;
  a -< c;
}
/*
node a $X/nodes/a/inbox
node b $X/nodes/b/inbox
node c $X/nodes/c/inbox
verb a b NOTE
verb b a NOTE
verb a c NOTE
message NOTE {
A note.
body: {
NOTE: <text>
}
}
*/
EOF
for n in a b c; do "$ROOT/go/channel-setup" "$X/x.diag" $n >/dev/null; done
export CHANNEL_SYSLOG=0 CHANNEL_LOG_FILE="$X/log.txt"
for impl in go sh py; do
  case $impl in
    go) S() { "$ROOT/go/channel-send" "$@"; }; PG() { "$ROOT/go/channel-ping" "$@"; }; ST() { "$ROOT/go/channel-status" "$@"; }; ARM="$ROOT/go/channel-arm" ;;
    sh) S() { "$ROOT/bin/channel-send" "$@"; }; PG() { "$ROOT/bin/channel-ping" "$@"; }; ST() { "$ROOT/bin/channel-status" "$@"; }; ARM="$ROOT/bin/channel-arm" ;;
    py) S() { python3 "$PY" send "$@"; }; PG() { python3 "$PY" ping "$@"; }; ST() { python3 "$PY" status "$@"; }; ARM="python3 $PY arm" ;;
  esac
  rm -f "$X"/nodes/*/inbox/*.md
  S "$X/x.diag" a c NOTE -m 'NOTE: one' -m 'second block' /etc/hostname /etc/hostname > "$X/$impl-m.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-m.out")
  if [ -n "$f" ] && grep -q '^second block$' "$f" && [ "$(grep -c '^- refs/' "$f")" = 2 ]; then ok "$impl -m blocks and two refs"; else bad "$impl -m blocks and two refs"; fi
  printf 'NOTE: from stdin\n' | S "$X/x.diag" a c NOTE > "$X/$impl-in.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-in.out")
  if [ -n "$f" ] && grep -q '^NOTE: from stdin$' "$f"; then ok "$impl body from stdin"; else bad "$impl body from stdin"; fi
  printf 'NOTE: dash\n' | S "$X/x.diag" a c NOTE - /etc/hostname > "$X/$impl-d.out" 2>&1
  f=$(sed -n 's/^SENT //p' "$X/$impl-d.out")
  if [ -n "$f" ] && grep -q '^NOTE: dash$' "$f" && grep -q '^- refs/' "$f"; then ok "$impl body from - with ref"; else bad "$impl body from - with ref"; fi
  # channel-send ... PING is channel-ping to that one DEST: with an arrow back it waits only
  # for the PONG (PONG / TIMEOUT); with no arrow back it prints NO-RETURN at once (exit 0)
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/*/pong-*
  rc=0; S --timeout 2 "$X/x.diag" a b PING -m 'NONCE: n1' > "$X/$impl-sp1" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q '^TIMEOUT b (no PONG after 2s: the b agent was not woken or did not answer)$' "$X/$impl-sp1" && ! grep -q '^TIMEOUT c\|^NO-RETURN' "$X/$impl-sp1"; then ok "$impl channel-send PING = channel-ping to DEST only (TIMEOUT)"; else bad "$impl channel-send PING timeout: $(cat "$X/$impl-sp1")"; fi
  if grep -q 'event=ping result=timeout from=a to=b nonce=n1' "$X/log.txt"; then ok "$impl channel-send PING keeps the given NONCE"; else bad "$impl channel-send PING nonce"; fi
  rm -f "$X"/nodes/*/inbox/*.md
  rc=0; S "$X/x.diag" a c PING > "$X/$impl-sp2" 2>&1 < /dev/null || rc=$?
  if [ "$rc" = 0 ] && [ "$(tail -n 1 "$X/$impl-sp2")" = "NO-RETURN c (the PING is delivered; c has no arrow back to a, so no PONG is possible)" ] && ls "$X"/nodes/c/inbox/*__a__*.md >/dev/null 2>&1 && ! grep -q CONSUMED "$X/$impl-sp2"; then ok "$impl channel-send PING with no return path: NO-RETURN, PING left delivered"; else bad "$impl channel-send PING no return (rc=$rc): $(cat "$X/$impl-sp2")"; fi
  rm -f "$X"/nodes/*/inbox/*.md
  rc=0; S --timeout 2 "$X/x.diag" a c PING -m 'NONCE: n2' -m 'HELLO: there' > "$X/$impl-sp3" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q "CHANNEL-SEND-PING: a PING body may only hold NONCE: <value> and lines of the plan's PING block" "$X/$impl-sp3" && ! ls "$X"/nodes/c/inbox/*.md >/dev/null 2>&1; then ok "$impl channel-send PING refuses other body lines, sends nothing"; else bad "$impl PING body lines (rc=$rc): $(cat "$X/$impl-sp3")"; fi
  # PONG only answers a PING from DEST that is still in this node's inbox or claimed/
  rc=0; S "$X/x.diag" a b PONG -m 'NONCE: p1' > "$X/$impl-po1" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'CHANNEL-SEND-PONG: no PING from b with NONCE p1' "$X/$impl-po1"; then ok "$impl unsolicited PONG is refused"; else bad "$impl unsolicited PONG (rc=$rc): $(cat "$X/$impl-po1")"; fi
  put_ping "$X/nodes/a/inbox" b a p1 >/dev/null
  PUTSEQ=$((PUTSEQ + 1)); pc=$(put_ping "$X/nodes/a/inbox" b a p2)
  mkdir -p "$X/nodes/a/inbox/claimed"; mv "$pc" "$X/nodes/a/inbox/claimed/"
  rc=0; S "$X/x.diag" a b PONG -m 'NONCE: p1' > "$X/$impl-po2" 2>&1 || rc=$?
  rc2=0; S "$X/x.diag" a b PONG -m 'NONCE: p2' > "$X/$impl-po3" 2>&1 || rc2=$?
  if [ "$rc" = 0 ] && [ "$rc2" = 0 ] && grep -q '^SENT ' "$X/$impl-po2" && grep -q '^SENT ' "$X/$impl-po3"; then ok "$impl PONG answering a PING in the inbox / claimed is sent, never waits"; else bad "$impl PONG answer: $rc $(cat "$X/$impl-po2") / $rc2 $(cat "$X/$impl-po3")"; fi
  rc=0; S "$X/x.diag" a c PONG -m 'NONCE: p1' > "$X/$impl-po4" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'CHANNEL-SEND-PONG: no PING from c' "$X/$impl-po4"; then ok "$impl PONG to a node that did not send that PING is refused"; else bad "$impl PONG wrong sender (rc=$rc)"; fi
  rm -rf "$X"/nodes/a/inbox/claimed
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/*/checkall.stamp
  # a watch alone never answers a PING: it shows it as FILE and leaves it there
  rm -f "$X"/nodes/*/arm.pid
  timeout 15 $ARM "$X/x.diag" b > "$X/$impl-armb" 2>&1 &
  pb=$!
  sleep 1
  rc=0; PG "$X/x.diag" a --timeout 2 > "$X/$impl-noag" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q '^TIMEOUT b (no PONG after 2s: the b agent was not woken or did not answer)$' "$X/$impl-noag"; then ok "$impl watch does not answer PING; ping fails loudly"; else bad "$impl watch does not answer PING: $(cat "$X/$impl-noag")"; fi
  if grep -q '^FILE .*__a__' "$X/$impl-armb" && ls "$X"/nodes/b/inbox/*__a__*.md >/dev/null 2>&1; then ok "$impl PING is delivered as FILE"; else bad "$impl PING is delivered as FILE: $(cat "$X/$impl-armb")"; fi
  pkill -9 -f "arm $X/x.diag" 2>/dev/null || true
  kill -9 "$pb" 2>/dev/null || true; wait "$pb" 2>/dev/null || true
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/*/arm.pid
  ARM=$ARM; case $impl in go) SEND="$ROOT/go/channel-send"; PINGC="$ROOT/go/channel-ping" ;; sh) SEND="$ROOT/bin/channel-send"; PINGC="$ROOT/bin/channel-ping" ;; py) SEND="python3 $PY send"; PINGC="python3 $PY ping" ;; esac
  : > "$X/$impl-agb"; : > "$X/$impl-agc"; : > "$X/$impl-aga"
  fake_agent "$X/$impl-agb" "$X/x.diag" b &
  pb=$!
  fake_agent "$X/$impl-agc" "$X/x.diag" c &
  pc=$!
  fake_agent "$X/$impl-aga" "$X/x.diag" a &
  pa=$!
  sleep 1
  rc=0; PG "$X/x.diag" a --timeout 10 > "$X/$impl-ping" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG b ' "$X/$impl-ping" && grep -q '^NO-RETURN c ' "$X/$impl-ping" && ! grep -q CONSUMED "$X/$impl-ping"; then ok "$impl channel-ping two-way (PONG) and one-way (NO-RETURN)"; else bad "$impl channel-ping: $(cat "$X/$impl-ping")"; fi
  if grep -q '^HANDLED PING a$' "$X/$impl-agb" && grep -q '^HANDLED PING a$' "$X/$impl-agc" && ! grep -q PONG "$X/$impl-aga"; then ok "$impl agent is woken by PING; PONG is not shown"; else bad "$impl agent woken by PING: $(cat "$X/$impl-agb" "$X/$impl-agc" "$X/$impl-aga")"; fi
  rc=0; PG "$X/x.diag" a --timeout 10 > "$X/$impl-again" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG b ' "$X/$impl-again"; then ok "$impl explicit ping is never rate-limited"; else bad "$impl explicit ping again: $(cat "$X/$impl-again")"; fi
  rm -f "$X"/nodes/*/checkall-runs "$X"/nodes/*/checkall.stamp
  : > "$X/log.txt"
  rc=0; PG "$X/x.diag" a --all --timeout 10 > "$X/$impl-all" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^CHECKALL a run ' "$X/$impl-all" && grep -q '^PONG b ' "$X/$impl-all"; then ok "$impl check-all from origin"; else bad "$impl check-all: $(cat "$X/$impl-all")"; fi
  i=0; while ! grep -q "event=checkall result=start node=b " "$X/log.txt" && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=checkall result=start node=b " "$X/log.txt"; then ok "$impl check-all propagates to b"; else bad "$impl check-all propagates to b"; fi
  i=0; while ! grep -q "event=checkall result=skip node=a run=a-.* why=\"run already handled\"" "$X/log.txt" && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=checkall result=skip node=a run=a-.* why=\"run already handled\"" "$X/log.txt"; then ok "$impl check-all wave back to origin stops"; else bad "$impl check-all wave back to origin stops"; fi
  i=0; while ! grep -q "event=ping result=ok from=b to=a kind=pong .*run=a-" "$X/log.txt" && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  if grep -q "event=ping result=ok from=b to=a kind=pong .*run=a-" "$X/log.txt"; then ok "$impl propagated node logs its own results"; else bad "$impl propagated node logs its own results"; fi
  run2=$impl-second-run
  rc=0; PG "$X/x.diag" b --run "$run2" > "$X/$impl-rl" 2>&1 || rc=$?
  if grep -q '^SKIP b ran a check-all' "$X/$impl-rl"; then ok "$impl check-all rate limit stops re-propagation"; else bad "$impl check-all rate limit: $(cat "$X/$impl-rl")"; fi
  for pp in $pb $pc $pa; do pkill -9 -P "$pp" 2>/dev/null || true; kill -9 "$pp" 2>/dev/null || true; done
  pkill -9 -f "arm $X/x.diag" 2>/dev/null || true
  wait "$pb" "$pc" "$pa" 2>/dev/null || true
  pkill -9 -f "ping.*$X/x.diag" 2>/dev/null || true
  sleep 0.5
  rm -f "$X"/nodes/*/inbox/*.md
  rc=0; PG "$X/x.diag" a --timeout 1 > "$X/$impl-to" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q '^TIMEOUT b (no PONG after 1s: the b agent was not woken or did not answer)$' "$X/$impl-to" && grep -q '^NO-RETURN c ' "$X/$impl-to"; then ok "$impl ping timeout (two-way) and NO-RETURN (one-way)"; else bad "$impl ping timeout: $(cat "$X/$impl-to")"; fi
  rm -f "$X"/nodes/*/inbox/*.md
  mkdir -p "$X/nodes/b/inbox/claimed"
  : > "$X/nodes/b/inbox/claimed/m.md"
  echo bot > "$X/nodes/b/inbox/claimed/m.md.owner"
  chmod 000 "$X/nodes/c/inbox"
  ST "$X/x.diag" > "$X/$impl-st" 2>&1
  chmod 2775 "$X/nodes/c/inbox"
  if grep -q "^node b .* messages 0 claimed 1$" "$X/$impl-st" && grep -q '^  claimed m.md [0-9]*s owner=bot$' "$X/$impl-st" && grep -q "^node c .* no permission$" "$X/$impl-st"; then ok "$impl channel-status"; else bad "$impl channel-status: $(cat "$X/$impl-st")"; fi
  rm -rf "$X/nodes/b/inbox/claimed"
done
if [ ! -e "$X/nodes/a/out-seq.lock" ] && [ -d "$X/nodes/a/out-seq.d" ]; then ok "seq uses out-seq.d, no lock file"; else bad "seq uses out-seq.d, no lock file"; fi
rm -f "$X"/nodes/*/inbox/*.md
timeout 5 "$ROOT/go/channel-arm" "$X/x.diag" b > "$X/arm-deliver" 2>&1 &
pd=$!
sleep 0.5
"$ROOT/go/channel-send" "$X/x.diag" a b NOTE -m 'NOTE: d' >/dev/null 2>&1
sleep 0.5
rm -f "$X"/nodes/b/inbox/*.md
sleep 0.5
kill "$pd" 2>/dev/null || true
wait "$pd" 2>/dev/null || true
if grep -q '^FILE ' "$X/arm-deliver"; then ok "arm shows a real message"; else bad "arm shows a real message"; fi
for e in send ping pong-received deliver consumed; do
  if grep -q " agent-channel event=$e " "$X/log.txt"; then ok "log has event=$e"; else bad "log has event=$e"; fi
done
unset CHANNEL_LOG_FILE

# No fallbacks: one watch per node, inotifywait required unless CHANNEL_POLL=1, bad env values fail.
NOINO=$TMP/noino-bin
mkdir -p "$NOINO"
for f in /usr/bin/* /bin/*; do
  b=$(basename "$f")
  [ "$b" = inotifywait ] || [ -e "$NOINO/$b" ] || [ -L "$NOINO/$b" ] || ln -s "$f" "$NOINO/$b"
done
for impl in go sh py; do
  case $impl in
    go) A="$ROOT/go/channel-arm"; P="$ROOT/go/channel-ping" ;;
    sh) A="$ROOT/bin/channel-arm"; P="$ROOT/bin/channel-ping" ;;
    py) A="python3 $PY arm"; P="python3 $PY ping" ;;
  esac
  rm -f "$X"/nodes/*/inbox/*.md "$X"/nodes/c/arm.pid
  $A "$X/x.diag" c > "$X/$impl-dup1" 2>&1 &
  p1=$!
  wait_for "$X/$impl-dup1" READY || true
  rc=0; timeout 5 $A "$X/x.diag" c > "$X/$impl-dup2" 2>&1 || rc=$?
  if [ "$rc" = 3 ] && grep -q "^ALREADY-WATCHING c pid $p1 " "$X/$impl-dup2"; then ok "$impl second watch on a node is refused"; else bad "$impl second watch on a node is refused (rc=$rc)"; fi
  kill -9 "$p1" 2>/dev/null || true
  wait "$p1" 2>/dev/null || true
  printf '%s %s\n' "$$" "$(hostname)" > "$X/nodes/c/arm.pid"
  $A "$X/x.diag" c > "$X/$impl-dup3" 2>&1 &
  p1=$!
  if wait_for "$X/$impl-dup3" READY; then ok "$impl stale arm.pid (pid not an arm) does not block"; else bad "$impl stale arm.pid (pid not an arm) does not block"; fi
  kill -9 "$p1" 2>/dev/null || true
  wait "$p1" 2>/dev/null || true
  rm -f "$X/nodes/c/arm.pid"
  rc=0; PATH=$NOINO timeout 5 $A "$X/x.diag" c > "$X/$impl-noino" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'inotifywait not found' "$X/$impl-noino" && ! grep -q '^READY' "$X/$impl-noino"; then ok "$impl arm without inotifywait fails loudly"; else bad "$impl arm without inotifywait fails loudly (rc=$rc)"; fi
  rm -f "$X/nodes/c/arm.pid"
  rc=0; CHANNEL_PING_TIMEOUT=abc $P "$X/x.diag" c > "$X/$impl-badenv" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'must be a whole number' "$X/$impl-badenv"; then ok "$impl bad env number fails"; else bad "$impl bad env number fails (rc=$rc)"; fi
done

# Plans that define PING/PONG message blocks (ACTION lines): built-in replies follow the
# block; a reply the tool cannot build is reported, shown as FILE, and the watch keeps going.
Y=$TMP/y
mkdir -p "$Y"
cat > "$Y/y.diag" <<EOF
blockdiag {
  p <-> q;
  p -< r;
  q <-> r;
  s <-> t;
}
/*
node p $Y/nodes/p/inbox
node q $Y/nodes/q/inbox
node r $Y/nodes/r/inbox
node s $Y/nodes/s/inbox
node t $Y/nodes/t/inbox
verb p q NOTE
verb q p NOTE
verb p r NOTE
verb q r NOTE
verb r q NOTE
verb s t NOTE
verb t s NOTE
message NOTE {
A note.
body: {
NOTE: <text>
}
}
message PING {
Connectivity test. Reply PONG with the same NONCE.
body: {
ACTION: PING
NONCE: <unique id>
}
}
message PONG {
Answer to PING.
body: {
ACTION: PONG
NONCE: <same nonce as the PING>
}
}
*/
EOF
# z: same nodes, but its PONG block asks for a value the tool cannot fill.
sed -e 's/^NONCE: <same nonce as the PING>$/NONCE: <same nonce as the PING>\nWHEN: <time of reply>/' "$Y/y.diag" > "$Y/z.diag"
for n in p q r s t; do "$ROOT/go/channel-setup" "$Y/y.diag" $n >/dev/null; done
export CHANNEL_LOG_FILE="$Y/log.txt"
for impl in go sh py; do
  case $impl in
    go) A="$ROOT/go/channel-arm"; P="$ROOT/go/channel-ping"; SN="$ROOT/go/channel-send" ;;
    sh) A="$ROOT/bin/channel-arm"; P="$ROOT/bin/channel-ping"; SN="$ROOT/bin/channel-send" ;;
    py) A="python3 $PY arm"; P="python3 $PY ping"; SN="python3 $PY send" ;;
  esac
  rm -f "$Y"/nodes/*/inbox/*.md "$Y"/nodes/*/arm.pid "$Y"/nodes/*/checkall-runs "$Y"/nodes/*/checkall.stamp
  : > "$Y/log.txt"
  ARM=$A SEND=$SN PINGC=$P
  : > "$Y/$impl-aq"; : > "$Y/$impl-ar"; : > "$Y/$impl-ap"
  fake_agent "$Y/$impl-aq" "$Y/y.diag" q &
  pq=$!
  fake_agent "$Y/$impl-ar" "$Y/y.diag" r &
  pr=$!
  fake_agent "$Y/$impl-ap" "$Y/y.diag" p &
  pp=$!
  sleep 1
  rc=0; $P --timeout 10 "$Y/y.diag" p > "$Y/$impl-pg" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^PONG q ' "$Y/$impl-pg" && grep -q '^NO-RETURN r ' "$Y/$impl-pg"; then ok "$impl ping with ACTION blocks: agent PONG validates"; else bad "$impl ping with ACTION blocks: agent PONG validates (rc=$rc)"; fi
  if [ ! -s "$Y/$impl-aq.err" ] && kill -0 "$pq" 2>/dev/null; then ok "$impl ACTION-block agent PONG accepted, watch keeps running"; else bad "$impl ACTION-block agent PONG accepted: $(cat "$Y/$impl-aq.err")"; fi
  rc=0; $P --all --timeout 10 "$Y/y.diag" p > "$Y/$impl-pga" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && grep -q '^CHECKALL p run ' "$Y/$impl-pga" && grep -q '^PONG q ' "$Y/$impl-pga"; then ok "$impl check-all with ACTION blocks"; else bad "$impl check-all with ACTION blocks (rc=$rc)"; fi
  n=0; while [ "$n" -lt 50 ] && ! grep -q 'event=ping result=ok from=q to=r kind=pong' "$Y/log.txt"; do sleep 0.2; n=$((n + 1)); done
  if grep -q 'event=checkall result=start node=q' "$Y/log.txt" && grep -q 'event=ping result=ok from=q to=r kind=pong' "$Y/log.txt"; then ok "$impl check-all propagates with ACTION blocks"; else bad "$impl check-all propagates with ACTION blocks"; fi
  if grep -q 'CHANNEL-' "$Y/$impl-aq.err" "$Y/$impl-ar.err" "$Y/$impl-ap.err"; then bad "$impl no control errors with ACTION blocks"; else ok "$impl no control errors with ACTION blocks"; fi
  for x in $pq $pr $pp; do kill -9 "$x" 2>/dev/null || true; done
  wait "$pq" "$pr" "$pp" 2>/dev/null || true
  pkill -9 -f "$Y/y.diag" 2>/dev/null || true
  sleep 0.3
  # a watch alone (z.diag, whose PONG block a tool could not fill anyway): the PING is shown
  # once as FILE, left in the inbox, and nothing answers it
  $A "$Y/z.diag" t > "$Y/$impl-at" 2> "$Y/$impl-at.err" &
  pt=$!
  wait_for "$Y/$impl-at" READY || true
  zf=$(put_ping "$Y/nodes/t/inbox" s t "$impl-forced")
  if [ -n "$zf" ] && wait_for "$Y/$impl-at" "FILE $zf"; then ok "$impl PING shown as FILE"; else bad "$impl PING shown as FILE"; fi
  sleep 0.6
  if [ -f "$zf" ] && kill -0 "$pt" 2>/dev/null && ! ls "$Y"/nodes/s/inbox/*.md "$Y"/nodes/s/pong-* >/dev/null 2>&1 && [ ! -s "$Y/$impl-at.err" ]; then ok "$impl watch leaves the PING to the agent, sends no PONG"; else bad "$impl watch leaves the PING to the agent"; fi
  if [ "$(grep -c "^FILE $zf" "$Y/$impl-at")" = 1 ]; then ok "$impl PING announced once"; else bad "$impl PING announced once"; fi
  rm -f "$zf"
  $SN "$Y/z.diag" s t NOTE -m 'NOTE: after' > "$Y/$impl-zn" 2>&1
  zn=$(sed -n 's/^SENT //p' "$Y/$impl-zn")
  if [ -n "$zn" ] && wait_for "$Y/$impl-at" "FILE $zn"; then ok "$impl watch goes on after the hand-handled PING"; else bad "$impl watch goes on after the hand-handled PING"; fi
  apid=; read -r apid _ < "$Y/nodes/t/arm.pid" || true
  if [ "$apid" = "$pt" ]; then ok "$impl arm.pid still names the running watch"; else bad "$impl arm.pid still names the running watch ($apid vs $pt)"; fi
  kill -9 "$pt" 2>/dev/null || true
  wait "$pt" 2>/dev/null || true
  pkill -9 -f "$Y/z.diag" 2>/dev/null || true
  rm -f "$Y"/nodes/*/inbox/*.md
  sed -e 's/^ACTION: PING$/ACTION: PING\nWHO: <sender name>/' "$Y/y.diag" > "$Y/w.diag"
  rc=0; $P --timeout 2 "$Y/w.diag" p > "$Y/$impl-wpg" 2>&1 || rc=$?
  if [ "$rc" != 0 ] && grep -q 'CHANNEL-CONTROL-BODY: the PING message block' "$Y/$impl-wpg" && ! ls "$Y"/nodes/q/inbox/*.md >/dev/null 2>&1; then ok "$impl unfillable PING block fails loudly, nothing sent"; else bad "$impl unfillable PING block fails loudly, nothing sent (rc=$rc)"; fi
  rm -f "$Y"/nodes/*/inbox/*.md
done
unset CHANNEL_LOG_FILE

# Send and retract: a send ends with DELIVERED once the file is in DEST's inbox (or ABORTED if
# stopped while PENDING); --retract and the receiver's claim are both one rename, so exactly
# one of them wins: RETRACTED or NOT-RETRACTED, both exit 0.
Z=$TMP/z
mkdir -p "$Z"
cat > "$Z/z.diag" <<ZEOF
blockdiag {
  s -> r;
  s -< q;
}
/*
node s $Z/nodes/s/inbox
node r $Z/nodes/r/inbox
node q $Z/nodes/q/inbox
verb s r NOTE
verb s q NOTE
message NOTE {
A note.
body: {
NOTE: <text>
}
}
*/
ZEOF
for n in s r q; do "$ROOT/go/channel-setup" "$Z/z.diag" $n >/dev/null; done
last_line() { tail -n 1 "$1"; }
# the how-to-act header tells the agent a lost claim is not an error and to resume watching
for ag in grok cursor; do
  capture "$Z/hdr-$ag" "$Z/hdr-$ag.err" "$Z/hdr-$ag.rc" sh -c 'cd "$1" && shift && exec "$@"' sh "$TMP/cur" env CHANNEL_AGENT=$ag "$ROOT/bin/channel-setup" "$Z/z.diag" q -n --whatineedtoknow
  if grep -q 'claim: if mv or rm of a FILE says No such file, the sender took it back first: you lost the race. Say so in one line (LOST <file>: the sender took it back) and go back to watching for new messages; it is not an error.' "$Z/hdr-$ag" \
    && grep -q 'NOT-RETRACTED <path> (DEST already has it; you lost the race)' "$Z/hdr-$ag" \
    && grep -q "Never check DEST's inbox, its claimed/ or channel-status" "$Z/hdr-$ag" \
    && grep -q 'With no arrow back to <FROM> you cannot send a PONG' "$Z/hdr-$ag" \
    && ! grep -q 'CONSUMED\|OUTCOME\|outcome/\|CHANNEL_SEND_WAIT\|DEST took it' "$Z/hdr-$ag"; then ok "$ag header: claim lost, retract, no inbox checks"; else bad "$ag header: claim lost / retract lines"; fi
done
if grep -q 'you lost the race (see claim): say so in one line and start the wrapper again' "$Z/hdr-cursor"; then ok "cursor header: gone file is a lost race"; else bad "cursor header: gone file is a lost race"; fi
for impl in go sh py; do
  case $impl in
    go) S="$ROOT/go/channel-send"; A="$ROOT/go/channel-arm" ;;
    sh) S="$ROOT/bin/channel-send"; A="$ROOT/bin/channel-arm" ;;
    py) S="python3 $PY send"; A="python3 $PY arm" ;;
  esac
  rm -rf "$Z"/nodes/*/inbox/*.md "$Z"/nodes/*/inbox/claimed "$Z"/nodes/s/retracted
  # delivered: in DEST's inbox, nothing has claimed it, no outcome/ written
  rc=0; $S "$Z/z.diag" s q NOTE -m 'NOTE: one' > "$Z/$impl-d" 2>&1 || rc=$?
  f=$(sed -n 's/^SENT //p' "$Z/$impl-d")
  if [ "$rc" = 0 ] && [ -n "$f" ] && [ "$(last_line "$Z/$impl-d")" = "DELIVERED $f" ] && [ -f "$f" ] && [ ! -e "$Z/nodes/s/outcome" ]; then ok "$impl send ends DELIVERED with the file in DEST's inbox, no outcome/"; else bad "$impl send DELIVERED (rc=$rc): $(cat "$Z/$impl-d")"; fi
  # CHANNEL_SEND_WAIT is gone: set at all, it dies (nothing sent)
  for v in 0 1; do
    rc=0; CHANNEL_SEND_WAIT=$v $S "$Z/z.diag" s q NOTE -m 'NOTE: x' > "$Z/$impl-bw" 2>&1 || rc=$?
    if [ "$rc" = 1 ] && grep -q 'CHANNEL_SEND_WAIT was removed' "$Z/$impl-bw" && [ "$(file_count '*.md' "$Z/nodes/q/inbox")" = 1 ]; then ok "$impl CHANNEL_SEND_WAIT=$v dies"; else bad "$impl CHANNEL_SEND_WAIT=$v (rc=$rc): $(cat "$Z/$impl-bw")"; fi
  done
  # --timeout belongs to PING only
  rc=0; $S --timeout 1 "$Z/z.diag" s q NOTE -m 'NOTE: x' > "$Z/$impl-bt" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q -- '--timeout is only for channel-ping and channel-send DEST PING' "$Z/$impl-bt"; then ok "$impl send --timeout (not PING) dies"; else bad "$impl send --timeout (rc=$rc): $(cat "$Z/$impl-bt")"; fi
  # a signal before the message reached DEST's inbox (waiting on a -> arrow) aborts
  $S "$Z/z.diag" s r NOTE -m 'NOTE: first' > "$Z/$impl-a1" 2>&1
  $S "$Z/z.diag" s r NOTE -m 'NOTE: second' > "$Z/$impl-a" 2>&1 &
  pid=$!
  wait_for "$Z/$impl-a" PENDING || true
  kill -TERM "$pid"
  wait_exit "$pid"
  if [ "$rc" = 4 ] && [ "$(last_line "$Z/$impl-a")" = "ABORTED r NOTE (not sent: terminated before it reached r's inbox)" ] && [ "$(file_count '*.md' "$Z/nodes/r/inbox")" = 1 ]; then ok "$impl send stopped while PENDING is ABORTED, nothing sent"; else bad "$impl pending abort (rc=$rc): $(cat "$Z/$impl-a")"; fi
  # PENDING then DELIVERED once the earlier message is taken
  $S "$Z/z.diag" s r NOTE -m 'NOTE: third' > "$Z/$impl-p" 2>&1 &
  pid=$!
  wait_for "$Z/$impl-p" PENDING || true
  rm -f "$Z"/nodes/r/inbox/*.md
  wait_exit "$pid"
  f=$(sed -n 's/^SENT //p' "$Z/$impl-p")
  if [ "$rc" = 0 ] && grep -q '^PENDING ' "$Z/$impl-p" && [ "$(last_line "$Z/$impl-p")" = "DELIVERED $f" ] && [ -f "$f" ]; then ok "$impl PENDING send ends DELIVERED"; else bad "$impl PENDING then DELIVERED (rc=$rc): $(cat "$Z/$impl-p")"; fi
  rm -f "$Z"/nodes/r/inbox/*.md
  # retract won, then again (already retracted), both exit 0
  $S "$Z/z.diag" s q NOTE -m 'NOTE: four' > "$Z/$impl-q" 2>&1
  f=$(sed -n 's/^SENT //p' "$Z/$impl-q")
  rc=0; $S "$Z/z.diag" s --retract "$f" > "$Z/$impl-r1" 2>&1 || rc=$?
  rc2=0; $S "$Z/z.diag" s --retract "$(basename "$f")" > "$Z/$impl-r2" 2>&1 || rc2=$?
  if [ "$rc" = 0 ] && [ "$(cat "$Z/$impl-r1")" = "RETRACTED $f -> $Z/nodes/s/retracted/$(basename "$f") (--retract)" ] && [ ! -e "$f" ] && [ "$rc2" = 0 ] && grep -q '^RETRACTED .*(already retracted)$' "$Z/$impl-r2"; then ok "$impl retract won, then already retracted (both exit 0)"; else bad "$impl --retract: $rc $(cat "$Z/$impl-r1") / $rc2 $(cat "$Z/$impl-r2")"; fi
  # retract lost: DEST claimed it first
  $S "$Z/z.diag" s q NOTE -m 'NOTE: five' > "$Z/$impl-q2" 2>&1
  f=$(sed -n 's/^SENT //p' "$Z/$impl-q2")
  mkdir -p "$Z/nodes/q/inbox/claimed"; mv "$f" "$Z/nodes/q/inbox/claimed/"
  rc=0; $S "$Z/z.diag" s --retract "$f" > "$Z/$impl-r3" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && [ "$(cat "$Z/$impl-r3")" = "NOT-RETRACTED $f (q already has it)" ]; then ok "$impl retract lost: NOT-RETRACTED (exit 0)"; else bad "$impl retract lost: $rc $(cat "$Z/$impl-r3")"; fi
  # retract lost: DEST (r, not the last node in the plan) removed it first
  rm -f "$Z"/nodes/r/inbox/*.md
  $S "$Z/z.diag" s r NOTE -m 'NOTE: six' > "$Z/$impl-q3" 2>&1
  f=$(sed -n 's/^SENT //p' "$Z/$impl-q3")
  rm -f "$f"
  rc=0; $S "$Z/z.diag" s --retract "$f" > "$Z/$impl-r7" 2>&1 || rc=$?
  if [ "$rc" = 0 ] && [ "$(cat "$Z/$impl-r7")" = "NOT-RETRACTED $f (r already has it)" ]; then ok "$impl retract lost to a removed file: NOT-RETRACTED (exit 0)"; else bad "$impl retract lost (removed): $rc $(cat "$Z/$impl-r7")"; fi
  # a message this node never sent, or another node's message, dies
  rc=0; $S "$Z/z.diag" s --retract "$Z/nodes/q/inbox/20260101-000000.000__s__9999.md" > "$Z/$impl-r4" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'no message 20260101-000000.000__s__9999.md was sent by s' "$Z/$impl-r4"; then ok "$impl retract of a never-sent message dies"; else bad "$impl retract never sent: $rc $(cat "$Z/$impl-r4")"; fi
  rc=0; $S "$Z/z.diag" s --retract "$Z/nodes/q/inbox/20260101-000000.000__r__1.md" > "$Z/$impl-r5" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'is not a message file sent by s' "$Z/$impl-r5"; then ok "$impl retract of a foreign message dies"; else bad "$impl retract foreign: $rc $(cat "$Z/$impl-r5")"; fi
  rc=0; $S "$Z/z.diag" s --retract "$Z/nodes/s/inbox/20260101-000000.000__s__9999.md" > "$Z/$impl-r6" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'is not in the inbox of a node s sends to' "$Z/$impl-r6"; then ok "$impl retract of a path outside DEST inboxes dies"; else bad "$impl retract wrong path: $rc $(cat "$Z/$impl-r6")"; fi
  # claim lost: the watcher showed FILE, the sender took it back first; the agent's mv fails
  # and its watch goes on to the next message
  rm -f "$Z"/nodes/q/arm.pid "$Z"/nodes/q/inbox/*.md
  $A "$Z/z.diag" q > "$Z/$impl-arm" 2> "$Z/$impl-arm.err" &
  ap=$!
  wait_for "$Z/$impl-arm" READY || true
  $S "$Z/z.diag" s q NOTE -m 'NOTE: taken back' > "$Z/$impl-c1" 2>&1
  f=$(sed -n 's/^SENT //p' "$Z/$impl-c1")
  wait_for "$Z/$impl-arm" "FILE $f" || true
  $S "$Z/z.diag" s --retract "$f" > "$Z/$impl-c2" 2>&1
  crc=0; mv "$f" "$Z/nodes/q/inbox/claimed/" 2>"$Z/$impl-cmv" || crc=$?
  if [ "$crc" != 0 ] && grep -q 'No such file' "$Z/$impl-cmv" && grep -q '^RETRACTED ' "$Z/$impl-c2"; then ok "$impl claim lost: mv says No such file after RETRACTED"; else bad "$impl claim lost: mv rc=$crc $(cat "$Z/$impl-c2")"; fi
  $S "$Z/z.diag" s q NOTE -m 'NOTE: next' > "$Z/$impl-c3" 2>&1
  f2=$(sed -n 's/^SENT //p' "$Z/$impl-c3")
  if [ -n "$f2" ] && wait_for "$Z/$impl-arm" "FILE $f2" && kill -0 "$ap" 2>/dev/null; then ok "$impl watcher resumes after a lost claim"; else bad "$impl watcher resumes after a lost claim: $(cat "$Z/$impl-arm" "$Z/$impl-arm.err")"; fi
  kill -9 "$ap" 2>/dev/null || true
  wait "$ap" 2>/dev/null || true
  pkill -9 -f "arm $Z/z.diag" 2>/dev/null || true
  rm -f "$Z"/nodes/q/inbox/*.md "$Z"/nodes/q/arm.pid
  # race: the receiver's claim and the sender's --retract at the same moment; exactly one wins
  bad_race=0; nret=0; nlost=0; i=0
  while [ "$i" -lt 40 ]; do
    i=$((i + 1))
    $S "$Z/z.diag" s q NOTE -m "NOTE: race $i" > "$Z/$impl-rq" 2>&1
    f=$(sed -n 's/^SENT //p' "$Z/$impl-rq"); b=$(basename "$f")
    # even rounds delay the claim, odd rounds the retract (0-399 ms), so both sides win some rounds
    # whatever each impl's start-up time is
    d="0.$(printf %03d $(( (i * 37) % 400 )))"; dc=0; dr=0
    if [ $((i % 2)) = 0 ]; then dc=$d; else dr=$d; fi
    (sleep "$dc"; mv "$f" "$Z/nodes/q/inbox/claimed/" 2>/dev/null) &
    mp=$!
    sleep "$dr"
    rrc=0; $S "$Z/z.diag" s --retract "$f" > "$Z/$impl-rr" 2>&1 || rrc=$?
    wait "$mp" 2>/dev/null || true
    inr=0; inc=0
    [ -f "$Z/nodes/s/retracted/$b" ] && inr=1
    [ -f "$Z/nodes/q/inbox/claimed/$b" ] && inc=1
    case "$rrc $(cut -d' ' -f1 "$Z/$impl-rr") $inr $inc" in
      "0 RETRACTED 1 0") nret=$((nret + 1)) ;;
      "0 NOT-RETRACTED 0 1") nlost=$((nlost + 1)) ;;
      *) bad_race=$((bad_race + 1)); echo "race $i: rc=$rrc $(cat "$Z/$impl-rr") retracted=$inr claimed=$inc" >&2 ;;
    esac
  done
  if [ "$bad_race" = 0 ] && [ "$nret" -gt 0 ] && [ "$nlost" -gt 0 ]; then ok "$impl claim vs retract race: exactly one wins (retracted $nret, lost $nlost)"; else bad "$impl claim vs retract race: $bad_race inconsistent (retracted $nret, lost $nlost; both must win some)"; fi
  rc=0; $S "$Z/z.diag" s r NOTE -m 'NOTE: x' --retract x > "$Z/$impl-bu" 2>&1 || rc=$?
  if [ "$rc" = 1 ] && grep -q 'usage: channel-send FILE NODE --retract MESSAGE' "$Z/$impl-bu"; then ok "$impl --retract with send args is refused"; else bad "$impl --retract usage (rc=$rc): $(cat "$Z/$impl-bu")"; fi
  rm -rf "$Z"/nodes/*/inbox/*.md "$Z"/nodes/q/inbox/claimed
done

# --- rebind: leftover watches in this worktree ---
RB=$TMP/rb
mkdir -p "$RB"
cat > "$RB/rb.diag" <<EOF
blockdiag {
  a <-> b;
}
/*
node a $RB/nodes/a/inbox
node b $RB/nodes/b/inbox
verb a b NOTE
verb b a NOTE
message NOTE {
A note.
body: {
NOTE: <t>
}
}
*/
EOF
"$ROOT/go/channel-setup" "$RB/rb.diag" a >/dev/null
"$ROOT/go/channel-setup" "$RB/rb.diag" b >/dev/null
pkill -9 -f "$TMP/" 2>/dev/null || true

capture "$TMP/sh-rbu" "$TMP/sh-rbu.err" "$TMP/sh-rbu.rc" "$ROOT/bin/channel-rebind" extra
capture "$TMP/go-rbu" "$TMP/go-rbu.err" "$TMP/go-rbu.rc" "$ROOT/go/channel-rebind" extra
same "rebind extra args shell/go" "$TMP/sh-rbu.err" "$TMP/go-rbu.err"
expect_text "rebind usage" "$TMP/sh-rbu.err" "usage: channel-rebind [--pid PID]"
expect_rc "rebind extra args exit" 1 "$TMP/sh-rbu.rc"

(
  cd "$ROOT"
  capture "$TMP/sh-none" "$TMP/sh-none.err" "$TMP/sh-none.rc" "$ROOT/bin/channel-rebind"
  capture "$TMP/go-none" "$TMP/go-none.err" "$TMP/go-none.rc" "$ROOT/go/channel-rebind"
  capture "$TMP/py-none" "$TMP/py-none.err" "$TMP/py-none.rc" python3 "$PY" rebind
)
same "rebind none shell/go" "$TMP/sh-none" "$TMP/go-none"
same "rebind none shell/py" "$TMP/sh-none" "$TMP/py-none"
expect_text "rebind none text" "$TMP/sh-none" "REBIND-NONE"
expect_rc "rebind none exit" 0 "$TMP/sh-none.rc"

for impl in go sh py; do
  case $impl in
    go) A="$ROOT/go/channel-arm"; RBIN="$ROOT/go/channel-rebind" ;;
    sh) A="$ROOT/bin/channel-arm"; RBIN="$ROOT/bin/channel-rebind" ;;
    py) A="python3 $PY arm"; RBIN="python3 $PY rebind" ;;
  esac
  rm -f "$RB"/nodes/*/arm.pid
  pkill -9 -f "$RB/rb.diag" 2>/dev/null || true
  $A "$RB/rb.diag" a > "$RB/$impl-arm-a" 2>&1 &
  pa=$!
  wait_for "$RB/$impl-arm-a" READY || true
  (
    cd "$ROOT"
    capture "$RB/$impl-one" "$RB/$impl-one.err" "$RB/$impl-one.rc" $RBIN
  )
  if grep -q '^how to act:' "$RB/$impl-one" && grep -q "you are node a " "$RB/$impl-one" && [ "$(cat "$RB/$impl-one.rc")" = 0 ]; then
    ok "$impl rebind one leftover prints the header"
  else
    bad "$impl rebind one leftover prints the header: $(head -5 "$RB/$impl-one" "$RB/$impl-one.err")"
  fi
  if ! kill -0 "$pa" 2>/dev/null; then ok "$impl rebind killed the leftover"; else bad "$impl rebind killed the leftover"; kill -9 "$pa" 2>/dev/null || true; fi
  wait "$pa" 2>/dev/null || true

  $A "$RB/rb.diag" a > "$RB/$impl-arm-a2" 2>&1 &
  pa=$!
  $A "$RB/rb.diag" b > "$RB/$impl-arm-b2" 2>&1 &
  pb=$!
  wait_for "$RB/$impl-arm-a2" READY || true
  wait_for "$RB/$impl-arm-b2" READY || true
  (
    cd "$ROOT"
    capture "$RB/$impl-ch" "$RB/$impl-ch.err" "$RB/$impl-ch.rc" $RBIN
  )
  if grep -q '^REBIND-CHOOSE$' "$RB/$impl-ch" && grep -q "node=a" "$RB/$impl-ch" && grep -q "node=b" "$RB/$impl-ch" && [ "$(cat "$RB/$impl-ch.rc")" = 0 ]; then
    ok "$impl rebind several prints REBIND-CHOOSE"
  else
    bad "$impl rebind several prints REBIND-CHOOSE: $(cat "$RB/$impl-ch" "$RB/$impl-ch.err")"
  fi
  if kill -0 "$pa" 2>/dev/null && kill -0 "$pb" 2>/dev/null; then ok "$impl rebind choose does not kill"; else bad "$impl rebind choose does not kill"; fi
  (
    cd "$ROOT"
    capture "$RB/$impl-pid" "$RB/$impl-pid.err" "$RB/$impl-pid.rc" $RBIN --pid "$pa"
  )
  if grep -q '^how to act:' "$RB/$impl-pid" && grep -q "you are node a " "$RB/$impl-pid"; then
    ok "$impl rebind --pid takes that watch"
  else
    bad "$impl rebind --pid takes that watch: $(head -5 "$RB/$impl-pid" "$RB/$impl-pid.err")"
  fi
  if ! kill -0 "$pa" 2>/dev/null && kill -0 "$pb" 2>/dev/null; then ok "$impl rebind --pid left the other watch"; else bad "$impl rebind --pid left the other watch"; fi
  wait "$pa" 2>/dev/null || true
  (
    cd "$ROOT"
    capture "$RB/$impl-rest" "$RB/$impl-rest.err" "$RB/$impl-rest.rc" $RBIN
  )
  if grep -q '^how to act:' "$RB/$impl-rest" && grep -q "you are node b " "$RB/$impl-rest"; then
    ok "$impl rebind takes the remaining watch"
  else
    bad "$impl rebind takes the remaining watch: $(head -5 "$RB/$impl-rest" "$RB/$impl-rest.err")"
  fi
  wait "$pb" 2>/dev/null || true

  $A "$RB/rb.diag" a > "$RB/$impl-arm-wt" 2>&1 &
  pa=$!
  wait_for "$RB/$impl-arm-wt" READY || true
  (
    cd /tmp
    capture "$RB/$impl-away" "$RB/$impl-away.err" "$RB/$impl-away.rc" $RBIN
  )
  if grep -q '^REBIND-NONE$' "$RB/$impl-away" && kill -0 "$pa" 2>/dev/null; then
    ok "$impl rebind ignores a watch from another directory"
  else
    bad "$impl rebind ignores a watch from another directory: $(cat "$RB/$impl-away") alive=$(kill -0 "$pa" 2>/dev/null && echo yes || echo no)"
  fi
  kill -9 "$pa" 2>/dev/null || true
  wait "$pa" 2>/dev/null || true

  # A shell wrapper that only mentions channel-arm is not itself a watch.
  /bin/sh -c '"$@" & wait' x $A "$RB/rb.diag" a > "$RB/$impl-arm-wrap" 2>&1 &
  wp=$!
  wait_for "$RB/$impl-arm-wrap" READY || true
  (
    cd "$ROOT"
    capture "$RB/$impl-wrap" "$RB/$impl-wrap.err" "$RB/$impl-wrap.rc" $RBIN
  )
  n=0
  while kill -0 "$wp" 2>/dev/null && [ "$n" -lt 40 ]; do
    n=$((n + 1))
    sleep 0.05
  done
  if grep -q '^how to act:' "$RB/$impl-wrap" && grep -q "you are node a " "$RB/$impl-wrap" && ! kill -0 "$wp" 2>/dev/null; then
    ok "$impl rebind one leftover through a shell wrapper"
  else
    bad "$impl rebind one leftover through a shell wrapper: $(head -5 "$RB/$impl-wrap" "$RB/$impl-wrap.err" "$RB/$impl-arm-wrap") alive=$(kill -0 "$wp" 2>/dev/null && echo yes || echo no)"
  fi
  kill -9 "$wp" 2>/dev/null || true
  wait "$wp" 2>/dev/null || true
  rm -f "$RB"/nodes/*/arm.pid
  pkill -9 -f "$RB/rb.diag" 2>/dev/null || true

  # A watch whose closest grok ancestor is not ours is left alone.
  # argv0 basename grok (POSIX: a symlink named grok; exec -a is not in dash).
  ln -sfn /bin/sh "$RB/grok"
  ("$RB/grok" -c '"$@" & wait' x $A "$RB/rb.diag" a) > "$RB/$impl-arm-fk" 2>&1 &
  fk=$!
  wait_for "$RB/$impl-arm-fk" READY || true
  (
    cd "$ROOT"
    capture "$RB/$impl-fk" "$RB/$impl-fk.err" "$RB/$impl-fk.rc" $RBIN
  )
  if grep -q '^REBIND-NONE$' "$RB/$impl-fk" && grep -q READY "$RB/$impl-arm-fk" && kill -0 "$fk" 2>/dev/null; then
    ok "$impl rebind skips a watch bound to another grok"
  else
    bad "$impl rebind skips a watch bound to another grok: $(cat "$RB/$impl-fk" "$RB/$impl-arm-fk") alive=$(kill -0 "$fk" 2>/dev/null && echo yes || echo no)"
  fi
  kill -9 "$fk" 2>/dev/null || true
  pkill -9 -f "$RB/rb.diag" 2>/dev/null || true
  wait "$fk" 2>/dev/null || true
done

# --- default FILE: $git-toplevel/sandbox/connect/<branch>/config.diag ---
WS=$TMP/ws
mkdir -p "$WS"
GIT_CEILING_DIRECTORIES=$TMP
export GIT_CEILING_DIRECTORIES
(
  cd "$WS"
  git init -q --initial-branch=feature-x
)
want_plan=$WS/sandbox/connect/feature-x/config.diag
mkdir -p "$WS/sandbox/connect/feature-x"
cat > "$want_plan" <<EOF
blockdiag {
  planner >-> coder;
}
/*
node planner $WS/sandbox/connect/feature-x/nodes/planner/inbox
node coder $WS/sandbox/connect/feature-x/nodes/coder/inbox
verb planner coder NOTE
verb coder planner NOTE
message NOTE {
A note.
body: {
NOTE: <t>
}
}
*/
EOF

(
  cd "$WS"
  capture "$TMP/sh-def-miss" "$TMP/sh-def-miss.err" "$TMP/sh-def-miss.rc" "$ROOT/bin/channel-arm" ghost
  capture "$TMP/go-def-miss" "$TMP/go-def-miss.err" "$TMP/go-def-miss.rc" "$ROOT/go/channel-arm" ghost
  capture "$TMP/py-def-miss" "$TMP/py-def-miss.err" "$TMP/py-def-miss.rc" python3 "$PY" arm ghost
)
same "default plan unknown node shell/go" "$TMP/sh-def-miss.err" "$TMP/go-def-miss.err"
same "default plan unknown node shell/py" "$TMP/sh-def-miss.err" "$TMP/py-def-miss.err"
expect_text "default plan unknown node text" "$TMP/sh-def-miss.err" "ghost is not a node in $want_plan"
expect_rc "default plan unknown node exit" 1 "$TMP/sh-def-miss.rc"

(
  cd "$WS"
  capture "$TMP/sh-def-setup" "$TMP/sh-def-setup.err" "$TMP/sh-def-setup.rc" "$ROOT/bin/channel-setup" planner
  capture "$TMP/go-def-setup" "$TMP/go-def-setup.err" "$TMP/go-def-setup.rc" "$ROOT/go/channel-setup" coder
)
if [ -d "$WS/sandbox/connect/feature-x/nodes/planner/inbox/claimed" ] && [ "$(cat "$TMP/sh-def-setup.rc")" = 0 ]; then
  ok "setup one-arg uses default plan"
else
  bad "setup one-arg uses default plan: $(cat "$TMP/sh-def-setup" "$TMP/sh-def-setup.err")"
fi
if [ -d "$WS/sandbox/connect/feature-x/nodes/coder/inbox/claimed" ] && [ "$(cat "$TMP/go-def-setup.rc")" = 0 ]; then
  ok "go setup one-arg uses default plan"
else
  bad "go setup one-arg uses default plan: $(cat "$TMP/go-def-setup" "$TMP/go-def-setup.err")"
fi

(
  cd "$WS"
  capture "$TMP/sh-def-w" "$TMP/sh-def-w.err" "$TMP/sh-def-w.rc" "$ROOT/bin/channel-arm" planner --whatineedtoknow
  capture "$TMP/go-def-w" "$TMP/go-def-w.err" "$TMP/go-def-w.rc" "$ROOT/go/channel-arm" planner --whatineedtoknow
  capture "$TMP/py-def-w" "$TMP/py-def-w.err" "$TMP/py-def-w.rc" python3 "$PY" arm planner --whatineedtoknow
)
same "default plan whatineedtoknow shell/go" "$TMP/sh-def-w" "$TMP/go-def-w"
same "default plan whatineedtoknow shell/py" "$TMP/sh-def-w" "$TMP/py-def-w"
if grep -q '^how to act:' "$TMP/sh-def-w" && grep -q "plan: $want_plan" "$TMP/sh-def-w" && grep -q "you are node planner " "$TMP/sh-def-w"; then
  ok "default plan whatineedtoknow names the config"
else
  bad "default plan whatineedtoknow names the config: $(head -8 "$TMP/sh-def-w" "$TMP/sh-def-w.err")"
fi
expect_rc "default plan whatineedtoknow exit" 0 "$TMP/sh-def-w.rc"

(
  cd "$WS"
  capture "$TMP/sh-def-st" "$TMP/sh-def-st.err" "$TMP/sh-def-st.rc" "$ROOT/bin/channel-status"
  capture "$TMP/go-def-st" "$TMP/go-def-st.err" "$TMP/go-def-st.rc" "$ROOT/go/channel-status"
)
same "default plan status shell/go" "$TMP/sh-def-st" "$TMP/go-def-st"
if grep -q "node planner " "$TMP/sh-def-st" && grep -q "node coder " "$TMP/sh-def-st" && [ "$(cat "$TMP/sh-def-st.rc")" = 0 ]; then
  ok "status no-arg uses default plan"
else
  bad "status no-arg uses default plan: $(cat "$TMP/sh-def-st" "$TMP/sh-def-st.err")"
fi

NG=$TMP/nongit
mkdir -p "$NG"
(
  cd "$NG"
  capture "$TMP/sh-nogit" "$TMP/sh-nogit.err" "$TMP/sh-nogit.rc" "$ROOT/bin/channel-arm" planner
  capture "$TMP/go-nogit" "$TMP/go-nogit.err" "$TMP/go-nogit.rc" "$ROOT/go/channel-arm" planner
  capture "$TMP/py-nogit" "$TMP/py-nogit.err" "$TMP/py-nogit.rc" python3 "$PY" arm planner
)
same "no git default plan shell/go" "$TMP/sh-nogit.err" "$TMP/go-nogit.err"
same "no git default plan shell/py" "$TMP/sh-nogit.err" "$TMP/py-nogit.err"
expect_text "no git default plan text" "$TMP/sh-nogit.err" "no git repository here; pass the plan file (sandbox/connect/<workspace>/config.diag)"
expect_rc "no git default plan exit" 1 "$TMP/sh-nogit.rc"

(
  cd "$WS"
  git -c user.email=t@t -c user.name=t commit --allow-empty -q -m i
  git checkout -q --detach
  capture "$TMP/sh-det" "$TMP/sh-det.err" "$TMP/sh-det.rc" "$ROOT/bin/channel-arm" planner
  capture "$TMP/go-det" "$TMP/go-det.err" "$TMP/go-det.rc" "$ROOT/go/channel-arm" planner
  capture "$TMP/py-det" "$TMP/py-det.err" "$TMP/py-det.rc" python3 "$PY" arm planner
)
same "detached HEAD default plan shell/go" "$TMP/sh-det.err" "$TMP/go-det.err"
same "detached HEAD default plan shell/py" "$TMP/sh-det.err" "$TMP/py-det.err"
expect_text "detached HEAD default plan text" "$TMP/sh-det.err" "git HEAD is detached; pass the plan file or check out the workspace branch"
expect_rc "detached HEAD default plan exit" 1 "$TMP/sh-det.rc"

(
  cd "$WS"
  git checkout -q feature-x
)
rm -f "$WS"/sandbox/connect/feature-x/nodes/*/arm.pid
( cd "$WS" && exec "$ROOT/go/channel-arm" planner ) > "$TMP/def-arm.out" 2>"$TMP/def-arm.err" &
pa=$!
echo "$pa" >> "$PIDS"
wait_for "$TMP/def-arm.out" READY || true
(
  cd "$WS"
  capture "$TMP/sh-def-rb" "$TMP/sh-def-rb.err" "$TMP/sh-def-rb.rc" "$ROOT/bin/channel-rebind"
)
if grep -q '^how to act:' "$TMP/sh-def-rb" && grep -q "you are node planner " "$TMP/sh-def-rb" && grep -q "plan: $want_plan" "$TMP/sh-def-rb" && [ "$(cat "$TMP/sh-def-rb.rc")" = 0 ]; then
  ok "rebind recovers a one-arg leftover watch"
else
  bad "rebind recovers a one-arg leftover watch: $(head -8 "$TMP/sh-def-rb" "$TMP/sh-def-rb.err" "$TMP/def-arm.out" "$TMP/def-arm.err")"
fi
if ! kill -0 "$pa" 2>/dev/null; then ok "rebind killed the one-arg leftover"; else bad "rebind killed the one-arg leftover"; kill -9 "$pa" 2>/dev/null || true; fi
wait "$pa" 2>/dev/null || true

# Missing default file: same git layout, no config.
MISS=$TMP/miss
mkdir -p "$MISS"
(
  cd "$MISS"
  git init -q --initial-branch=feature-x
  capture "$TMP/sh-nofile" "$TMP/sh-nofile.err" "$TMP/sh-nofile.rc" "$ROOT/bin/channel-arm" planner
  capture "$TMP/go-nofile" "$TMP/go-nofile.err" "$TMP/go-nofile.rc" "$ROOT/go/channel-arm" planner
)
same "missing default plan file shell/go" "$TMP/sh-nofile.err" "$TMP/go-nofile.err"
expect_text "missing default plan file text" "$TMP/sh-nofile.err" "no plan file $MISS/sandbox/connect/feature-x/config.diag"
expect_rc "missing default plan file exit" 1 "$TMP/sh-nofile.rc"

# The dispatcher end to end (two dispatcher processes, fake agent, this tree's bin/channel).
if "$ROOT/tests/dispatch" >"$TMP/dispatch.out" 2>&1; then ok "dispatcher end to end (tests/dispatch: $(tail -1 "$TMP/dispatch.out"))"
else cat "$TMP/dispatch.out" >&2; bad "dispatcher end to end (tests/dispatch)"; fi

printf '%s\n' "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
