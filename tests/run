#!/bin/sh
# Exercise bin/channel (shell) and go/channel (static binary) against the same protocol.
# A pass includes each program reading a mailbox the other one wrote.
# Run from anywhere: tests/run
set -eu
export LC_ALL=C
export CHANNEL_AGENT=grok

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
SH=$ROOT/bin/channel
GO=$ROOT/go/channel
PY=$ROOT/bin/channel.py

# All test state lives in this tree (.test-run.* is gitignored) and the trap removes it.
TMP=$(mktemp -d "$ROOT/.test-run.XXXXXX")
# This checkout may be a setgid directory of a group the tester is not in; then setup's
# chmod 2775 silently loses the setgid bit. Give the scratch dir the tester's own group.
chgrp "$(id -g)" "$TMP" && chmod g-s "$TMP" || { echo "cannot set the group of $TMP" >&2; rm -rf "$TMP"; exit 1; }
PIDS=$TMP/pids
: > "$PIDS"
pass=0
fail=0

cleanup() {
  pkill -9 -f "$TMP/" 2>/dev/null || true
  if [ -f "$PIDS" ]; then
    while read -r p; do
      kill "$p" 2>/dev/null || true
      wait "$p" 2>/dev/null || true
    done < "$PIDS"
  fi
  # Go marks its module cache read-only; make it removable first.
  if [ -d "$TMP/gopath" ]; then chmod -R u+w "$TMP/gopath"; fi
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

ok() { pass=$((pass + 1)); printf 'ok  %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$1" >&2; }

# The how-to-act header names the running binary's directory, which differs
# between the shell, Python, and Go builds; compare it as a bare command name.
norm_bin() { sed -E 's#[^ ]*/(channel-(setup|arm|send|ping|status|rebind))#\1#g' "$1"; }

same() {
  norm_bin "$2" > "$2.norm"
  norm_bin "$3" > "$3.norm"
  if diff -q "$2.norm" "$3.norm" >/dev/null 2>&1; then
    ok "$1"
  else
    bad "$1"
    diff -u "$2.norm" "$3.norm" >&2 || true
  fi
}

capture() {
  _out=$1
  _err=$2
  _rc=$3
  shift 3
  set +e
  "$@" >"$_out" 2>"$_err"
  _status=$?
  set -e
  printf '%s\n' "$_status" > "$_rc"
}

expect_rc() {
  got=$(cat "$3")
  if [ "$got" = "$2" ]; then
    ok "$1"
  else
    bad "$1 (rc $got want $2)"
  fi
}

expect_text() {
  printf '%s\n' "$3" > "$TMP/want-text"
  same "$1" "$2" "$TMP/want-text"
}

empty_file() {
  if [ ! -s "$2" ]; then
    ok "$1"
  else
    bad "$1"
    echo "---- $2 ----" >&2
    cat "$2" >&2
  fi
}

wait_for() {
  file=$1
  text=$2
  n=0
  while [ "$n" -lt 80 ]; do
    if grep -F -q -- "$text" "$file" 2>/dev/null; then
      return 0
    fi
    n=$((n + 1))
    sleep 0.1
  done
  echo "timed out waiting for [$text]" >&2
  echo "---- $file ----" >&2
  cat "$file" >&2 || true
  return 1
}

spawn() {
  _out=$1
  _err=$2
  shift 2
  "$@" >"$_out" 2>"$_err" &
  echo $! >> "$PIDS"
  echo $!
}

file_count() {
  pat=$1
  dir=$2
  n=0
  for f in "$dir"/$pat; do
    [ -f "$f" ] || continue
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

export GOCACHE=$TMP/go-build-cache
export GOPATH=$TMP/gopath
export GOTOOLCHAIN=local
export CGO_ENABLED=0
export GOPROXY=off
go build -C "$ROOT/go" -trimpath -ldflags '-s -w' -o channel .

for name in channel-setup channel-arm channel-send channel-rebind; do
  if [ "$(readlink "$ROOT/bin/$name")" = channel ] && [ "$(readlink "$ROOT/go/$name")" = channel ]; then
    ok "symlink $name"
  else
    bad "symlink $name"
  fi
done

if head -1 "$SH" | grep -qx '#!/bin/sh'; then ok "shell shebang"; else bad "shell shebang"; fi
if file "$GO" | grep -q 'statically linked'; then ok "go static"; else bad "go static"; fi
if ldd "$GO" 2>&1 | grep -q 'not a dynamic executable'; then ok "go not dynamic"; else bad "go not dynamic"; fi
size=$(stat -c %s "$GO")
if [ "$size" -gt 1000000 ] && [ "$size" -lt 8000000 ]; then
  ok "go size $size"
else
  bad "go size $size"
fi
deps=$(go list -C "$ROOT/go" -deps -f '{{if and (not .Standard) (ne .ImportPath "agentchannel")}}{{.ImportPath}}{{end}}')
if [ -z "$deps" ]; then ok "go stdlib only"; else bad "go deps: $deps"; fi
mods=$(go list -C "$ROOT/go" -m all)
if [ "$mods" = agentchannel ]; then ok "go module has no requirements"; else bad "go modules: $mods"; fi

# --- help and mode selection ---

capture "$TMP/sh-help" "$TMP/sh-help.err" "$TMP/sh-help.rc" "$SH"
capture "$TMP/go-help" "$TMP/go-help.err" "$TMP/go-help.rc" "$GO"
same "help text" "$TMP/sh-help" "$TMP/go-help"
empty_file "help stderr" "$TMP/sh-help.err"
empty_file "go help stderr" "$TMP/go-help.err"
expect_rc "help exit" 0 "$TMP/sh-help.rc"
expect_rc "go help exit" 0 "$TMP/go-help.rc"

capture "$TMP/sh-h" "$TMP/sh-h.err" "$TMP/sh-h.rc" "$ROOT/bin/channel-setup" -h
same "setup -h is help" "$TMP/sh-h" "$TMP/sh-help"
expect_rc "setup -h exit" 0 "$TMP/sh-h.rc"
capture "$TMP/go-h" "$TMP/go-h.err" "$TMP/go-h.rc" "$ROOT/go/channel-arm" --help
same "arm --help is help" "$TMP/go-h" "$TMP/go-help"

capture "$TMP/sh-nomode" "$TMP/sh-nomode.err" "$TMP/sh-nomode.rc" "$SH" "$ROOT/example/comms.diag"
capture "$TMP/go-nomode" "$TMP/go-nomode.err" "$TMP/go-nomode.rc" "$GO" "$ROOT/example/comms.diag"
same "no mode stderr" "$TMP/sh-nomode.err" "$TMP/go-nomode.err"
expect_text "no mode text" "$TMP/sh-nomode.err" "no mode; use --setup, --arm, --send, --ping, --status, or --rebind"
expect_rc "no mode exit" 1 "$TMP/sh-nomode.rc"
expect_rc "go no mode exit" 1 "$TMP/go-nomode.rc"

capture "$TMP/sh-pick" "$TMP/sh-pick.err" "$TMP/sh-pick.rc" "$SH" --setup --arm
capture "$TMP/go-pick" "$TMP/go-pick.err" "$TMP/go-pick.rc" "$GO" --arm --send
same "two mode flags" "$TMP/sh-pick.err" "$TMP/go-pick.err"
expect_text "pick one" "$TMP/sh-pick.err" "pick one of --setup, --arm, --send, --ping, --status, or --rebind"
expect_rc "pick one exit" 1 "$TMP/sh-pick.rc"

capture "$TMP/sh-conf" "$TMP/sh-conf.err" "$TMP/sh-conf.rc" "$ROOT/bin/channel-arm" --setup
capture "$TMP/go-conf" "$TMP/go-conf.err" "$TMP/go-conf.rc" "$ROOT/go/channel-arm" --setup
same "conflicting name and flag" "$TMP/sh-conf.err" "$TMP/go-conf.err"
expect_text "conflict text" "$TMP/sh-conf.err" "this command is arm; setup is a different mode"

capture "$TMP/sh-use" "$TMP/sh-use.err" "$TMP/sh-use.rc" "$ROOT/bin/channel-setup"
capture "$TMP/go-use" "$TMP/go-use.err" "$TMP/go-use.rc" "$ROOT/go/channel-setup"
same "setup usage" "$TMP/sh-use.err" "$TMP/go-use.err"
expect_text "setup usage text" "$TMP/sh-use.err" "usage: channel-setup [FILE] NODE [-n|--dry-run] [--whatineedtoknow]"
expect_rc "setup usage exit" 1 "$TMP/sh-use.rc"

capture "$TMP/sh-armu" "$TMP/sh-armu.err" "$TMP/sh-armu.rc" "$ROOT/bin/channel-arm"
capture "$TMP/go-armu" "$TMP/go-armu.err" "$TMP/go-armu.rc" "$ROOT/go/channel-arm"
same "arm usage" "$TMP/sh-armu.err" "$TMP/go-armu.err"
expect_text "arm usage text" "$TMP/sh-armu.err" "usage: channel-arm [FILE] NODE"
expect_rc "arm usage exit" 1 "$TMP/sh-armu.rc"

capture "$TMP/sh-use2" "$TMP/sh-use2.err" "$TMP/sh-use2.rc" "$SH" --send
capture "$TMP/go-use2" "$TMP/go-use2.err" "$TMP/go-use2.rc" "$GO" --send
same "send usage via flag" "$TMP/sh-use2.err" "$TMP/go-use2.err"
expect_text "send usage text" "$TMP/sh-use2.err" "usage: channel --send FILE NODE RECIPIENT VERB [BODYFILE|-|-m TEXT...] [REF ...]"

capture "$TMP/sh-badopt" "$TMP/sh-badopt.err" "$TMP/sh-badopt.rc" "$SH" --nope
capture "$TMP/go-badopt" "$TMP/go-badopt.err" "$TMP/go-badopt.rc" "$GO" --nope
expect_rc "shell unknown option" 2 "$TMP/sh-badopt.rc"
expect_rc "go unknown option" 2 "$TMP/go-badopt.rc"
expect_text "go unknown option text" "$TMP/go-badopt.err" "option --nope not recognized
usage: channel [-h] MODE [FILE] [NODE ...] [options]"
if grep -F -q -- 'nope' "$TMP/sh-badopt.err"; then ok "shell unknown option names it"; else bad "shell unknown option names it"; fi
for impl in sh go; do
  if [ "$(wc -l < "$TMP/$impl-badopt.err")" -eq 2 ] && grep -q '^usage: channel ' "$TMP/$impl-badopt.err" && [ ! -s "$TMP/$impl-badopt" ]; then ok "$impl unknown option: one error plus the usage line"; else bad "$impl unknown option: one error plus the usage line"; fi
done
if [ "$(wc -l < "$TMP/sh-help")" -le 30 ] && head -1 "$TMP/sh-help" | grep -q '^usage: channel ' && grep -q -- '--whatineedtoknow' "$TMP/sh-help" && grep -q 'bin/README.md' "$TMP/sh-help"; then ok "help is short and points to bin/README.md"; else bad "help is short and points to bin/README.md"; fi

capture "$TMP/sh-eq" "$TMP/sh-eq.err" "$TMP/sh-eq.rc" "$SH" --dry-run=1
capture "$TMP/go-eq" "$TMP/go-eq.err" "$TMP/go-eq.rc" "$GO" --dry-run=1
expect_rc "shell option value" 2 "$TMP/sh-eq.rc"
expect_text "go option value" "$TMP/go-eq.err" "option --dry-run must not have a value
usage: channel [-h] MODE [FILE] [NODE ...] [options]"

# --- example plan oracle (python) ---

EX=$ROOT/example/comms.diag
capture "$TMP/py-n" "$TMP/py-n.err" "$TMP/py-n.rc" python3 "$PY" setup -n "$EX" planner
capture "$TMP/sh-n" "$TMP/sh-n.err" "$TMP/sh-n.rc" "$ROOT/bin/channel-setup" -n "$EX" planner
capture "$TMP/go-n" "$TMP/go-n.err" "$TMP/go-n.rc" "$ROOT/go/channel-setup" "$EX" planner -n
same "example dry-run shell" "$TMP/py-n" "$TMP/sh-n"
same "example dry-run go" "$TMP/py-n" "$TMP/go-n"
empty_file "example dry-run stderr" "$TMP/sh-n.err"
if [ ! -d /channel/connect ]; then ok "dry-run does not create /channel"; else bad "dry-run created /channel"; fi

capture "$TMP/py-w" "$TMP/py-w.err" "$TMP/py-w.rc" python3 "$PY" arm "$EX" coder --whatineedtoknow
capture "$TMP/sh-w" "$TMP/sh-w.err" "$TMP/sh-w.rc" "$SH" --arm "$EX" coder --whatineedtoknow
capture "$TMP/go-w" "$TMP/go-w.err" "$TMP/go-w.rc" "$ROOT/go/channel-send" --whatineedtoknow "$EX" coder
same "example what shell" "$TMP/py-w" "$TMP/sh-w"
same "example what go" "$TMP/py-w" "$TMP/go-w"
expect_rc "what exits" 0 "$TMP/sh-w.rc"

# same mode flag on an already-named command is accepted
capture "$TMP/sh-same" "$TMP/sh-same.err" "$TMP/sh-same.rc" "$ROOT/bin/channel-arm" --arm "$EX" coder --whatineedtoknow
same "named command plus its own flag" "$TMP/py-w" "$TMP/sh-same"

# The agent tool comes only from CHANNEL_AGENT (set by the run-* launchers); no guessing.
if grep -qx 'you are node coder (agent: grok)' "$TMP/sh-w" && grep -q 'with the monitor tool, persistent: true' "$TMP/sh-w" && ! grep -q 'cursor-channel-watch' "$TMP/sh-w"; then ok "grok header names the monitor watch"; else bad "grok header names the monitor watch"; fi
if grep -q '^  receive from planner (wait): ' "$TMP/sh-w" && grep -q '^  send to planner ' "$TMP/sh-w"; then ok "header lists duties per direction"; else bad "header lists duties per direction: $(grep -A4 '^duties' "$TMP/sh-w")"; fi
for impl in sh go py; do
  case $impl in sh) W="$SH --arm" ;; go) W="$GO --arm" ;; py) W="python3 $PY arm" ;; esac
  capture "$TMP/$impl-nag" "$TMP/$impl-nag.err" "$TMP/$impl-nag.rc" env -u CHANNEL_AGENT $W "$EX" coder --whatineedtoknow
  if [ "$(cat "$TMP/$impl-nag.rc")" = 1 ] && [ ! -s "$TMP/$impl-nag" ] && grep -q 'CHANNEL-AGENT-UNKNOWN: CHANNEL_AGENT is unset' "$TMP/$impl-nag.err"; then ok "$impl no CHANNEL_AGENT fails loudly"; else bad "$impl no CHANNEL_AGENT fails loudly"; fi
  capture "$TMP/$impl-bag" "$TMP/$impl-bag.err" "$TMP/$impl-bag.rc" env CHANNEL_AGENT=claude $W "$EX" coder --whatineedtoknow
  if [ "$(cat "$TMP/$impl-bag.rc")" = 1 ] && [ ! -s "$TMP/$impl-bag" ] && grep -q 'CHANNEL-AGENT-UNKNOWN: CHANNEL_AGENT is "claude"' "$TMP/$impl-bag.err"; then ok "$impl unknown CHANNEL_AGENT fails loudly"; else bad "$impl unknown CHANNEL_AGENT fails loudly"; fi
  mkdir -p "$TMP/cur-none"
  capture "$TMP/$impl-cnw" "$TMP/$impl-cnw.err" "$TMP/$impl-cnw.rc" sh -c 'cd "$1" && shift && CHANNEL_AGENT=cursor exec "$@"' sh "$TMP/cur-none" $W "$EX" coder --whatineedtoknow
  if [ "$(cat "$TMP/$impl-cnw.rc")" = 1 ] && [ ! -s "$TMP/$impl-cnw" ] && grep -q 'CHANNEL-AGENT: CHANNEL_AGENT=cursor needs the watch wrapper' "$TMP/$impl-cnw.err"; then ok "$impl cursor without its watch wrapper fails loudly"; else bad "$impl cursor without its watch wrapper fails loudly"; fi
  mkdir -p "$TMP/cur/.cursor/lib" && printf '#!/bin/sh\n' > "$TMP/cur/.cursor/lib/cursor-channel-watch" && chmod +x "$TMP/cur/.cursor/lib/cursor-channel-watch"
  capture "$TMP/$impl-cur" "$TMP/$impl-cur.err" "$TMP/$impl-cur.rc" sh -c 'cd "$1" && shift && CHANNEL_AGENT=cursor exec "$@"' sh "$TMP/cur" $W "$EX" coder --whatineedtoknow
done
if grep -qx 'you are node coder (agent: cursor)' "$TMP/sh-cur" && grep -qF "Run exactly $TMP/cur/.cursor/lib/cursor-channel-watch " "$TMP/sh-cur" && grep -q 'block_until_ms: 0' "$TMP/sh-cur" && grep -q 'Cursor wakes you only when a background shell finishes' "$TMP/sh-cur" && grep -q 'then start the same wrapper command again before you end the turn' "$TMP/sh-cur" && grep -q 'already gone when you open it' "$TMP/sh-cur" && ! grep -q 'monitor tool' "$TMP/sh-cur"; then ok "cursor header names the wrapper watch"; else bad "cursor header names the wrapper watch"; fi
same "cursor header shell/go" "$TMP/sh-cur" "$TMP/go-cur"
same "cursor header shell/py" "$TMP/sh-cur" "$TMP/py-cur"

# options after positionals, including when POSIXLY_CORRECT is set in the environment
capture "$TMP/sh-pos" "$TMP/sh-pos.err" "$TMP/sh-pos.rc" env POSIXLY_CORRECT=1 "$ROOT/bin/channel-setup" "$EX" planner --dry-run
same "option after positionals" "$TMP/py-n" "$TMP/sh-pos"
capture "$TMP/go-pos" "$TMP/go-pos.err" "$TMP/go-pos.rc" "$ROOT/go/channel" --setup "$EX" --dry-run planner
same "go flag among positionals" "$TMP/py-n" "$TMP/go-pos"

mkdir -p "$TMP/dir with space"
cp "$EX" "$TMP/dir with space/comms.diag"
capture "$TMP/sh-sp" "$TMP/sh-sp.err" "$TMP/sh-sp.rc" "$ROOT/bin/channel-setup" -n "$TMP/dir with space/comms.diag" planner
capture "$TMP/go-sp" "$TMP/go-sp.err" "$TMP/go-sp.rc" "$ROOT/go/channel-setup" -n "$TMP/dir with space/comms.diag" planner
same "plan path with a space" "$TMP/sh-sp" "$TMP/go-sp"
if grep -F -q -- "$TMP/dir with space/comms.diag" "$TMP/sh-sp"; then ok "space path is printed"; else bad "space path is printed"; fi

# -- ends the option scan, so -n becomes a node name
capture "$TMP/sh-dd" "$TMP/sh-dd.err" "$TMP/sh-dd.rc" "$ROOT/bin/channel-setup" -- "$EX" -n
capture "$TMP/go-dd" "$TMP/go-dd.err" "$TMP/go-dd.rc" "$ROOT/go/channel-setup" -- "$EX" -n
same "double dash stops options" "$TMP/sh-dd.err" "$TMP/go-dd.err"
expect_text "dash-n is not a node" "$TMP/sh-dd.err" "node must be a bare name, not a path (-n)"

capture "$TMP/sh-armn" "$TMP/sh-armn.err" "$TMP/sh-armn.rc" "$ROOT/bin/channel-arm" -n "$EX" coder
capture "$TMP/go-armn" "$TMP/go-armn.err" "$TMP/go-armn.rc" "$ROOT/go/channel-arm" "$EX" coder --dry-run
same "dry-run rejected on arm" "$TMP/sh-armn.err" "$TMP/go-armn.err"
expect_text "dry-run only setup" "$TMP/sh-armn.err" "--dry-run is only for channel-setup"

# --- generated plan ---

PIN=$TMP/nodes/planner/inbox
CIN=$TMP/nodes/coder/inbox
AIN=$TMP/nodes/auditor/inbox
SIN=$TMP/nodes/scribe/inbox
PLAN=$TMP/comms.diag
cat > "$PLAN" <<EOF
# planner >-> coder: planner to coder waits (one in flight), coder to planner queues.
blockdiag {
  planner >-> coder;
  auditor -> scribe;
}

/*
node planner $PIN
node coder $CIN
node auditor $AIN
node scribe $SIN

verb planner coder TASK
verb coder planner NOTE
verb auditor scribe TASK

message TASK {
Ask for one step.
body: {
ACTION: TASK
PLAN: <path>
}
}

message NOTE {
A queued note.
body: {
TEXT: keep this line
ITEM: <thing>
}
}
*/
EOF

mkdir -p "$TMP/bodies"
printf '%s\n' 'ACTION: TASK' 'PLAN: /tmp/work' > "$TMP/bodies/ping.md"
printf '%s\n' 'ACTION: TASK' 'PLAN: /tmp/work' 'MORE: yes' > "$TMP/bodies/ping-extra.md"
printf '%s\n' 'ACTION: TASK' > "$TMP/bodies/ping-bad.md"
printf '%s\n' 'ACTION: TASK' 'PLAN: <path>' > "$TMP/bodies/ping-hole.md"
printf '%s\n' 'TEXT: keep this line' 'ITEM: a box' > "$TMP/bodies/note.md"
printf '%s\n' 'ITEM: a box' > "$TMP/bodies/note-bad.md"
printf '%s\n' 'ref-bytes' > "$TMP/bodies/ref.txt"

capture "$TMP/sh-dry" "$TMP/sh-dry.err" "$TMP/sh-dry.rc" "$SH" --setup -n "$PLAN" planner
capture "$TMP/go-dry" "$TMP/go-dry.err" "$TMP/go-dry.rc" "$GO" --setup "$PLAN" planner -n
capture "$TMP/py-dry" "$TMP/py-dry.err" "$TMP/py-dry.rc" python3 "$PY" setup "$PLAN" -n planner
same "generated dry-run shell/go" "$TMP/sh-dry" "$TMP/go-dry"
same "generated dry-run shell/py" "$TMP/sh-dry" "$TMP/py-dry"
if [ ! -d "$PIN" ] && [ ! -d "$TMP/refs" ]; then ok "dry-run creates nothing"; else bad "dry-run creates nothing"; fi

capture "$TMP/sh-both" "$TMP/sh-both.err" "$TMP/sh-both.rc" "$ROOT/bin/channel-setup" "$PLAN" planner -n --whatineedtoknow
capture "$TMP/go-both" "$TMP/go-both.err" "$TMP/go-both.rc" "$ROOT/go/channel-setup" --whatineedtoknow "$PLAN" planner --dry-run
capture "$TMP/py-both" "$TMP/py-both.err" "$TMP/py-both.rc" python3 "$PY" setup --whatineedtoknow "$PLAN" planner -n
same "dry-run plus what shell/go" "$TMP/sh-both" "$TMP/go-both"
same "dry-run plus what shell/py" "$TMP/sh-both" "$TMP/py-both"
if [ ! -d "$PIN" ]; then ok "what creates nothing"; else bad "what creates nothing"; fi

capture "$TMP/sh-pl" "$TMP/sh-pl.err" "$TMP/sh-pl.rc" "$SH" --arm "$PLAN" planner --whatineedtoknow
capture "$TMP/go-pl" "$TMP/go-pl.err" "$TMP/go-pl.rc" "$GO" --setup "$PLAN" planner --whatineedtoknow
if grep -Fqw auditor "$TMP/sh-pl" || grep -Fqw scribe "$TMP/sh-pl"; then
  bad "planner what omits unrelated nodes"
else
  ok "planner what omits unrelated nodes"
fi
if grep -F -q 'node coder ' "$TMP/sh-pl" && grep -F -q 'message NOTE {' "$TMP/sh-pl" && grep -F -q 'message TASK {' "$TMP/sh-pl"; then
  ok "planner what includes its edges"
else
  bad "planner what includes its edges"
fi
same "planner what shell/go" "$TMP/sh-pl" "$TMP/go-pl"

capture "$TMP/sh-au" "$TMP/sh-au.err" "$TMP/sh-au.rc" "$ROOT/bin/channel-send" "$PLAN" auditor --whatineedtoknow extra
capture "$TMP/go-au" "$TMP/go-au.err" "$TMP/go-au.rc" "$ROOT/go/channel-send" "$PLAN" auditor DEST VERB "$TMP/bodies/ping.md" --whatineedtoknow
same "what rejects extra send args" "$TMP/sh-au.err" "$TMP/go-au.err"
expect_text "what extra usage" "$TMP/sh-au.err" "usage: channel-send FILE NODE --whatineedtoknow"
expect_rc "what extra exit" 1 "$TMP/sh-au.rc"
if [ ! -d "$AIN" ]; then ok "rejected what did not set up"; else bad "rejected what did not set up"; fi

# plan errors, python is the third reader
err_setup() {
  name=$1
  file=$2
  node=$3
  capture "$TMP/e-sh" "$TMP/e-sh.err" "$TMP/e-sh.rc" "$ROOT/bin/channel-setup" "$file" "$node"
  capture "$TMP/e-go" "$TMP/e-go.err" "$TMP/e-go.rc" "$ROOT/go/channel-setup" "$file" "$node"
  capture "$TMP/e-py" "$TMP/e-py.err" "$TMP/e-py.rc" python3 "$PY" setup "$file" "$node"
  same "$name shell/go" "$TMP/e-sh.err" "$TMP/e-go.err"
  same "$name shell/py" "$TMP/e-sh.err" "$TMP/e-py.err"
  expect_rc "$name exit" 1 "$TMP/e-sh.rc"
  empty_file "$name stdout" "$TMP/e-sh"
}

: > "$TMP/empty.diag"
err_setup "empty plan" "$TMP/empty.diag" planner
err_setup "missing plan" "$TMP/no-such.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' 'node planner rel/inbox' 'node coder /tmp/c' 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/rel.diag"
err_setup "relative inbox" "$TMP/rel.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' "node planner $PIN" "node planner $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/dupnode.diag"
err_setup "duplicate node" "$TMP/dupnode.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; planner -> coder; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/dupedge.diag"
err_setup "duplicate edge" "$TMP/dupedge.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' "node planner $PIN" "node coder $CIN" 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/noverb.diag"
err_setup "edge without verb" "$TMP/noverb.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder GONE' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/noword.diag"
err_setup "verb without message" "$TMP/noword.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' "node planner $PIN" "node extra $AIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/extra.diag"
err_setup "node not in diagram" "$TMP/extra.diag" planner

# Arrow marks: at the right end > waits and < queues, at the left end < waits and > queues.
# Each form must mean the same channels as its expansion into one-direction arrows.
# verbs_for back|both: the verb lines for coder -> planner only, or both directions
verbs_for() { if [ "$1" = back ]; then echo 'verb coder planner TASK'; else echo 'verb planner coder TASK'; echo 'verb coder planner TASK'; fi; }
arrow_same() {
  name=$1
  vb=${4:-both}
  { printf '%s\n' "blockdiag { $2 }" '/*' "node planner $PIN" "node coder $CIN"; verbs_for "$vb"; printf '%s\n' 'message TASK { body: { ACTION: TASK } }' '*/'; } > "$TMP/ar-a.diag"
  { printf '%s\n' "blockdiag { $3 }" '/*' "node planner $PIN" "node coder $CIN"; verbs_for "$vb"; printf '%s\n' 'message TASK { body: { ACTION: TASK } }' '*/'; } > "$TMP/ar-b.diag"
  for nd in planner coder; do
    capture "$TMP/ar-sh" "$TMP/ar-sh.err" "$TMP/ar-sh.rc" "$ROOT/bin/channel-setup" "$TMP/ar-a.diag" $nd -n --whatineedtoknow
    capture "$TMP/ar-go" "$TMP/ar-go.err" "$TMP/ar-go.rc" "$ROOT/go/channel-setup" "$TMP/ar-a.diag" $nd -n --whatineedtoknow
    capture "$TMP/ar-py" "$TMP/ar-py.err" "$TMP/ar-py.rc" python3 "$PY" setup "$TMP/ar-a.diag" $nd -n --whatineedtoknow
    capture "$TMP/ar-x" "$TMP/ar-x.err" "$TMP/ar-x.rc" "$ROOT/bin/channel-setup" "$TMP/ar-b.diag" $nd -n --whatineedtoknow
    sed "s#$TMP/ar-b.diag#$TMP/ar-a.diag#g" "$TMP/ar-x" > "$TMP/ar-x2"
    expect_rc "arrow $name accepted ($nd)" 0 "$TMP/ar-sh.rc"
    same "arrow $name shell/go ($nd)" "$TMP/ar-sh" "$TMP/ar-go"
    same "arrow $name shell/py ($nd)" "$TMP/ar-sh" "$TMP/ar-py"
    same "arrow $name means $3 ($nd)" "$TMP/ar-sh" "$TMP/ar-x2"
  done
}
arrow_same '<-' 'planner <- coder;' 'coder -> planner;' back
arrow_same '>-' 'planner >- coder;' 'coder -< planner;' back
arrow_same '<->' 'planner <-> coder;' 'planner -> coder; coder -> planner;'
arrow_same '>-<' 'planner >-< coder;' 'planner -< coder; coder -< planner;'
arrow_same '>->' 'planner >-> coder;' 'planner -> coder; coder -< planner;'
arrow_same '<-<' 'planner <-< coder;' 'planner -< coder; coder -> planner;'

printf '%s\n' 'blockdiag { planner -- coder; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/nomark.diag"
err_setup "arrow with no mark" "$TMP/nomark.diag" planner
if grep -q 'has no mark at either end, so it is not a channel' "$TMP/e-sh.err"; then ok "arrow with no mark text"; else bad "arrow with no mark text: $(cat "$TMP/e-sh.err")"; fi
for bad_op in '<>-' '-<>' '<<-' '->>' '>>-' '-<<' '<--' '-->' '<>' '><'; do
  printf '%s\n' "blockdiag { planner $bad_op coder; }" '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/badop.diag"
  err_setup "invalid arrow $bad_op" "$TMP/badop.diag" planner
done
printf '%s\n' 'blockdiag { planner -> coder; planner -< coder; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/conflict.diag"
err_setup "conflicting duplicate rules" "$TMP/conflict.diag" planner
if grep -q 'conflicting rules for planner -> coder: wait and queue' "$TMP/e-sh.err"; then ok "conflicting duplicate rules text"; else bad "conflicting duplicate rules text: $(cat "$TMP/e-sh.err")"; fi
printf '%s\n' 'blockdiag { planner <-> coder; coder -< planner; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'verb coder planner TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/conflict2.diag"
err_setup "conflicting combined rules" "$TMP/conflict2.diag" planner
printf '%s\n' 'blockdiag { planner >-> coder; coder -> planner; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'verb coder planner TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/conflict3.diag"
err_setup "conflicting reverse rules" "$TMP/conflict3.diag" planner

printf '%s\n' 'blockdiag { planner ->> coder; }' '/*' "node planner $PIN" "node coder $CIN" '*/' > "$TMP/badarrow.diag"
err_setup "unrecognized arrow" "$TMP/badarrow.diag" planner

printf '%s\n' '/* unclosed' 'blockdiag { planner -> coder; }' > "$TMP/unclosed.diag"
err_setup "unclosed comment" "$TMP/unclosed.diag" planner

printf '%s\n' 'blockdiag { planner -> coder; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { note }' '*/' > "$TMP/nobody.diag"
err_setup "message without body" "$TMP/nobody.diag" planner

printf '%s\n' 'blockdiag { planner -> coder [label = "work"]; }' '/*' "node planner $PIN" "node coder $CIN" 'verb planner coder TASK' 'message TASK { body: { ACTION: TASK } }' '*/' > "$TMP/label.diag"
capture "$TMP/sh-lab" "$TMP/sh-lab.err" "$TMP/sh-lab.rc" "$SH" --setup -n "$TMP/label.diag" planner
capture "$TMP/go-lab" "$TMP/go-lab.err" "$TMP/go-lab.rc" "$GO" --setup -n "$TMP/label.diag" planner
capture "$TMP/py-lab" "$TMP/py-lab.err" "$TMP/py-lab.rc" python3 "$PY" setup -n "$TMP/label.diag" planner
same "label shell/go" "$TMP/sh-lab" "$TMP/go-lab"
same "label shell/py" "$TMP/sh-lab" "$TMP/py-lab"
if grep -F -q 'planner -> coder wait work' "$TMP/sh-lab"; then ok "label printed"; else bad "label printed"; fi

capture "$TMP/sh-bare" "$TMP/sh-bare.err" "$TMP/sh-bare.rc" "$ROOT/bin/channel-setup" "$PLAN" 'planner/x'
capture "$TMP/go-bare" "$TMP/go-bare.err" "$TMP/go-bare.rc" "$ROOT/go/channel-setup" "$PLAN" 'planner/x'
capture "$TMP/py-bare" "$TMP/py-bare.err" "$TMP/py-bare.rc" python3 "$PY" setup "$PLAN" 'planner/x'
same "path node shell/go" "$TMP/sh-bare.err" "$TMP/go-bare.err"
same "path node shell/py" "$TMP/sh-bare.err" "$TMP/py-bare.err"

capture "$TMP/sh-miss" "$TMP/sh-miss.err" "$TMP/sh-miss.rc" "$ROOT/bin/channel-arm" "$PLAN" ghost
capture "$TMP/go-miss" "$TMP/go-miss.err" "$TMP/go-miss.rc" "$ROOT/go/channel-arm" "$PLAN" ghost
same "unknown node" "$TMP/sh-miss.err" "$TMP/go-miss.err"
expect_text "unknown node text" "$TMP/sh-miss.err" "ghost is not a node in $PLAN"

